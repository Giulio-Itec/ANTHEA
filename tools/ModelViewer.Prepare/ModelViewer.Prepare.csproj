<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><GpcLibraries>none</GpcLibraries></PropertyGroup>
 <Target Name="RequireGpcCheckout" BeforeTargets="ResolveProjectReferences"><Error Condition="'$(GpcModelRoot)' == ''" Text="Pass -p:GpcModelRoot=path to a reviewed, isolated GPC Model checkout."/></Target>
 <ItemGroup>
  <ProjectReference Include="../../src/ANTHEA.ModelWorkspace/ANTHEA.ModelWorkspace.csproj"/>
  <ProjectReference Include="$(GpcModelRoot)/GPC Converter/GPC Converter.csproj"/>
  <Reference Include="GPCGeometry" HintPath="$(GpcModelRoot)/.dependencies/GPCGeometry.dll"/>
 </ItemGroup>
</Project>
