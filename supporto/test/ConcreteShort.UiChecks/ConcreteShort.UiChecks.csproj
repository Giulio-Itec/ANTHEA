<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <!--
    Program.cs calls MainWindow.FinishSmoke, defined only in the UiTests configuration of X.Desktop (refactoring F1.2).
    X.Desktop and its libraries all come from the UiTests build: the implicit transitive references would add them in Release.
  -->
  <PropertyGroup><DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../X.Desktop/X.Desktop.csproj" SetConfiguration="Configuration=UiTests" />
    <ProjectReference Include="../../../X.Core/X.Core.csproj" SetConfiguration="Configuration=UiTests" />
    <ProjectReference Include="../../../X.Calculations/X.Calculations.csproj" SetConfiguration="Configuration=UiTests" />
    <ProjectReference Include="../../../X.Materiali/X.Materiali.csproj" SetConfiguration="Configuration=UiTests" />
  </ItemGroup>
</Project>
