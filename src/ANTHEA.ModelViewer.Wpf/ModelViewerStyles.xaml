<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:ANTHEA.ModelViewer.Presentation;assembly=ANTHEA.ModelViewer.Presentation">
  <BooleanToVisibilityConverter x:Key="Visible" />
  <LinearGradientBrush x:Key="ModelContourPalette" StartPoint="0,1" EndPoint="0,0">
    <GradientStop Offset="0" Color="#1F3B9E" />
    <GradientStop Offset="0.25" Color="#14A3D9" />
    <GradientStop Offset="0.5" Color="#40C7A6" />
    <GradientStop Offset="0.75" Color="#F7E65C" />
    <GradientStop Offset="1" Color="#E84029" />
  </LinearGradientBrush>
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AppearanceInk}" />
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.65" />
    <Setter Property="Margin" Value="0,16,0,7" />
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Margin" Value="0,12,0,5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="Background" Value="{DynamicResource AppearancePaper}" />
    <Setter Property="Foreground" Value="{DynamicResource AppearanceInk}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppearanceBorder}" />
    <Setter Property="MaxDropDownHeight" Value="320" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="4">
                    <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource AppearanceInk}" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" />
                  </Border>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,4,29,4" VerticalAlignment="Center" IsHitTestVisible="False" />
            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
              <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{DynamicResource AppearancePaper}" BorderBrush="{DynamicResource AppearanceBorder}" BorderThickness="1" Padding="3" CornerRadius="4">
                <ScrollViewer CanContentScroll="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter Property="BorderBrush" Value="#438ED8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="Foreground" Value="{DynamicResource AppearanceInk}" />
    <Style.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter Property="Background" Value="#2265B5" />
        <Setter Property="Foreground" Value="White" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Margin" Value="0,8,0,2" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style x:Key="Action" TargetType="Button">
    <Setter Property="Padding" Value="11,7" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppearanceInk}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppearanceBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="BorderBrush" Value="#438ED8" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Face" Property="Opacity" Value="0.4" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Face" Property="BorderBrush" Value="#438ED8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource Action}" />
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
    <Setter Property="Background" Value="#2265B5" />
    <Setter Property="BorderBrush" Value="#2265B5" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style x:Key="ModeGeometry" TargetType="Button" BasedOn="{StaticResource Action}">
    <Setter Property="BorderThickness" Value="0" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding SelectedMode}" Value="0">
        <Setter Property="Background" Value="#2265B5" />
        <Setter Property="Foreground" Value="White" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ModeSolid" TargetType="Button" BasedOn="{StaticResource Action}">
    <Setter Property="BorderThickness" Value="0" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding SelectedMode}" Value="1">
        <Setter Property="Background" Value="#2265B5" />
        <Setter Property="Foreground" Value="White" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ModeResults" TargetType="Button" BasedOn="{StaticResource Action}">
    <Setter Property="BorderThickness" Value="0" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding SelectedMode}" Value="2">
        <Setter Property="Background" Value="#2265B5" />
        <Setter Property="Foreground" Value="White" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource AppearanceInk}" />
    <Setter Property="Padding" Value="14,13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Tab" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent">
            <ContentPresenter ContentSource="Header" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Tab" Property="BorderBrush" Value="#438ED8" />
              <Setter TargetName="Tab" Property="Background" Value="{DynamicResource AppearanceSurface}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Tab" Property="BorderBrush" Value="#438ED8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TreeViewItem">
    <Setter Property="Foreground" Value="{DynamicResource AppearanceInk}" />
    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
    <Setter Property="Padding" Value="2,4" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <HierarchicalDataTemplate DataType="{x:Type p:ModelTreeItem}" ItemsSource="{Binding Children}">
    <Grid ToolTip="{Binding Label}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="22" />
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Icon}" Foreground="#438ED8" FontSize="14" />
      <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="{Binding Badge}" FontSize="10" Opacity="0.55" Margin="10,0,6,0" VerticalAlignment="Center" />
    </Grid>
  </HierarchicalDataTemplate>
</ResourceDictionary>