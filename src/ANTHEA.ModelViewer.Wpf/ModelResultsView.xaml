<UserControl x:Class="ANTHEA.ModelViewer.Wpf.ModelResultsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ModelViewerStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="14,0,14,16">
      <TextBlock Text="CAMPO DI RISULTATO" Style="{StaticResource Caption}" />
      <CheckBox Content="Mostra risultati sul modello" IsChecked="{Binding ShowResults}" AutomationProperties.Name="Mostra risultati sul modello" />
      <TextBlock Text="{Binding RepresentationLabel, StringFormat=Rappresentazione: {0}}" FontSize="10" Opacity=".65" Margin="0,0,0,6"/>
      <TextBlock Text="Caso / combinazione" Style="{StaticResource FieldLabel}"/>
      <ComboBox ItemsSource="{Binding Cases}" SelectedItem="{Binding SelectedCase}" AutomationProperties.Name="Caso o combinazione" />
      <Button Content="Gestisci combinazioni…" Command="{Binding OpenCombinationManagerCommand}" Margin="0,6,0,0"/>
      <TextBlock Text="{Binding ResultKind}" Foreground="#438ED8" FontSize="10" Margin="0,5,0,7" />
      <TextBlock Text="Tipo di risultato" Style="{StaticResource FieldLabel}" Margin="0,3,0,5"/>
      <ComboBox ItemsSource="{Binding ResultTypes}" SelectedIndex="{Binding SelectedResultType}" AutomationProperties.Name="Tipo di risultato" Margin="0,0,0,7"/>
      <ComboBox ItemsSource="{Binding FamilyLabels}" SelectedIndex="{Binding SelectedFamily}" Visibility="{Binding IsForceResult, Converter={StaticResource Visible}}" AutomationProperties.Name="Famiglia degli elementi" />
      <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <ComboBox ItemsSource="{Binding AxesLabels}" SelectedIndex="{Binding SelectedAxes}" Visibility="{Binding IsForceResult, Converter={StaticResource Visible}}" AutomationProperties.Name="Assi dei risultati" />
        <TextBlock Text="Assi globali" Visibility="{Binding IsDisplacementResult, Converter={StaticResource Visible}}" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="2" ItemsSource="{Binding Components}" SelectedItem="{Binding SelectedComponent}" AutomationProperties.Name="Componente del risultato" />
      </Grid>
      <ComboBox ItemsSource="{Binding BeamLocations}" SelectedIndex="{Binding SelectedBeamLocation}" Margin="0,7,0,0" Visibility="{Binding IsBeamFamily, Converter={StaticResource Visible}}" />
      <Expander Header="Contouring e diagrammi delle aste" IsExpanded="True" Visibility="{Binding IsBeamFamily, Converter={StaticResource Visible}}" Margin="0,8"><StackPanel>
        <CheckBox Content="Contouring sull’elemento" IsChecked="{Binding ShowLineContour}"/>
        <CheckBox Content="Diagramma delle sollecitazioni" IsChecked="{Binding ShowBeamDiagram}"/>
        <StackPanel IsEnabled="{Binding ShowBeamDiagram}">
          <TextBlock Text="Piano del diagramma" Style="{StaticResource FieldLabel}"/>
          <ComboBox ItemsSource="{Binding BeamDiagramAxes}" SelectedIndex="{Binding SelectedBeamDiagramAxis}"/>
          <TextBlock Text="Ampiezza grafica" Style="{StaticResource FieldLabel}"/>
          <Slider Value="{Binding BeamDiagramScale}" Minimum=".1" Maximum="5" ToolTip="Scala del diagramma"/>
          <CheckBox Content="Valori alle stazioni" IsChecked="{Binding ShowBeamDiagramValues}"/>
        </StackPanel>
        <TextBlock Text="{Binding LineRepresentationMessage}" TextWrapping="Wrap" FontSize="10" Opacity=".7"/>
        <Button Content="Diagramma 2D dell’asta…" Command="{Binding OpenMemberDiagramCommand}" Margin="0,8,0,0"/>
      </StackPanel></Expander>
      <TextBlock Text="{Binding ResultUnit}" FontWeight="SemiBold" Margin="0,7,0,3" />
      <Expander Header="Unità" Margin="0,4"><StackPanel Margin="0,7">
        <UniformGrid Columns="2" Visibility="{Binding IsForceResult, Converter={StaticResource Visible}}"><ComboBox ItemsSource="{Binding ForceUnits}" SelectedItem="{Binding ForceUnit}" Margin="0,0,4,0"/><ComboBox ItemsSource="{Binding LengthUnits}" SelectedItem="{Binding LengthUnit}" Margin="4,0,0,0"/></UniformGrid>
        <ComboBox ItemsSource="{Binding DisplacementUnits}" SelectedItem="{Binding DisplacementUnit}" Visibility="{Binding IsDisplacementResult, Converter={StaticResource Visible}}" AutomationProperties.Name="Unità degli spostamenti"/>
      </StackPanel></Expander>
      <Expander Header="Forma deformata" Margin="0,8" IsExpanded="{Binding ShowDeformationSettings}"><StackPanel Margin="0,6">
        <CheckBox Content="Mostra modello deformato" IsChecked="{Binding ShowDeformation}" IsEnabled="{Binding CanDeform}" AutomationProperties.Name="Mostra modello deformato"/>
        <StackPanel IsEnabled="{Binding CanDeform}">
          <ComboBox ItemsSource="{Binding DeformationScaleModes}" SelectedIndex="{Binding SelectedDeformationScale}" AutomationProperties.Name="Scala della deformata"/>
          <TextBox Text="{Binding DeformationScale, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Visibility="{Binding IsManualDeformationScale, Converter={StaticResource Visible}}" Margin="0,6,0,0" ToolTip="Fattore da 0,001 a 1.000.000"/>
          <TextBlock Text="{Binding DeformationScaleLabel}" FontSize="10" Margin="0,5"/>
          <CheckBox Content="Sagoma indeformata" IsChecked="{Binding ShowUndeformed}"/>
          <CheckBox Content="Anche mesh indeformata" IsChecked="{Binding ShowUndeformedMesh}" IsEnabled="{Binding ShowUndeformed}"/>
          <Slider Value="{Binding UndeformedOpacity}" Minimum=".05" Maximum="1" IsEnabled="{Binding ShowUndeformed}" ToolTip="Opacità della sagoma indeformata"/>
          <Expander Header="Animazione" Margin="0,6"><StackPanel Margin="0,6">
            <UniformGrid Columns="2"><Button Content="{Binding AnimationLabel}" Command="{Binding ToggleAnimationCommand}" Margin="0,0,4,0"/><Button Content="Fase 100%" Command="{Binding ResetDeformationFrameCommand}"/></UniformGrid>
            <Slider Value="{Binding DeformationPhase}" Minimum="0" Maximum="1" Margin="0,6" ToolTip="Fase della deformazione grafica"/>
            <TextBlock Text="{Binding DeformationPhaseLabel}" FontSize="10"/>
            <TextBlock Text="Durata del ciclo [s]" Style="{StaticResource FieldLabel}"/>
            <Slider Value="{Binding AnimationDuration}" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>
            <TextBlock Text="{Binding AnimationHelp}" FontSize="10" Opacity=".7" TextWrapping="Wrap" Margin="0,6"/>
          </StackPanel></Expander>
        </StackPanel>
        <TextBlock Text="{Binding DeformationMessage}" FontSize="10" TextWrapping="Wrap" Opacity=".7" Margin="0,5"/>
      </StackPanel></Expander>
      <TextBlock Text="CONTOURING" Style="{StaticResource Caption}" />
      <ComboBox ItemsSource="{Binding ContourValueModes}" SelectedIndex="{Binding SelectedContourValues}" IsEnabled="{Binding CanAverageContours}" Visibility="{Binding IsForceResult, Converter={StaticResource Visible}}" ToolTip="{Binding ContourAveragingHelp}" AutomationProperties.Name="Valori del contouring" />
      <Expander Header="Palette e dettagli" Margin="0,10,0,0"><StackPanel Margin="0,7">
        <ComboBox ItemsSource="{Binding ContourPalettes}" SelectedIndex="{Binding SelectedContourPalette}" />
        <ComboBox ItemsSource="{Binding BandModes}" SelectedIndex="{Binding ContourBands}" Margin="0,6,0,0" />
        <CheckBox Content="Inverti palette" IsChecked="{Binding ReversePalette}" />
        <ComboBox ItemsSource="{Binding QualityLabels}" SelectedIndex="{Binding SelectedQuality}" AutomationProperties.Name="Qualità del contouring" />
        <CheckBox Content="Isolinee" IsChecked="{Binding ShowIsolines}"/><Slider Value="{Binding IsolineCount}" Minimum="4" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" ToolTip="Intervalli delle isolinee"/>
        <TextBlock Text="Spessore isolinee"/><Slider Value="{Binding IsolineWidth}" Minimum=".25" Maximum="1.5"/><CheckBox Content="Altri elementi in contesto" IsChecked="{Binding ShowContext}"/>
      </StackPanel></Expander>
      <Expander Header="Scala e legenda" IsExpanded="{Binding ShowLegendSettings}" Margin="0,10,0,0"><StackPanel Margin="0,7">
        <ComboBox ItemsSource="{Binding ColorScaleModes}" SelectedIndex="{Binding SelectedColorScale}" AutomationProperties.Name="Scala dei colori"/>
        <StackPanel Visibility="{Binding IsManualColorScale, Converter={StaticResource Visible}}" Margin="0,7">
          <UniformGrid Columns="2"><TextBox Text="{Binding ColorScaleLower, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" ToolTip="Minimo"/><TextBox Text="{Binding ColorScaleUpper, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,0,0" ToolTip="Massimo"/></UniformGrid>
          <Button Content="Applica limiti" Command="{Binding ApplyColorScaleCommand}" Margin="0,6,0,0"/>
        </StackPanel>
        <TextBlock Text="Decimali"/><Slider Value="{Binding LegendPrecision}" Minimum="0" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>
        <TextBlock Text="{Binding VisibleResultRange}" TextWrapping="Wrap" FontSize="10" Margin="0,6"/>
        <TextBlock Text="{Binding ColorScaleMessage}" TextWrapping="Wrap" FontSize="10"/>
      </StackPanel></Expander>
      <TextBlock Text="LETTURE SUL MODELLO" Style="{StaticResource Caption}"/>
      <Expander Header="Selezione per intervallo" Margin="0,4,0,8"><StackPanel>
        <UniformGrid Columns="2"><TextBox Text="{Binding ResultSelectionMinimum, UpdateSourceTrigger=PropertyChanged}" ToolTip="Valore minimo incluso" Margin="0,0,4,0"/><TextBox Text="{Binding ResultSelectionMaximum, UpdateSourceTrigger=PropertyChanged}" ToolTip="Valore massimo incluso"/></UniformGrid>
        <Button Content="Seleziona per valore" Command="{Binding SelectByResultRangeCommand}" Margin="0,6,0,0"/>
        <TextBlock Text="Almeno un campione del campo visualizzato, nelle unità correnti; poi Isola o Nascondi." FontSize="10" TextWrapping="Wrap" Margin="0,6"/>
        <TextBlock Text="{Binding ExplorationMessage}" FontSize="10" TextWrapping="Wrap"/>
      </StackPanel></Expander>
      <CheckBox Content="Mostra minimo e massimo" IsChecked="{Binding ShowExtrema}"/>
      <UniformGrid Columns="2"><Button Content="Vai al minimo" Command="{Binding GoToExtremeCommand}" CommandParameter="min" Margin="0,0,3,0"/><Button Content="Vai al massimo" Command="{Binding GoToExtremeCommand}" CommandParameter="max" Margin="3,0,0,0"/></UniformGrid>
      <Button Content="Rimuovi letture fissate" Command="{Binding ClearProbesCommand}" Margin="0,6,0,0"/>
      <TextBlock Text="Passa su un elemento; premi P per fissare il campione vicino. Le letture indicano sempre il caso di origine." FontSize="10" TextWrapping="Wrap" Opacity=".65" Margin="0,7"/>
      <Expander Header="Confronto affiancato" Margin="0,10"><StackPanel Margin="0,6">
        <CheckBox Content="Apri seconda vista" IsChecked="{Binding CompareEnabled}"/>
        <TextBlock Text="Caso / combinazione" Style="{StaticResource FieldLabel}"/>
      <ComboBox ItemsSource="{Binding Cases}" SelectedItem="{Binding CompareCase}"/>
        <ComboBox ItemsSource="{Binding Components}" SelectedItem="{Binding CompareComponent}" Margin="0,6,0,0"/>
        <ComboBox ItemsSource="{Binding ContourValueModes}" SelectedIndex="{Binding CompareAveraging}" IsEnabled="{Binding CanAverageContours}" Margin="0,6,0,0"/>
        <CheckBox Content="Scala comune" IsChecked="{Binding CompareCommonScale}" IsEnabled="{Binding CanShareComparisonScale}"/>
        <TextBlock Text="Camera sincronizzata dalla vista principale. Le scale restano separate per unità incompatibili." FontSize="10" TextWrapping="Wrap" Opacity=".65"/>
      </StackPanel></Expander>
      <Expander Header="Dati e rappresentazione" Margin="0,10"><StackPanel>
        <TextBlock Text="{Binding ResultAvailability}" TextWrapping="Wrap" FontSize="11"/>
        <TextBlock Text="{Binding Information}" TextWrapping="Wrap" FontSize="11" Margin="0,6"/>
      </StackPanel></Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
