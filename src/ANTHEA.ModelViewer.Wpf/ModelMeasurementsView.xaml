<UserControl x:Class="ANTHEA.ModelViewer.Wpf.ModelMeasurementsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <CheckBox Content="Mostra misure sul modello" IsChecked="{Binding ShowMeasurements}"/>
    <ComboBox ItemsSource="{Binding MeasurementKinds}" SelectedIndex="{Binding SelectedMeasurementKind}" Margin="0,6" ToolTip="Tipo di misura"/>
    <UniformGrid Columns="2"><Button Content="Scegli nodi" Command="{Binding StartMeasurementCommand}"/><Button Content="Termina · Esc" Command="{Binding CancelMeasurementCommand}"/></UniformGrid>
    <TextBlock Text="{Binding MeasurementPrompt}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0"/>
    <TextBlock Text="{Binding MeasurementNodesLabel}" TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,5"/>
    <DockPanel><Button DockPanel.Dock="Right" Content="Aggiungi" Command="{Binding AddMeasurementIdsCommand}" Margin="5,0,0,0"/><TextBox Text="{Binding MeasurementNodeIds,UpdateSourceTrigger=PropertyChanged}" ToolTip="ID dei nodi, per esempio 1 2 oppure 1 2 3"/></DockPanel>
    <TextBlock Text="Coordinate della misura" FontSize="10" Margin="0,12,0,4"/>
    <ComboBox ItemsSource="{Binding MeasurementBases}" SelectedIndex="{Binding MeasurementBasis}"/>
    <DockPanel Margin="0,6,0,0"><TextBlock Text="Unità delle distanze" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding MeasurementUnits}" SelectedItem="{Binding MeasurementUnit}" Margin="8,0,0,0"/></DockPanel>
    <TextBlock Text="Le linee seguono la forma a video. Le misure usano la geometria originale o la deformata reale del caso scelto nei Risultati, mai il fattore di amplificazione." TextWrapping="Wrap" FontSize="10" Opacity=".7" Margin="0,8"/>
    <TextBlock Text="{Binding MeasurementMessage}" TextWrapping="Wrap" FontSize="11"/>
    <ItemsControl ItemsSource="{Binding MeasurementReadings}" Margin="0,5">
      <ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="{DynamicResource AppearanceBorder}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,4">
          <StackPanel>
            <DockPanel><Button DockPanel.Dock="Right" Content="×" MinWidth="22" Padding="3,0" Command="{Binding DataContext.RemoveMeasurementCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Definition}" ToolTip="Rimuovi questa misura"/><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="10" VerticalAlignment="Center"/></DockPanel>
            <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="SemiBold" Margin="0,4"/>
            <TextBlock Text="{Binding Details}" FontSize="10" Opacity=".75" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Content="Rimuovi tutte le misure" Command="{Binding ClearMeasurementsCommand}" Margin="0,5"/>
  </StackPanel>
</UserControl>
