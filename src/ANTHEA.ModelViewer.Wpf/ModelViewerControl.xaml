<UserControl x:Class="ANTHEA.ModelViewer.Wpf.ModelViewerControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:h="http://helix-toolkit.org/wpf/SharpDX"
 MinHeight="360" UseLayoutRounding="True"
 Background="{DynamicResource AppearancePaper}" Foreground="{DynamicResource AppearanceInk}">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
  <Style x:Key="Label" TargetType="TextBlock">
   <Setter Property="Margin" Value="0,8,0,5"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="ToolbarChoice" TargetType="ComboBox">
   <Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="30"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Padding="8" BorderBrush="{DynamicResource AppearanceBorder}" BorderThickness="0,0,0,1">
   <WrapPanel VerticalAlignment="Center">
    <Button Content="{Binding ImportLabel}" Command="{Binding ImportCommand}" Margin="4" Padding="12,5"/>
    <ComboBox ItemsSource="{Binding ModeLabels}" SelectedIndex="{Binding SelectedMode}" Style="{StaticResource ToolbarChoice}" Width="150" AutomationProperties.Name="Vista del modello"/>
    <ComboBox ItemsSource="{Binding Cases}" SelectedItem="{Binding SelectedCase}" IsEnabled="{Binding IsResultsView}" Style="{StaticResource ToolbarChoice}" Width="205" AutomationProperties.Name="Caso o combinazione"/>
    <ComboBox ItemsSource="{Binding Components}" SelectedItem="{Binding SelectedComponent}" IsEnabled="{Binding IsResultsView}" Style="{StaticResource ToolbarChoice}" Width="75" AutomationProperties.Name="Componente del risultato"/>
    <ComboBox ItemsSource="{Binding QualityLabels}" SelectedIndex="{Binding SelectedQuality}" IsEnabled="{Binding IsResultsView}" Style="{StaticResource ToolbarChoice}" Width="95" ToolTip="Qualità del contouring" AutomationProperties.Name="Qualità del contouring"/>
    <CheckBox Content="Mesh" IsChecked="{Binding ShowMesh}" IsEnabled="{Binding CanShowMesh}" Margin="10,5" VerticalAlignment="Center"/>
    <CheckBox Content="Isolinee" IsChecked="{Binding ShowIsolines}" IsEnabled="{Binding IsResultsView}" Margin="10,5" VerticalAlignment="Center"/>
    <Button Content="Inquadra" Command="{Binding FitCommand}" Margin="4" Padding="12,5"/>
    <Button Content="Salva immagine…" Command="{Binding SaveImageCommand}" Margin="4" Padding="12,5"/>
   </WrapPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
   <Grid Background="#131D2B">
    <h:Viewport3DX x:Name="Viewport" BackgroundColor="#131D2B" ShowCoordinateSystem="True" ShowViewCube="True"/>
    <Border Background="#AA131D2B" VerticalAlignment="Top" HorizontalAlignment="Left" Padding="12,8" IsHitTestVisible="False">
     <StackPanel><TextBlock Text="ANTHEA / MODELLI" Foreground="#C6D5E8" FontSize="11" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Summary}" Foreground="White" FontSize="13" Margin="0,5,0,0"/></StackPanel>
    </Border>
    <TextBlock Text="Importa un modello per iniziare" Foreground="#C6D5E8" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,14">
     <TextBlock Text="BOZZA DEL VISUALIZZATORE" FontSize="10" FontWeight="SemiBold" Opacity="0.65"/>
     <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,14"/>
     <StackPanel Visibility="{Binding IsResultsView, Converter={StaticResource BooleanVisibility}}">
      <TextBlock Text="{Binding ResultUnit}" FontWeight="SemiBold"/>
      <Grid Margin="0,10,0,14" Height="112">
       <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border CornerRadius="3"><Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="0,0"><GradientStop Offset="0" Color="#1F3B9E"/><GradientStop Offset="0.25" Color="#14A3D9"/><GradientStop Offset="0.5" Color="#40C7A6"/><GradientStop Offset="0.75" Color="#F7E65C"/><GradientStop Offset="1" Color="#E84029"/></LinearGradientBrush></Border.Background></Border>
       <TextBlock Grid.Column="1" Text="{Binding Maximum, StringFormat=Max {0}}" Margin="10,0,0,0" VerticalAlignment="Top"/>
       <TextBlock Grid.Column="1" Text="{Binding Minimum, StringFormat=Min {0}}" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
      </Grid>
     </StackPanel>
     <TextBlock Text="{Binding Information}" TextWrapping="Wrap" FontSize="12" Opacity="0.8"/>
     <Separator Margin="0,16,0,4"/>
     <TextBlock Text="Interroga un elemento" Style="{StaticResource Label}"/>
     <DockPanel>
      <Button Content="Leggi" Command="{Binding QueryCommand}" DockPanel.Dock="Right" Margin="5,0,0,0" Padding="14,4"/>
      <TextBox Text="{Binding ElementNumber, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" AutomationProperties.Name="Numero dell'elemento"/>
     </DockPanel>
     <TextBlock Text="{Binding SelectionInformation}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,6"/>
     <TextBlock Text="Foglio di verifica" Style="{StaticResource Label}"/>
     <ComboBox ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet}" MinHeight="32" AutomationProperties.Name="Foglio da collegare"/>
     <Button Content="Collega riferimento" Command="{Binding LinkCommand}" Margin="0,8,0,0" Padding="10,6"/>
     <TextBlock Text="Conserva il riferimento a elemento, risultato e revisione del modello. Le sollecitazioni del foglio restano invariate." TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,8,0,0"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="2" Padding="12,7" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppearanceBorder}">
   <DockPanel><ProgressBar Width="85" Height="4" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"/></DockPanel>
  </Border>
 </Grid>
</UserControl>
