<UserControl x:Class="ANTHEA.ModelViewer.Wpf.ModelTableView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource AppearancePaper}" Foreground="{DynamicResource AppearanceInk}" MinHeight="150">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Padding="10,8" Background="{DynamicResource AppearanceSurface}">
      <WrapPanel VerticalAlignment="Center">
        <ComboBox ItemsSource="{Binding TableKinds}" SelectedIndex="{Binding SelectedTableKind}" Width="185" Margin="0,0,10,5" AutomationProperties.Name="Tipo di tabella" />
        <TextBox Text="{Binding TableSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}" Width="110" MinHeight="31" Padding="7,5" Margin="0,0,10,5" ToolTip="Cerca nella tabella" AutomationProperties.Name="Cerca nella tabella" />
        <CheckBox Content="Visibili" IsChecked="{Binding TableOnlyVisible}" IsEnabled="{Binding CanFilterTableVisibility}" VerticalAlignment="Center" Margin="0,0,10,5" />
        <CheckBox Content="Selezionati" IsChecked="{Binding TableOnlySelected}" VerticalAlignment="Center" Margin="0,0,10,5" />
        <Button Content="Esporta CSV…" Command="{Binding ExportTableCommand}" Margin="0,0,0,5" />
      </WrapPanel>
    </Border>
    <DataGrid Grid.Row="1" ItemsSource="{Binding TableRows}" SelectedItem="{Binding SelectedTableRow}" AutoGenerateColumns="True" AutoGeneratingColumn="GenerateColumn" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True" CanUserReorderColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionMode="Extended" SelectionUnit="FullRow" ClipboardCopyMode="IncludeHeader" HeadersVisibility="Column" RowHeight="30" FontSize="11" BorderThickness="0" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource AppearanceBorder}" Background="Transparent" AutomationProperties.Name="Tabella del modello" />
    <TextBlock Grid.Row="2" Text="{Binding TableSummary}" FontSize="10" Margin="10,6" Opacity="0.65" TextTrimming="CharacterEllipsis" />
  </Grid>
</UserControl>