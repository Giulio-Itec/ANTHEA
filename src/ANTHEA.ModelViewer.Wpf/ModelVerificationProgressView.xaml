<UserControl x:Class="ANTHEA.ModelViewer.Wpf.ModelVerificationProgressView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ModelViewerStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </UserControl.Resources>
  <Border Padding="0,5,0,12" Visibility="{Binding HasVerificationProgress, Converter={StaticResource Visible}}">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="24" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <DockPanel>
        <TextBlock Text="{Binding VerificationCount}" DockPanel.Dock="Right" FontSize="11" Opacity="0.7" Margin="16,0,0,0" />
        <TextBlock Text="{Binding VerificationStatus}" FontWeight="SemiBold" />
      </DockPanel>
      <ProgressBar Grid.Row="1" Value="{Binding VerificationPercentage}" Minimum="0" Maximum="100" IsIndeterminate="{Binding IsVerificationIndeterminate}" Height="6" Margin="0,8,0,6" Foreground="#438ED8" AutomationProperties.Name="Avanzamento delle verifiche" />
      <TextBlock Grid.Row="2" Text="{Binding VerificationActivity}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" ToolTip="{Binding VerificationActivity}" />
      <StackPanel Grid.Column="2" Grid.RowSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Annulla" Command="{Binding CancelVerificationCommand}" Visibility="{Binding IsVerificationRunning, Converter={StaticResource Visible}}" MinWidth="85" />
        <Button Content="Chiudi" Command="{Binding DismissVerificationProgressCommand}" MinWidth="85">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsVerificationRunning}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
