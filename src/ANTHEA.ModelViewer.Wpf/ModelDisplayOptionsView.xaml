<UserControl x:Class="ANTHEA.ModelViewer.Wpf.ModelDisplayOptionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
      <StackPanel>
        <TextBlock Text="COLORE DEGLI OGGETTI" FontSize="10" FontWeight="SemiBold" Opacity="0.65" />
        <ComboBox ItemsSource="{Binding ColorModes}" SelectedIndex="{Binding SelectedColorMode}" AutomationProperties.Name="Colore per attributo" />
        <TextBlock Text="{Binding ColorExplanation}" TextWrapping="Wrap" FontSize="10" Opacity="0.65" Margin="0,7,0,0" />
        <ComboBox Margin="0,10,0,5" ItemsSource="{Binding ColorCategories}" SelectedValuePath="Key" SelectedValue="{Binding SelectedColorCategoryKey}" AutomationProperties.Name="Categoria da personalizzare">
          <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Rectangle Fill="{Binding Color}" Width="12" Height="12" Margin="0,0,7,0"/><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" MaxWidth="220"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <WrapPanel>
          <Button Content="Seleziona" Command="{Binding SelectColorCategoryCommand}" CommandParameter="{Binding SelectedColorCategoryKey}" Margin="0,0,4,4" Padding="7,5"/>
          <Button Content="Isola" Command="{Binding IsolateColorCategoryCommand}" CommandParameter="{Binding SelectedColorCategoryKey}" Margin="0,0,4,4" Padding="7,5"/>
          <Button Content="Nascondi" Command="{Binding HideColorCategoryCommand}" CommandParameter="{Binding SelectedColorCategoryKey}" Margin="0,0,4,4" Padding="7,5"/>
          <Button Content="Mostra" Command="{Binding ShowColorCategoryCommand}" CommandParameter="{Binding SelectedColorCategoryKey}" Margin="0,0,0,4" Padding="7,5"/>
        </WrapPanel>
        <TextBlock Text="{Binding CategorySelectionSummary}" FontSize="10" TextWrapping="Wrap" Opacity=".65" Margin="0,2,0,8"/>
        <ItemsControl ItemsSource="{Binding CategoryPalette}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate><Button Width="28" Height="28" MinHeight="0" Padding="3" Margin="0,0,4,4" ToolTip="{Binding}" AutomationProperties.Name="{Binding}" Command="{Binding DataContext.ChooseCategoryColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Rectangle Fill="{Binding}" Width="18" Height="18"/></Button></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel Margin="0,4,0,0">
          <Rectangle Fill="{Binding CategoryColorPreview}" Width="22" Height="22" Margin="0,0,7,0"/>
          <Button DockPanel.Dock="Right" Content="Applica" Command="{Binding ApplyCategoryColorCommand}" Padding="7,4" Margin="6,0,0,0"/>
          <TextBox Text="{Binding CategoryColorText, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" AutomationProperties.Name="Colore esadecimale della categoria"/>
        </DockPanel>
        <TextBlock Text="{Binding CategoryColorMessage}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
        <WrapPanel><Button Content="Ripristina colore" Command="{Binding ResetCategoryColorCommand}" Padding="6,4" Margin="0,4,5,0"/><Button Content="Ripristina tutti" Command="{Binding ResetCategoryColorsCommand}" Padding="6,4" Margin="0,4,0,0"/></WrapPanel>
      </StackPanel>
      <StackPanel>
        <TextBlock Margin="0,14,0,7" Text="RAPPRESENTAZIONE" FontSize="10" FontWeight="SemiBold" Opacity="0.65" />
        <ComboBox ItemsSource="{Binding SurfaceModes}" SelectedIndex="{Binding SelectedSurfaceMode}" AutomationProperties.Name="Rappresentazione delle superfici" />
        <CheckBox Content="Bordi della mesh" IsChecked="{Binding ShowMesh}" />
        <CheckBox Content="Bordi esterni e spigoli" IsChecked="{Binding ShowOutlines}"/>
        <TextBlock Text="Opacità delle superfici" Margin="0,8,0,3"/><Slider Value="{Binding SurfaceOpacity}" Minimum=".1" Maximum="1"/>
        <CheckBox Content="Mostra nodi" IsChecked="{Binding ShowNodes}" />
        <WrapPanel>
          <CheckBox Content="Assi globali" IsChecked="{Binding ShowGlobalAxes}" Margin="0,0,12,4" />
          <CheckBox Content="Cubo vista" IsChecked="{Binding ShowViewCube}" Margin="0,0,0,4" />
        </WrapPanel>
        <DockPanel Margin="0,4,0,0">
          <TextBlock Text="Spessore linee" FontSize="11" Width="100" VerticalAlignment="Center" />
          <Slider Value="{Binding LineWidth}" Minimum="0.5" Maximum="2.5" SmallChange="0.25" ToolTip="Spessore grafico delle linee" />
        </DockPanel>
      </StackPanel>
      <StackPanel>
        <TextBlock Margin="0,14,0,7" Text="ETICHETTE" FontSize="10" FontWeight="SemiBold" Opacity="0.65" />
        <WrapPanel>
          <CheckBox Content="ID nodi" IsChecked="{Binding ShowNodeIds}" Margin="0,0,12,6" />
          <CheckBox Content="ID elementi" IsChecked="{Binding ShowElementIds}" Margin="0,0,0,6" />
        </WrapPanel>
        <CheckBox Content="Evita sovrapposizioni delle etichette" IsChecked="{Binding AvoidLabelOverlap}"/>
        <CheckBox Content="ID sezioni / spessori" IsChecked="{Binding ShowPropertyIds}" Margin="0,0,0,6" />
        <ComboBox ItemsSource="{Binding LabelScopes}" SelectedIndex="{Binding SelectedLabelScope}" AutomationProperties.Name="Ambito delle etichette" />
        <DockPanel Margin="0,6,0,0">
          <TextBlock Text="Dimensione testo" FontSize="11" Width="100" />
          <Slider Value="{Binding LabelScale}" Minimum="0.6" Maximum="1.6" SmallChange="0.1" />
        </DockPanel>
      </StackPanel>
      <StackPanel>
        <TextBlock Margin="0,14,0,7" Text="OGGETTI NASCOSTI" FontSize="10" FontWeight="SemiBold" Opacity="0.65" />
        <CheckBox Content="Mostra wireframe di contesto" IsChecked="{Binding ShowHiddenWireframe}" />
        <CheckBox Content="Includi nell’inquadratura" IsChecked="{Binding IncludeHiddenInFit}" Margin="0,0,0,9" />
        <WrapPanel>
          <Button Content="Mostra selezione" Command="{Binding ShowSelectedCommand}" Margin="0,0,5,5" />
          <Button Content="Inverti visibilità" Command="{Binding InvertVisibilityCommand}" Margin="0,0,0,5" />
        </WrapPanel>
      </StackPanel>
  </StackPanel>
</UserControl>
