<UserControl x:Class="ANTHEA.ModelViewer.Wpf.ModelReportView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ModelViewerStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="14,0,14,16">
    <TextBlock Text="REPORT DINAMICO" Style="{StaticResource Caption}"/>
    <TextBlock Text="Viste, testi e sezioni" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <TextBlock Text="{Binding ReportRevisionStatus}" TextWrapping="Wrap" FontSize="11" Foreground="#438ED8" Margin="0,0,0,12"/>
    <StackPanel IsEnabled="{Binding CanEditReport}">
      <Expander Header="Documento e qualità"><StackPanel Margin="0,8">
        <TextBlock Text="Titolo" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ReportTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="160"/>
        <TextBlock Text="Autore" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ReportAuthor, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
        <CheckBox Content="Sfondo bianco per il report" IsChecked="{Binding ReportWhiteBackground}"/>
        <TextBlock Text="Larghezza delle figure (pixel)" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding ExportWidths}" SelectedItem="{Binding ReportImageWidth}"/>
        <UniformGrid Columns="2" Margin="0,8,0,0"><Button Content="Apri…" Command="{Binding LoadReportRecipeCommand}" Margin="0,0,3,0"/><Button Content="Salva composizione…" Command="{Binding SaveReportRecipeCommand}" Margin="3,0,0,0"/></UniformGrid>
      </StackPanel></Expander>
      <TextBlock Text="AGGIUNGI CONTENUTI" Style="{StaticResource Caption}"/>
      <Button Content="+ Vista principale attuale" Command="{Binding AddReportFigureCommand}"/>
      <UniformGrid Columns="2" Margin="0,6,0,0"><Button Content="+ Testo libero" Command="{Binding AddReportTextCommand}" Margin="0,0,3,0"/><Button Content="+ Sezione verifica" Command="{Binding AddReportVerificationCommand}" Margin="3,0,0,0"/></UniformGrid>
      <Expander Header="Serie di viste e combinazioni" Margin="0,10"><StackPanel Margin="0,7">
        <TextBlock Text="Viste salvate · nessuna selezione = vista corrente" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,5"/>
        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ReportViews}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding Selected}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <TextBlock Text="Casi / combinazioni disponibili" Style="{StaticResource FieldLabel}"/>
        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ReportCases}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding Selected}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <Button Content="Aggiungi la serie" Command="{Binding AddReportSeriesCommand}" Margin="0,7,0,0"/>
        <TextBlock Text="Il campo e le impostazioni provengono dalle viste. Configurali nelle schede Vista e Risultati." FontSize="10" TextWrapping="Wrap" Opacity=".65" Margin="0,7"/>
      </StackPanel></Expander>
      <Expander Header="Collegamento alle verifiche" Margin="0,0,0,10"><StackPanel Margin="0,7">
        <ComboBox ItemsSource="{Binding Sheets}" SelectedItem="{Binding ReportSheet}"/>
        <TextBlock Text="Scegli il foglio prima di aggiungere la sezione. Per ora si salva il riferimento; il documento segnala che gli esiti non sono collegati." TextWrapping="Wrap" FontSize="10" Margin="0,7"/>
      </StackPanel></Expander>
      <TextBlock Text="COMPOSIZIONE" Style="{StaticResource Caption}"/>
      <TextBlock Text="{Binding ReportCount}" FontSize="10" Margin="0,0,0,6"/>
      <ListBox ItemsSource="{Binding ReportChapters}" SelectedItem="{Binding SelectedReportChapter}" MaxHeight="230" MinHeight="70" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="2,5">
          <CheckBox IsChecked="{Binding Included}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,7,0" ToolTip="Includi nel report"/>
          <StackPanel><TextBlock Text="{Binding Kind}" FontSize="9" Opacity=".65"/><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/></StackPanel>
        </DockPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <UniformGrid Columns="3" Margin="0,6"><Button Content="Su" Command="{Binding MoveReportChapterCommand}" CommandParameter="up"/><Button Content="Giù" Command="{Binding MoveReportChapterCommand}" CommandParameter="down"/><Button Content="Rimuovi" Command="{Binding RemoveReportChapterCommand}"/></UniformGrid>
      <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppearanceBorder}" Padding="0,10,0,0">
        <StackPanel>
          <TextBlock Text="CAPITOLO SELEZIONATO" FontSize="10" Opacity=".65" Margin="0,0,0,6"/>
          <TextBox Text="{Binding SelectedReportChapter.Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="160" ToolTip="Titolo del capitolo"/>
          <TextBlock Text="{Binding SelectedReportChapter.Detail}" FontSize="10" TextWrapping="Wrap" Margin="0,6"/>
          <TextBox Text="{Binding SelectedReportChapter.Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="85" MaxHeight="220" VerticalScrollBarVisibility="Auto" MaxLength="30000" ToolTip="Testo o didascalia del capitolo"/>
          <StackPanel Visibility="{Binding SelectedReportChapter.IsFigure, Converter={StaticResource Visible}}">
            <Button Content="Richiama la vista della figura" Command="{Binding ShowReportFigureCommand}" Margin="0,7,0,0"/>
            <Button Content="Aggiorna figura dalla vista principale" Command="{Binding ReplaceReportFigureCommand}" Margin="0,7,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppearanceBorder}" Padding="14,8"><StackPanel>
    <Button Content="Genera / aggiorna PDF" Command="{Binding BuildReportCommand}" IsEnabled="{Binding CanEditReport}" Margin="0,0,0,6" FontWeight="SemiBold"/>
    <ProgressBar Value="{Binding ReportPercent}" Maximum="100" Height="5" Visibility="{Binding IsReportRunning, Converter={StaticResource Visible}}"/>
    <Button Content="Annulla generazione" Command="{Binding BuildReportCancelCommand}" Visibility="{Binding IsReportRunning, Converter={StaticResource Visible}}" Margin="0,6"/>
    <Button Content="Apri PDF generato" Command="{Binding OpenReportPdfCommand}" Margin="0,6"/>
    <TextBlock Text="{Binding ReportMessage}" ToolTip="{Binding ReportMessage}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52" FontSize="11" Margin="0,6"/>
    <TextBlock Text="Ogni generazione crea una cartella con PDF, HTML e composizione modificabile. La vista interattiva resta indipendente." FontSize="10" TextWrapping="Wrap" Opacity=".65" Margin="0,6"/>
  </StackPanel></Border></Grid>
</UserControl>
