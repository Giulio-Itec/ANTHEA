<UserControl x:Class="ANTHEA.ModelViewer.Wpf.ModelCombinationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource AppearancePaper}">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ModelViewerStyles.xaml"/></ResourceDictionary.MergedDictionaries>
    <!-- Use the host theme templates even when the view is in a separate window. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="{DynamicResource AppearanceSurface}"/>
      <Setter Property="Template" Value="{DynamicResource AppearanceVerticalScrollBarTemplate}"/>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Template" Value="{DynamicResource AppearanceHorizontalScrollBarTemplate}"/></Trigger></Style.Triggers>
    </Style>
  </ResourceDictionary></UserControl.Resources>
  <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    <RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="160"/><Style.Triggers><DataTrigger Binding="{Binding ShowCombinationGrid}" Value="True"><Setter Property="Height" Value="*"/></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition>
    <RowDefinition Height="Auto"/>
    <RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="*"/><Style.Triggers><DataTrigger Binding="{Binding ShowCombinationEditor}" Value="False"><Setter Property="Height" Value="0"/></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition>
    <RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="›" Command="{Binding CloseCombinationManagerCommand}" ToolTip="Riduci gestione combinazioni" AutomationProperties.Name="Riduci combinazioni" VerticalAlignment="Top"/>
      <Button DockPanel.Dock="Right" Content="{Binding CombinationWindowLabel}" Command="{Binding ToggleCombinationWindowCommand}" VerticalAlignment="Top" Margin="4,0,6,0"/>
      <StackPanel><TextBlock Text="GESTIONE DEL MODELLO" Style="{StaticResource Caption}"/><TextBlock Text="Combinazioni" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding CombinationSummary}" Margin="0,4,0,0" Opacity=".7"/></StackPanel>
    </DockPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,8"><WrapPanel><Button Content="+ Nuova" Command="{Binding NewCombinationCommand}"/><Button Content="Duplica" Command="{Binding DuplicateCombinationCommand}" Margin="5,0"/><Button Content="Elimina" Command="{Binding DeleteCombinationCommand}"/><Button Content="Ripristina importate" Command="{Binding RestoreImportedCombinationsCommand}" Margin="5,0,0,0"/></WrapPanel>
      <WrapPanel><CheckBox Content="Griglia coefficienti" IsChecked="{Binding ShowCombinationGrid}" IsEnabled="{Binding CanChooseCombination}" Margin="0,8,16,4"/><CheckBox Content="Editor della selezione" IsChecked="{Binding ShowCombinationEditor}" Margin="0,8,0,4"/></WrapPanel>
    </StackPanel>
    <DataGrid Grid.Row="2" ItemsSource="{Binding Combinations}" SelectedItem="{Binding SelectedCombination}" Visibility="{Binding ShowCombinationList,Converter={StaticResource Visible}}" IsEnabled="{Binding CanChooseCombination}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" Loaded="RevealSelection" SelectionChanged="RevealSelection" AutomationProperties.Name="Elenco combinazioni">
      <DataGrid.Columns><DataGridTextColumn Header="Nome" Binding="{Binding Definition.Name}" Width="*"/><DataGridTextColumn Header="Sorgente" Binding="{Binding Definition.Source}" Width="100"/><DataGridTextColumn Header="Stato" Binding="{Binding State}" Width="105"/></DataGrid.Columns>
    </DataGrid>
    <DataGrid Grid.Row="2" ItemsSource="{Binding CombinationGridRows}" SelectedItem="{Binding SelectedCombinationGridRow}" Visibility="{Binding ShowCombinationGrid,Converter={StaticResource Visible}}" IsEnabled="{Binding CanChooseCombination}" AutoGenerateColumns="True" AutoGeneratingColumn="CombinationColumn" IsReadOnly="True" CanUserAddRows="False" FrozenColumnCount="3" EnableColumnVirtualization="True" EnableRowVirtualization="True" SelectionMode="Extended" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="IncludeHeader" GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource AppearanceBorder}" VerticalGridLinesBrush="{DynamicResource AppearanceBorder}" AutomationProperties.Name="Griglia coefficienti combinazioni" ToolTip="Seleziona la riga per gestire la combinazione. Copia celle con Ctrl+C; celle vuote: termine non presente. Coefficienti ripetuti separati da punto e virgola."/>
    <TextBlock Grid.Row="3" Text="{Binding CombinationOrigin}" TextWrapping="Wrap" FontSize="11" Opacity=".8" Margin="0,10" MaxHeight="64"/>
    <Grid Grid.Row="4" Visibility="{Binding ShowCombinationEditor,Converter={StaticResource Visible}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid IsEnabled="{Binding CanEditCombination}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,10,0"><TextBlock Text="Nome" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CombinationName,UpdateSourceTrigger=PropertyChanged}" MaxLength="200" MinHeight="32" VerticalContentAlignment="Center" AutomationProperties.Name="Nome combinazione"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="Operazione" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding CombinationKindLabels}" SelectedIndex="{Binding SelectedCombinationKind}" AutomationProperties.Name="Operazione combinazione"/></StackPanel>
      </Grid>
      <DockPanel Grid.Row="1" Margin="0,10,0,6"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="+ Termine" Command="{Binding AddCombinationTermCommand}"/><Button Content="−" Command="{Binding RemoveCombinationTermCommand}" Margin="4,0,0,0" ToolTip="Rimuovi termine selezionato"/></StackPanel><TextBlock Text="CASI E COMBINAZIONI" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel>
      <DataGrid Grid.Row="2" MinHeight="105" ItemsSource="{Binding CombinationTerms}" SelectedItem="{Binding SelectedCombinationTerm}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsEnabled="{Binding CanEditCombination}" SelectionMode="Single" HeadersVisibility="Column" AutomationProperties.Name="Termini combinazione">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Caso / combinazione" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.CombinationSources,RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Source,UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label" Margin="2" IsTextSearchEnabled="True"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Coefficiente" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Factor,UpdateSourceTrigger=PropertyChanged}" Margin="2" MinHeight="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <StackPanel Grid.Row="3" Margin="0,8,0,0"><TextBlock Text="{Binding CombinationRules}" TextWrapping="Wrap" FontSize="11" Opacity=".7"/><WrapPanel Margin="0,8"><Button Content="Salva definizione" Command="{Binding SaveCombinationCommand}"/><Button Content="Annulla modifiche" Command="{Binding DiscardCombinationEditsCommand}" Margin="6,0"/></WrapPanel></StackPanel>
    </Grid>
    <Border Grid.Row="5" BorderBrush="{DynamicResource AppearanceBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,4,0,0">
      <StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Annulla calcolo" Command="{Binding CalculateCombinationCancelCommand}" Visibility="{Binding IsCombinationBusy,Converter={StaticResource Visible}}"/><Button Content="{Binding CombinationActionLabel}" Command="{Binding CalculateCombinationCommand}" HorizontalAlignment="Left"/></DockPanel>
        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,4" Visibility="{Binding IsCombinationBusy,Converter={StaticResource Visible}}"/>
        <TextBox Text="{Binding CombinationMessage,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,7,0,0" FontSize="11"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
