<UserControl x:Class="ANTHEA.ModelViewer.Wpf.ModelViewToolsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ANTHEA.ModelViewer.Wpf">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ModelViewerStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="14,0,14,16">
    <TextBlock Text="VISTA E RAPPRESENTAZIONE" Style="{StaticResource Caption}"/>
    <UniformGrid Columns="2" Margin="0,0,0,6">
      <Button Content="Geometria" Command="{Binding SetRepresentationCommand}" CommandParameter="0" Style="{StaticResource ModeGeometry}" Margin="0,0,3,0" />
      <Button Content="Volumi e offset" Command="{Binding SetRepresentationCommand}" CommandParameter="1" Style="{StaticResource ModeSolid}" Margin="3,0,0,0" />
    </UniformGrid>
    <TextBlock Text="I risultati restano visibili anche sui volumi. Attivali o nascondili nella scheda Risultati." TextWrapping="Wrap" FontSize="10" Opacity=".65" Margin="0,0,0,8"/>
    <local:ModelViewSettingsView/>
    <Button Content="Vista precedente" Command="{Binding PreviousCameraCommand}" Margin="0,8"/>
    <Expander Header="Oggetti, colori ed etichette" Margin="0,8"><local:ModelDisplayOptionsView Margin="0,8"/></Expander>
    <Expander Header="Taglio e volume di esplorazione" Margin="0,8"><StackPanel Margin="0,8">
    <CheckBox Content="Attiva taglio grafico" IsChecked="{Binding ClipEnabled}"/>
    <ComboBox ItemsSource="{Binding ClipShapes}" SelectedIndex="{Binding ClipShape}" Margin="0,5,0,8" AutomationProperties.Name="Tipo di ritaglio"/>
    <StackPanel Visibility="{Binding IsPlaneClip,Converter={StaticResource Visible}}">
    <ComboBox ItemsSource="{Binding ClipAxes}" SelectedIndex="{Binding ClipAxis}"/>
    <Slider Value="{Binding ClipPercent}" Minimum="0" Maximum="100" AutoToolTipPlacement="TopLeft" ToolTip="Posizione del piano X/Y/Z nel modello"/>
    <TextBox Text="{Binding ClipNodes, UpdateSourceTrigger=PropertyChanged, Delay=400}" ToolTip="Per Tre nodi: tre ID separati da spazio"/>
    <CheckBox Content="Inverti lato visibile" IsChecked="{Binding ClipReverse}"/>
    </StackPanel>
    <StackPanel Visibility="{Binding IsBoxClip,Converter={StaticResource Visible}}">
      <TextBlock Text="Coordinate globali [m]" FontSize="10" Margin="0,2,0,8"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Column="1" Text="Minimo" FontSize="10"/><TextBlock Grid.Column="3" Text="Massimo" FontSize="10"/>
        <TextBlock Grid.Row="1" Text="X" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ClipBoxMinX,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True,StringFormat=0.####}" Margin="0,5,0,0"/><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ClipBoxMaxX,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True,StringFormat=0.####}" Margin="0,5,0,0"/>
        <TextBlock Grid.Row="2" Text="Y" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ClipBoxMinY,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True,StringFormat=0.####}" Margin="0,5,0,0"/><TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ClipBoxMaxY,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True,StringFormat=0.####}" Margin="0,5,0,0"/>
        <TextBlock Grid.Row="3" Text="Z" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ClipBoxMinZ,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True,StringFormat=0.####}" Margin="0,5,0,0"/><TextBox Grid.Row="3" Grid.Column="3" Text="{Binding ClipBoxMaxZ,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True,StringFormat=0.####}" Margin="0,5,0,0"/>
      </Grid>
      <CheckBox Content="Mostra contorno del volume" IsChecked="{Binding ShowClipBox}"/>
      <Button Content="Intorno alla selezione" Command="{Binding ClipBoxFromSelectionCommand}" Margin="0,7,0,0"/>
      <Button Content="Ripristina tutto il modello" Command="{Binding ResetClipBoxCommand}" Margin="0,5,0,0"/>
      <TextBlock Text="Il volume conserva la parte interna. I tagli delle facce non introducono nuove superfici o risultati nello spessore." FontSize="10" TextWrapping="Wrap" Opacity=".7" Margin="0,7"/>
    </StackPanel>
    <TextBlock Text="{Binding ClipDescription}" FontSize="10" TextWrapping="Wrap" Opacity=".7"/>
    </StackPanel></Expander>
    <Expander Header="Misure fra nodi" Margin="0,8"><local:ModelMeasurementsView Margin="0,8"/></Expander>
    <Expander Header="Viste salvate" Margin="0,8"><StackPanel Margin="0,8">
    <TextBox Text="{Binding ViewName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nome della vista"/>
    <Button Content="Salva camera, campo e visibilità" Command="{Binding SaveViewCommand}" Margin="0,6,0,0"/>
    <ComboBox ItemsSource="{Binding SavedViews}" SelectedItem="{Binding SelectedSavedView}" Margin="0,6,0,0"/>
    <UniformGrid Columns="2" Margin="0,6,0,0"><Button Content="Richiama" Command="{Binding RecallViewCommand}"/><Button Content="Rimuovi" Command="{Binding DeleteViewCommand}"/></UniformGrid>
    <TextBlock Text="Conservate su questo computer per la revisione importata." FontSize="10" TextWrapping="Wrap" Opacity=".65" Margin="0,7"/>
    </StackPanel></Expander>
    <Expander Header="Esportazione PNG" Margin="0,8"><StackPanel Margin="0,8">
    <CheckBox Content="Scena con titolo e legenda" IsChecked="{Binding ExportSceneOnly}"/>
    <CheckBox Content="Sfondo bianco da stampa" IsChecked="{Binding ExportWhiteBackground}"/>
    <TextBlock Text="Larghezza in pixel" FontSize="10" Margin="0,5"/>
    <ComboBox ItemsSource="{Binding ExportWidths}" SelectedItem="{Binding ExportWidth}"/>
    <Button Content="Esporta immagine…" Command="{Binding SaveImageCommand}" Margin="0,6,0,0"/>
    </StackPanel></Expander>
    <TextBlock Text="{Binding ExplorationMessage}" TextWrapping="Wrap" Margin="0,12" FontSize="11"/>
  </StackPanel></ScrollViewer>
</UserControl>
