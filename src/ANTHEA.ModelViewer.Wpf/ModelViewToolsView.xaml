<UserControl x:Class="ANTHEA.ModelViewer.Wpf.ModelViewToolsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ModelViewerStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="14,0,14,16">
    <TextBlock Text="CAMERA E STILE" Style="{StaticResource Caption}"/>
    <UniformGrid Columns="3"><Button Content="Front" Command="{Binding CameraPresetCommand}" CommandParameter="front"/><Button Content="Top" Command="{Binding CameraPresetCommand}" CommandParameter="top"/><Button Content="45°" Command="{Binding CameraPresetCommand}" CommandParameter="iso-ne"/></UniformGrid>
    <Button Content="Camera, sfondo e qualità…" Command="{Binding ToggleViewSettingsCommand}" Margin="0,6,0,0"/>
    <Button Content="Vista precedente" Command="{Binding PreviousCameraCommand}" Margin="0,6,0,0"/>
    <CheckBox Content="Bordi esterni e spigoli" IsChecked="{Binding ShowOutlines}"/>
    <CheckBox Content="Evita sovrapposizioni delle etichette" IsChecked="{Binding AvoidLabelOverlap}"/>
    <TextBlock Text="Opacità delle superfici" Style="{StaticResource FieldLabel}"/>
    <Slider Value="{Binding SurfaceOpacity}" Minimum=".1" Maximum="1" AutoToolTipPlacement="TopLeft"/>
    <TextBlock Text="PIANO DI TAGLIO" Style="{StaticResource Caption}"/>
    <CheckBox Content="Attiva taglio grafico" IsChecked="{Binding ClipEnabled}"/>
    <ComboBox ItemsSource="{Binding ClipAxes}" SelectedIndex="{Binding ClipAxis}"/>
    <Slider Value="{Binding ClipPercent}" Minimum="0" Maximum="100" AutoToolTipPlacement="TopLeft" ToolTip="Posizione del piano X/Y/Z nel modello"/>
    <TextBox Text="{Binding ClipNodes, UpdateSourceTrigger=PropertyChanged, Delay=400}" ToolTip="Per Tre nodi: tre ID separati da spazio"/>
    <CheckBox Content="Inverti lato visibile" IsChecked="{Binding ClipReverse}"/>
    <TextBlock Text="{Binding ClipDescription}" FontSize="10" TextWrapping="Wrap" Opacity=".7"/>
    <TextBlock Text="VISTE SALVATE" Style="{StaticResource Caption}"/>
    <TextBox Text="{Binding ViewName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nome della vista"/>
    <Button Content="Salva camera, campo e visibilità" Command="{Binding SaveViewCommand}" Margin="0,6,0,0"/>
    <ComboBox ItemsSource="{Binding SavedViews}" SelectedItem="{Binding SelectedSavedView}" Margin="0,6,0,0"/>
    <UniformGrid Columns="2" Margin="0,6,0,0"><Button Content="Richiama" Command="{Binding RecallViewCommand}"/><Button Content="Rimuovi" Command="{Binding DeleteViewCommand}"/></UniformGrid>
    <TextBlock Text="Conservate su questo computer per la revisione importata." FontSize="10" TextWrapping="Wrap" Opacity=".65" Margin="0,7"/>
    <TextBlock Text="ESPORTAZIONE PNG" Style="{StaticResource Caption}"/>
    <CheckBox Content="Scena con titolo e legenda" IsChecked="{Binding ExportSceneOnly}"/>
    <CheckBox Content="Sfondo bianco da stampa" IsChecked="{Binding ExportWhiteBackground}"/>
    <TextBlock Text="Larghezza in pixel" FontSize="10" Margin="0,5"/>
    <ComboBox ItemsSource="{Binding ExportWidths}" SelectedItem="{Binding ExportWidth}"/>
    <Button Content="Esporta immagine…" Command="{Binding SaveImageCommand}" Margin="0,6,0,0"/>
    <TextBlock Text="{Binding ExplorationMessage}" TextWrapping="Wrap" Margin="0,12" FontSize="11"/>
  </StackPanel></ScrollViewer>
</UserControl>
