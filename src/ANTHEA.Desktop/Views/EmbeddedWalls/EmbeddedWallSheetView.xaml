           <Button Content="↓" Command="{Binding DownCommand}" ToolTip="Sposta dopo" Margin="0,0,6,4"/>
          </WrapPanel>
          <ContentControl Content="{Binding Editor}"/>
         </StackPanel>
         <Button Content="Apri tutte le tabelle" Command="{Binding OpenDataCommand}" HorizontalAlignment="Left" Margin="0,12,0,8"/>
         <Expander Header="Importa stratigrafia del progetto" Margin="0,8">
