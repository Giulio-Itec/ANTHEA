    </Style.Triggers></Style></Border.Style>
    <StackPanel Margin="2,4">
     <Button Content="›" Command="{Binding ToggleWorkTreeCommand}" Padding="7,1" MinHeight="26"
      ToolTip="Apri l'albero di lavoro" AutomationProperties.Name="Apri albero di lavoro"/>
     <TextBlock Text="Albero di lavoro" Margin="0,12,0,0" HorizontalAlignment="Center">
