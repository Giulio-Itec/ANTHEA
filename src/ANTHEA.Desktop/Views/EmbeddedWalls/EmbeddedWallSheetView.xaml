<UserControl x:Class="X.Desktop.Views.EmbeddedWalls.EmbeddedWallSheetView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:X.Desktop.Views.Common"
 xmlns:local="clr-namespace:X.Desktop.Views.EmbeddedWalls" Background="{DynamicResource Token.Surface}" Foreground="{DynamicResource Token.Ink}">
 <!--
  Organizzazione del modulo paratie (progetto del 16/11, step 1): a Navy command bar with pages of commands grouped by subject above the work
  area, and the documents opened in the centre (the section of the phase always open; tables, results and checks opened on request and closed
  from their tab). Only commands the sheet already has: no button without a function. Colours are theme tokens only (P7).
 -->
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Shown"/>
  <!-- Commands on the bar: the colours of Shell.BarButton (ShellTemplates.xaml, not merged in a module view), a little lower. -->
  <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource Token.CommandBar}"/>
   <Setter Property="Foreground" Value="{DynamicResource Token.OnCommandBar}"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Padding" Value="9,2"/>
   <Setter Property="Margin" Value="1,2"/>
   <Setter Property="MinHeight" Value="28"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Token.CommandBar.Hover}"/></Trigger></Style.Triggers>
  </Style>
  <!-- A group of commands: the buttons, its name below, a divider on the right. -->
  <Style x:Key="BarGroup" TargetType="HeaderedContentControl">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Margin" Value="0,0,6,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="HeaderedContentControl">
    <Border BorderBrush="{DynamicResource Token.CommandBar.Hover}" BorderThickness="0,0,1,0" Padding="2,0,8,0">
     <DockPanel>
      <TextBlock DockPanel.Dock="Bottom" Text="{TemplateBinding Header}" FontSize="{DynamicResource Font.Small}" Foreground="{DynamicResource Token.OnCommandBar.Muted}"
       HorizontalAlignment="Center" Margin="0,0,0,2"/>
      <ContentPresenter/>
     </DockPanel>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Header of a document: its title and, except for the section, the button that closes it. -->
  <DataTemplate x:Key="DocumentHeader">
   <StackPanel Orientation="Horizontal">
    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
    <Button Content="×" Command="{Binding CloseCommand}" Visibility="{Binding CanClose, Converter={StaticResource Shown}}" Focusable="False"
     Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource Token.Muted}" Padding="3,0" Margin="6,0,0,0" MinHeight="0"
     ToolTip="Chiudi il documento" AutomationProperties.Name="{Binding Title, StringFormat=Chiudi {0}}"/>
   </StackPanel>
  </DataTemplate>
  <!-- The menu Fase (step 2): on the page Modello of the bar and on the tabs of the phases; one instance per use. -->
  <ContextMenu x:Key="StageMenu" x:Shared="False">
   <MenuItem Header="Aggiungi fase" Command="{Binding AddStageCommand}" InputGestureText="Ins"/>
   <MenuItem Header="Inserisci fase prima della corrente" Command="{Binding InsertStageCommand}"/>
   <Separator/>
   <MenuItem Header="Rinomina la fase corrente…" Command="{Binding RenameStageCommand}" InputGestureText="F2"/>
   <MenuItem Header="Rinomina tutte le fasi (F1…Fn)" Command="{Binding RenameAllStagesCommand}"/>
   <Separator/>
   <MenuItem Header="Elimina la fase corrente" Command="{Binding DeleteStageCommand}" InputGestureText="Canc"/>
  </ContextMenu>
  <!-- Boxes of the command bar (step 3): written when the box loses the focus or with Invio (BarBoxKeyDown), read-only without a phase. -->
  <Style x:Key="BarBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Width" Value="58"/>
   <Setter Property="Margin" Value="2,3"/>
   <Setter Property="TextAlignment" Value="Right"/>
   <Setter Property="IsReadOnly" Value="{Binding StageLevels.IsReadOnly}"/>
   <EventSetter Event="KeyDown" Handler="BarBoxKeyDown"/>
  </Style>
  <Style x:Key="BarLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Token.OnCommandBar}"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Margin" Value="6,0,2,0"/>
  </Style>
 </UserControl.Resources>
 <DockPanel>
  <Grid DockPanel.Dock="Top" Background="{DynamicResource Token.CommandBar}">
   <TabControl x:Name="CommandPages" SelectedValuePath="Tag" SelectedValue="{Binding CommandPage}" Background="{DynamicResource Token.CommandBar}"
    BorderThickness="0" Padding="0" AutomationProperties.Name="Barra dei comandi della paratia">
    <TabControl.Template><ControlTemplate TargetType="TabControl">
     <DockPanel Background="{TemplateBinding Background}">
      <TabPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="8,3,8,0"/>
      <Border BorderBrush="{DynamicResource Token.CommandBar.Hover}" BorderThickness="0,1,0,0" Padding="8,4,8,2">
       <ContentPresenter ContentSource="SelectedContent"/>
      </Border>
     </DockPanel>
    </ControlTemplate></TabControl.Template>
    <TabControl.Resources>
     <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource Token.OnCommandBar.Muted}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
       <Border x:Name="Page" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="12,4,12,3" Cursor="Hand">
        <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}"/>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Page" Property="Background" Value="{DynamicResource Token.CommandBar.Hover}"/></Trigger>
        <Trigger Property="IsSelected" Value="True">
         <Setter Property="Foreground" Value="{DynamicResource Token.OnCommandBar}"/><Setter Property="FontWeight" Value="SemiBold"/>
         <Setter TargetName="Page" Property="Background" Value="{DynamicResource Token.CommandBar.Hover}"/>
         <Setter TargetName="Page" Property="BorderBrush" Value="{DynamicResource Token.Selection.Border}"/>
        </Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
     </Style>
    </TabControl.Resources>
    <TabItem Header="Generale" Tag="generale">
     <WrapPanel>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Paratia"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Paratia e impostazioni" Command="{Binding EditModelCommand}" CommandParameter="general"/>
      </WrapPanel></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Casi"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Altri casi / combinazioni" Command="{Binding EditModelCommand}" CommandParameter="cases"/>
      </WrapPanel></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Tabelle"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Apri tutte le tabelle" Command="{Binding OpenDataCommand}"/>
      </WrapPanel></HeaderedContentControl>
     </WrapPanel>
    </TabItem>
    <TabItem Header="Sezioni" Tag="sezioni">
     <WrapPanel>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Parete"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Tratti e rigidezze" Command="{Binding EditModelCommand}" CommandParameter="segments"/>
      </WrapPanel></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Sezioni"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Fasce in c.a." Command="{Binding EditModelCommand}" CommandParameter="rc_sections"/>
       <Button Style="{StaticResource BarButton}" Content="Tubi CHS" Command="{Binding EditModelCommand}" CommandParameter="steel_tubes"/>
       <Button Style="{StaticResource BarButton}" Content="Pali in c.a." Command="{Binding EditModelCommand}" CommandParameter="rc_piles"/>
      </WrapPanel></HeaderedContentControl>
     </WrapPanel>
    </TabItem>
    <TabItem Header="Modello" Tag="modello">
     <WrapPanel>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Fasi"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Fase ▾" ContextMenu="{StaticResource StageMenu}" Click="OpenMenu"
        ToolTip="Aggiungi, inserisci, rinomina o elimina le fasi del caso" AutomationProperties.Name="Menu Fase"/>
       <Button Style="{StaticResource BarButton}" Content="Fasi e falda" Command="{Binding EditModelCommand}" CommandParameter="stages"/>
      </WrapPanel></HeaderedContentControl>
      <!-- Step 3: the levels of the phase chosen in the tabs, written in its row of «Fasi costruttive» (empty water: none). -->
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Scavo [m]"><StackPanel Orientation="Horizontal">
       <TextBlock Style="{StaticResource BarLabel}" Text="Sx"/>
       <TextBox Style="{StaticResource BarBox}" Text="{Binding StageLevels.LeftGround}" ToolTip="Quota del terreno a sinistra nella fase scelta [m]" AutomationProperties.Name="Scavo a sinistra della fase"/>
       <TextBlock Style="{StaticResource BarLabel}" Text="Dx"/>
       <TextBox Style="{StaticResource BarBox}" Text="{Binding StageLevels.RightGround}" ToolTip="Quota del terreno a destra nella fase scelta [m]" AutomationProperties.Name="Scavo a destra della fase"/>
      </StackPanel></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Falda [m] · vuoto: assente"><StackPanel Orientation="Horizontal">
       <TextBlock Style="{StaticResource BarLabel}" Text="Sx"/>
       <TextBox Style="{StaticResource BarBox}" Text="{Binding StageLevels.LeftWater}" ToolTip="Quota della falda a sinistra nella fase scelta [m]; vuoto: assente" AutomationProperties.Name="Falda a sinistra della fase"/>
       <TextBlock Style="{StaticResource BarLabel}" Text="Dx"/>
       <TextBox Style="{StaticResource BarBox}" Text="{Binding StageLevels.RightWater}" ToolTip="Quota della falda a destra nella fase scelta [m]; vuoto: assente" AutomationProperties.Name="Falda a destra della fase"/>
      </StackPanel></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Sovraccarico [kPa] · parete [kN/m]"><StackPanel Orientation="Horizontal">
       <TextBlock Style="{StaticResource BarLabel}" Text="Sx"/>
       <TextBox Style="{StaticResource BarBox}" Text="{Binding StageLevels.LeftSurcharge}" ToolTip="Sovraccarico a sinistra nella fase scelta [kPa]" AutomationProperties.Name="Sovraccarico a sinistra della fase"/>
       <TextBlock Style="{StaticResource BarLabel}" Text="Dx"/>
       <TextBox Style="{StaticResource BarBox}" Text="{Binding StageLevels.RightSurcharge}" ToolTip="Sovraccarico a destra nella fase scelta [kPa]" AutomationProperties.Name="Sovraccarico a destra della fase"/>
       <TextBlock Style="{StaticResource BarLabel}" Text="Parete"/>
       <TextBox Style="{StaticResource BarBox}" Text="{Binding StageLevels.WallLoad}" ToolTip="Carico uniforme sull'intera fascia nella fase scelta [kN/m], positivo verso destra" AutomationProperties.Name="Carico uniforme sulla parete della fase"/>
      </StackPanel></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Terreni"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Terreno sx" Command="{Binding EditModelCommand}" CommandParameter="left_soils"/>
       <Button Style="{StaticResource BarButton}" Content="Terreno dx" Command="{Binding EditModelCommand}" CommandParameter="right_soils"/>
      </WrapPanel></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Elementi strutturali"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Tiranti e puntoni" Command="{Binding EditModelCommand}" CommandParameter="supports"/>
       <Button Style="{StaticResource BarButton}" Content="Presenza nelle fasi" Command="{Binding EditModelCommand}" CommandParameter="activations"/>
      </WrapPanel></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Carichi"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Concentrati" Command="{Binding EditModelCommand}" CommandParameter="loads"/>
       <Button Style="{StaticResource BarButton}" Content="Distribuiti" Command="{Binding EditModelCommand}" CommandParameter="distributed_loads"/>
      </WrapPanel></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Tabelle"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Input tabellare" Command="{Binding OpenDataCommand}"/>
      </WrapPanel></HeaderedContentControl>
     </WrapPanel>
    </TabItem>
    <TabItem Header="Filtrazione" Tag="filtrazione">
     <WrapPanel>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Filtrazione"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Parametri e campo idraulico" Command="{Binding Documents.ShowCommand}" CommandParameter="filtrazione"/>
      </WrapPanel></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Permeabilità"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Sinistra" Command="{Binding EditModelCommand}" CommandParameter="hydraulic_left"/>
       <Button Style="{StaticResource BarButton}" Content="Destra" Command="{Binding EditModelCommand}" CommandParameter="hydraulic_right"/>
      </WrapPanel></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="UPL / HYD"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Corpi UPL" Command="{Binding EditModelCommand}" CommandParameter="hydraulic_upl"/>
       <Button Style="{StaticResource BarButton}" Content="Azioni UPL" Command="{Binding EditModelCommand}" CommandParameter="hydraulic_actions"/>
       <Button Style="{StaticResource BarButton}" Content="Punti HYD" Command="{Binding EditModelCommand}" CommandParameter="hydraulic_hyd"/>
       <Button Style="{StaticResource BarButton}" Content="Verifiche UPL / HYD" Command="{Binding Documents.ShowCommand}" CommandParameter="upl-hyd"/>
      </WrapPanel></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Esporta"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Idraulica CSV" Command="{Binding HydraulicCsvCommand}"/>
       <Button Style="{StaticResource BarButton}" Content="Verifiche idrauliche CSV" Command="{Binding HydraulicChecksCsvCommand}"/>
      </WrapPanel></HeaderedContentControl>
     </WrapPanel>
    </TabItem>
    <TabItem Header="Stabilità" Tag="stabilita">
     <WrapPanel>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Dati"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Verifiche globali" Command="{Binding EditModelCommand}" CommandParameter="global_checks"/>
       <Button Style="{StaticResource BarButton}" Content="Combinazioni globali" Command="{Binding EditModelCommand}" CommandParameter="global_actions"/>
      </WrapPanel></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Esiti"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Stabilità globale" Command="{Binding Documents.ShowCommand}" CommandParameter="stabilita"/>
       <Button Style="{StaticResource BarButton}" Content="Esporta CSV" Command="{Binding GlobalCsvCommand}"/>
      </WrapPanel></HeaderedContentControl>
     </WrapPanel>
    </TabItem>
    <TabItem Header="Analisi" Tag="analisi">
     <WrapPanel>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Calcolo"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Calcola tutti i casi" Command="{Binding RunCommand}"/>
       <Button Style="{StaticResource BarButton}" Content="Annulla" Command="{Binding CancelCommand}"/>
      </WrapPanel></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Infissione"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Ricerca dell'infissione" Command="{Binding Documents.ShowCommand}" CommandParameter="infissione"/>
       <Button Style="{StaticResource BarButton}" Content="Cerca infissione" Command="{Binding SearchEmbedmentCommand}"/>
      </WrapPanel></HeaderedContentControl>
     </WrapPanel>
    </TabItem>
    <TabItem Header="Verifiche" Tag="verifiche">
     <WrapPanel>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Norme"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Verifiche e combinazioni" Command="{Binding EditModelCommand}" CommandParameter="general"/>
      </WrapPanel></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Dati dei sostegni"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Acciaio dei sostegni" Command="{Binding EditModelCommand}" CommandParameter="steel_members"/>
       <Button Style="{StaticResource BarButton}" Content="Sfilamento dei tiranti" Command="{Binding EditModelCommand}" CommandParameter="anchor_checks"/>
       <Button Style="{StaticResource BarButton}" Content="Indagini dei bulbi" Command="{Binding EditModelCommand}" CommandParameter="anchor_layers"/>
       <Button Style="{StaticResource BarButton}" Content="Prove preliminari" Command="{Binding EditModelCommand}" CommandParameter="anchor_tests"/>
      </WrapPanel></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Esiti"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="C.a. e sostegni" Command="{Binding Documents.ShowCommand}" CommandParameter="verifiche-ca"/>
       <Button Style="{StaticResource BarButton}" Content="Acciaio sostegni" Command="{Binding Documents.ShowCommand}" CommandParameter="acciaio"/>
       <Button Style="{StaticResource BarButton}" Content="Sfilamento tiranti" Command="{Binding Documents.ShowCommand}" CommandParameter="sfilamento"/>
       <Button Style="{StaticResource BarButton}" Content="Sezioni acciaio" Command="{Binding Documents.ShowCommand}" CommandParameter="tubolari"/>
       <Button Style="{StaticResource BarButton}" Content="Pali in c.a." Command="{Binding Documents.ShowCommand}" CommandParameter="pali-ca"/>
       <Button Style="{StaticResource BarButton}" Content="UPL / HYD" Command="{Binding Documents.ShowCommand}" CommandParameter="upl-hyd"/>
       <Button Style="{StaticResource BarButton}" Content="Stabilità globale" Command="{Binding Documents.ShowCommand}" CommandParameter="stabilita"/>
      </WrapPanel></HeaderedContentControl>
     </WrapPanel>
    </TabItem>
    <TabItem Header="Risultati" Tag="risultati">
     <WrapPanel>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Diagrammi"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Diagrammi e risultati" Command="{Binding OpenResultsCommand}"/>
       <Button Style="{StaticResource BarButton}" Content="Inviluppi" Command="{Binding Documents.ShowCommand}" CommandParameter="inviluppi"/>
      </WrapPanel></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Esporta"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Tutti i casi CSV" Command="{Binding CsvCommand}"/>
       <Button Style="{StaticResource BarButton}" Content="Inviluppi CSV" Command="{Binding EnvelopeCsvCommand}"/>
      </WrapPanel></HeaderedContentControl>
     </WrapPanel>
    </TabItem>
    <TabItem Header="Vista" Tag="vista">
     <WrapPanel>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Pannelli"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Albero di lavoro" Command="{Binding ToggleWorkTreeCommand}"/>
      </WrapPanel></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource BarGroup}" Header="Documenti"><WrapPanel>
       <Button Style="{StaticResource BarButton}" Content="Chiudi tutti i documenti" Command="{Binding Documents.CloseAllCommand}"/>
      </WrapPanel></HeaderedContentControl>
     </WrapPanel>
    </TabItem>
   </TabControl>
   <!-- The calculation stays at hand on every page, at the right of the names of the pages. -->
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,8,0">
    <Button Style="{StaticResource BarButton}" Content="Calcola tutti i casi" Command="{Binding RunCommand}"/>
    <Button Style="{StaticResource BarButton}" Content="Annulla" Command="{Binding CancelCommand}"/>
   </StackPanel>
  </Grid>
  <StackPanel DockPanel.Dock="Top" Margin="12,6,12,0">
   <TextBlock Text="{Binding ResultStatus}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4"/>
   <TextBlock Text="{Binding CalculationMessage}" TextWrapping="Wrap" Margin="0,2,0,8">
    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding CalculationMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding CalculationMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
   <TextBlock Text="{Binding Progress}" Margin="0,0,0,6">
    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Progress}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
  </StackPanel>
  <Grid Margin="12,0,12,12">
   <Grid.ColumnDefinitions>
    <ColumnDefinition>
     <ColumnDefinition.Style>
      <Style TargetType="ColumnDefinition">
       <Setter Property="Width" Value="270"/><Setter Property="MinWidth" Value="230"/><Setter Property="MaxWidth" Value="420"/>
       <Style.Triggers><DataTrigger Binding="{Binding IsWorkTreeCollapsed}" Value="True">
        <Setter Property="Width" Value="38"/><Setter Property="MinWidth" Value="38"/><Setter Property="MaxWidth" Value="38"/>
       </DataTrigger></Style.Triggers>
      </Style>
     </ColumnDefinition.Style>
    </ColumnDefinition>
    <ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>
   <Border x:Name="WorkTreePane" BorderBrush="{DynamicResource Token.Border}" BorderThickness="0,0,1,0">
    <Border.Style><Style TargetType="Border"><Style.Triggers>
     <DataTrigger Binding="{Binding IsWorkTreeCollapsed}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
    </Style.Triggers></Style></Border.Style>
    <!-- Step 4 of the project of 16/11: the box Caso (in place of the design assumption, D3) above the tabs Albero and Analisi. -->
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="6,4,8,6">
      <DockPanel>
       <Button Content="‹" Command="{Binding ToggleWorkTreeCommand}" DockPanel.Dock="Right" Padding="9,1" MinHeight="26"
        ToolTip="Richiudi il pannello" AutomationProperties.Name="Richiudi albero di lavoro"/>
       <TextBlock Text="CASO" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <ComboBox x:Name="CaseSelector" ItemsSource="{Binding InputCases}" SelectedItem="{Binding InputCase}" Margin="0,4,0,3"
       ToolTip="Caso mostrato nel disegno, nell'albero e nei risultati" AutomationProperties.Name="Caso dell'anteprima e dei risultati"/>
      <TextBlock Text="{Binding ResultCaseStatus}" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
     </StackPanel>
     <TabControl x:Name="LeftPanelTabs" TabStripPlacement="Bottom" Padding="0" BorderThickness="0,1,0,1" Background="{DynamicResource Token.Surface}"
      BorderBrush="{DynamicResource Token.Border}" AutomationProperties.Name="Pannello del modello">
      <TabItem Header="Albero">
       <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="6,6,8,8">
         <TextBlock Text="ALBERO DEL MODELLO" FontSize="11" FontWeight="SemiBold"/>
         <TextBlock Text="{Binding WorkTreeSummary}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <TreeView x:Name="WorkTreeView" ItemsSource="{Binding WorkTree}" SelectedItemChanged="WorkTreeSelectionChanged"
         PreviewMouseUp="WorkTreeItemClicked" PreviewKeyDown="WorkTreeKeyDown"
         Background="{DynamicResource Token.Surface}" Foreground="{DynamicResource Token.Ink}" BorderThickness="0"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Albero di lavoro della paratia">
         <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem" BasedOn="{StaticResource ProjectTreeItem}">
           <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
           <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
           <Setter Property="Foreground" Value="{DynamicResource Token.Ink}"/>
           <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
             <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
             <Border x:Name="Row" Grid.ColumnSpan="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" MinHeight="30">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
               <ToggleButton x:Name="Expander" Style="{StaticResource ProjectChevron}"
                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
               <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" Margin="3,3,5,3" VerticalAlignment="Center"/>
              </Grid>
             </Border>
             <Border x:Name="Guide" Grid.Row="1" Margin="9,0,0,0" BorderBrush="{DynamicResource Token.Border}" BorderThickness="1,0,0,0"/>
             <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
            </Grid>
            <ControlTemplate.Triggers>
             <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/><Setter TargetName="Guide" Property="Visibility" Value="Collapsed"/></Trigger>
             <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/><Setter TargetName="Guide" Property="Visibility" Value="Collapsed"/></Trigger>
             <Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Token.Hover.Row}"/></Trigger>
             <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Token.Selection}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Token.Selection.Border}"/><Setter TargetName="Row" Property="BorderThickness" Value="3,0,0,0"/></Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate></Setter.Value></Setter>
          </Style>
         </TreeView.ItemContainerStyle>
         <TreeView.ItemTemplate>
          <HierarchicalDataTemplate ItemsSource="{Binding Children}">
           <TextBlock Text="{Binding Title}" ToolTip="{Binding Detail}" TextWrapping="Wrap" FontSize="12">
           <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          </HierarchicalDataTemplate>
         </TreeView.ItemTemplate>
        </TreeView>
       </DockPanel>
      </TabItem>
      <TabItem Header="Analisi">
       <DockPanel>
        <!-- Contract C5: the request and the snapshot are two states; the state of the sheet in the project is in the tree of the project. -->
        <StackPanel DockPanel.Dock="Top" Margin="6,6,8,8">
         <TextBlock Text="{Binding RequestStatus}" TextWrapping="Wrap" FontSize="11"/>
         <TextBlock Text="{Binding SnapshotStatus}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
