     <DataTrigger Binding="{Binding IsWorkTreeCollapsed}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
    </Style.Triggers></Style></GridSplitter.Style>
   </GridSplitter>
  <!-- The documents: the tab of a closed document is collapsed; the active one follows Documents.Active (its key is the Tag). -->
  <!-- Step 11 (S16): the panel Messaggi at the bottom of the documents. Its lines are the notices and errors already produced by ANTHEA and GPC
       (data drawn, request, engine, results), with time, level in words, origin and element; a line with an element opens it. Filter,
       «Pulisci» and «Nascondi» are state of the view. -->
  <DockPanel Grid.Column="2">
   <Border x:Name="MessagesPanel" DockPanel.Dock="Bottom" Margin="0,6,0,0" BorderBrush="{DynamicResource Token.Border}" BorderThickness="1"
    Background="{DynamicResource Token.Paper}" AutomationProperties.Name="Messaggi della paratia">
    <DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="8,3,4,3">
      <Button DockPanel.Dock="Right" Content="{Binding Messages.ToggleText}" Command="{Binding Messages.ToggleCommand}" Padding="8,0" MinHeight="24" Margin="4,0,0,0"
       ToolTip="Mostra o nasconde l'elenco dei messaggi" AutomationProperties.Name="Mostra o nascondi i messaggi"/>
      <Button DockPanel.Dock="Right" Content="Pulisci" Command="{Binding Messages.ClearCommand}" Padding="8,0" MinHeight="24" Margin="4,0,0,0"
       ToolTip="Toglie dalla vista i messaggi presenti; ricompaiono se vengono prodotti di nuovo" AutomationProperties.Name="Pulisci i messaggi"/>
      <ComboBox x:Name="MessageFilter" DockPanel.Dock="Right" ItemsSource="{Binding Messages.Filters}" SelectedItem="{Binding Messages.Filter}" Width="140" Margin="4,0,0,0"
       ToolTip="Livelli dei messaggi mostrati" AutomationProperties.Name="Livello dei messaggi mostrati"/>
      <TextBlock Text="MESSAGGI" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Messages.Summary}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Token.Muted}" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
     <!-- 96 px (about four lines) instead of the 110 of the project: at 1100×760 the drawing keeps more than 200 px (R10). -->
     <ScrollViewer x:Name="MessageScroll" Height="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers>
       <DataTrigger Binding="{Binding Messages.IsCollapsed}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers></Style></ScrollViewer.Style>
      <StackPanel>
       <TextBlock Text="Nessun messaggio." Margin="9,4" Foreground="{DynamicResource Token.Muted}" Visibility="{Binding Messages.IsEmpty, Converter={StaticResource Shown}}"/>
       <ItemsControl x:Name="MessageList" ItemsSource="{Binding Messages.Items}" Focusable="False" AutomationProperties.Name="Elenco dei messaggi">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Button Command="{Binding DataContext.Messages.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
          Style="{StaticResource MessageRow}" ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding Text}">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="54"/><ColumnDefinition Width="52"/><ColumnDefinition Width="Auto" MaxWidth="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource Token.Muted}"/>
           <TextBlock x:Name="Level" Grid.Column="1" Text="{Binding LevelText}" FontWeight="SemiBold" Foreground="{DynamicResource Token.Muted}"/>
           <TextBlock Grid.Column="2" Text="{Binding Origin}" Foreground="{DynamicResource Token.Muted}"/>
           <TextBlock Grid.Column="3" Text="{Binding Place}" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Token.Accent}"/>
           <TextBlock Grid.Column="4" Text="{Binding Text}" TextWrapping="Wrap"/>
          </Grid>
         </Button>
         <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsError}" Value="True"><Setter TargetName="Level" Property="Foreground" Value="{DynamicResource Token.Status.Fail}"/></DataTrigger>
          <DataTrigger Binding="{Binding IsWarning}" Value="True"><Setter TargetName="Level" Property="Foreground" Value="{DynamicResource Token.Warning.Foreground}"/></DataTrigger>
         </DataTemplate.Triggers>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  <TabControl x:Name="Documents" SelectedValuePath="Tag" SelectedValue="{Binding Documents.Active}" AutomationProperties.Name="Documenti aperti della paratia">
   <TabItem Tag="sezione" Header="{Binding Documents[sezione]}" HeaderTemplate="{StaticResource DocumentHeader}">
    <DockPanel Margin="8">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="380" MinWidth="320" MaxWidth="520"/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid.InputBindings>
        <KeyBinding Key="PageUp" Command="{Binding PreviousInputStageCommand}"/>
        <KeyBinding Key="PageDown" Command="{Binding NextInputStageCommand}"/>
       </Grid.InputBindings>
       <!-- Step 5: wall, case and phase are the header inside the drawing; above it one line with the summary of the phase (step 11: the
            panel Messaggi takes room at the bottom, R10: the drawing stays usable at 1100×760). -->
       <TextBlock Margin="0,0,8,4" TextTrimming="CharacterEllipsis" ToolTip="Clic su un elemento: modifica · rotellina: ingrandisci · trascinamento: sposta il disegno ingrandito">
        <Run Text="{Binding PhaseSummary, Mode=OneWay}"/><Run Text="  ·  clic: modifica · rotellina: ingrandisci"/>
       </TextBlock>
       <Border Grid.Row="1" BorderBrush="{DynamicResource Token.Border}" BorderThickness="1" Margin="0,0,8,0">
        <local:EmbeddedWallModelSketch Model="{Binding Sketch}" PickCommand="{Binding PickModelCommand}" Zoom="{Binding SketchZoom}" ShowLegend="{Binding ShowSoilLegend}"
         Selected="{Binding SketchSelection, Mode=OneWay}" ClipToBounds="True" AutomationProperties.Name="Sezione grafica degli input della paratia"/>
       </Border>
       <!-- Organizzazione del modulo paratie (progetto del 16/11), step 2: one tab per phase of the case along the lower edge of the drawing, «+» adds
            one; the right button opens the menu Fase. Ins adds, F2 renames, Canc deletes the current phase. -->
       <DockPanel Grid.Row="2" Margin="0,0,8,0">
        <Button DockPanel.Dock="Right" Content="+" Command="{Binding AddStageCommand}" Padding="10,0" MinHeight="26" Margin="4,0,0,0"
         ToolTip="Aggiungi fase (Ins)" AutomationProperties.Name="Aggiungi fase"/>
        <ListBox x:Name="StageTabs" ItemsSource="{Binding InputStages}" SelectedItem="{Binding InputStage}" ContextMenu="{StaticResource StageMenu}"
         Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
         AutomationProperties.Name="Fasi del caso">
         <ListBox.InputBindings>
          <KeyBinding Key="Insert" Command="{Binding AddStageCommand}"/>
          <KeyBinding Key="F2" Command="{Binding RenameStageCommand}"/>
          <KeyBinding Key="Delete" Command="{Binding DeleteStageCommand}"/>
         </ListBox.InputBindings>
         <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
         <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
           <Setter Property="Foreground" Value="{DynamicResource Token.Ink}"/>
           <Setter Property="ToolTip" Value="{Binding Label}"/>
           <Setter Property="AutomationProperties.Name" Value="{Binding Label, StringFormat=Fase {0}}"/>
           <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Tab" Background="{DynamicResource Token.Surface}" BorderBrush="{DynamicResource Token.Border}" BorderThickness="1,0,1,1"
             CornerRadius="0,0,3,3" Padding="12,3,12,2" Margin="0,0,2,0" MinWidth="40" Cursor="Hand">
             <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
             <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource Token.Hover.Row}"/></Trigger>
             <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Token.Paper}"/>
              <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Token.Selection.Border}"/>
              <Setter TargetName="Tab" Property="BorderThickness" Value="1,0,1,3"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
             </Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate></Setter.Value></Setter>
          </Style>
         </ListBox.ItemContainerStyle>
         <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding [id]}"/></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
       </DockPanel>
       <TextBlock Grid.Row="3" Margin="0,4,8,0" TextWrapping="Wrap" FontSize="11"
        Text="{Binding Sketch.WaterLabel, StringFormat=Quote in scala; spessori\, puntoni e frecce schematici; tiranti in scala con i tratti di «Sfilamento dei tiranti»\, altrimenti tratteggiati. Blu tratteggiato: {0}; contorno tratteggiato: terreno scavato.}"/>
      </Grid>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
      <DockPanel Grid.Column="2" Margin="10,0,0,0">
       <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="{Binding InspectorTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding InspectorHint}" TextWrapping="Wrap" Margin="0,6,0,10"/>
        <TextBlock Text="Altri dati e verifiche" FontSize="11" Margin="0,0,0,3"/>
        <ComboBox ItemsSource="{Binding Tables}" SelectedItem="{Binding InspectorTable}" DisplayMemberPath="Title" Margin="0,0,0,10" AutomationProperties.Name="Dati da modificare"/>
       </StackPanel>
       <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
         <ContentControl Content="{Binding General}">
          <ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowGeneral}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ContentControl.Style>
         </ContentControl>
         <StackPanel DataContext="{Binding InspectorTable}">
          <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
          <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label" MaxHeight="125" Margin="0,0,0,6" AutomationProperties.Name="Elementi della tabella" Background="{DynamicResource Token.Paper}" Foreground="{DynamicResource Token.Ink}" BorderBrush="{DynamicResource Token.Border}">
           <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Token.Ink}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" Padding="6,4"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Token.Selection}"/></Trigger></Style.Triggers>
           </Style></ListBox.ItemContainerStyle>
          </ListBox>
          <WrapPanel Margin="0,0,0,8">
           <Button Content="Aggiungi" Command="{Binding AddCommand}" Margin="0,0,6,4"/>
           <Button Content="Rimuovi" Command="{Binding RemoveCommand}" Margin="0,0,6,4"/>
           <Button Content="↑" Command="{Binding UpCommand}" ToolTip="Sposta prima" Margin="0,0,6,4"/>
           <Button Content="↓" Command="{Binding DownCommand}" ToolTip="Sposta dopo" Margin="0,0,6,4"/>
          </WrapPanel>
          <ContentControl Content="{Binding Editor}"/>
         </StackPanel>
         <Button Content="Apri tutte le tabelle" Command="{Binding OpenDataCommand}" HorizontalAlignment="Left" Margin="0,12,0,8"/>
         <Expander Header="Importa stratigrafia del progetto" Margin="0,8">
          <StackPanel Margin="0,8">
           <Button Content="Aggiorna elenco dei terreni" Command="{Binding RefreshSoilSourcesCommand}" HorizontalAlignment="Left" Margin="0,0,0,6"/>
           <ComboBox ItemsSource="{Binding SoilSources}" SelectedItem="{Binding SelectedSoilSource}" DisplayMemberPath="Label"/>
           <WrapPanel Margin="0,8"><ComboBox ItemsSource="{Binding ImportSides}" SelectedItem="{Binding ImportSide}" Width="100"/>
            <ComboBox ItemsSource="{Binding ImportScenarios}" SelectedItem="{Binding ImportScenario}" Width="100" Margin="8,0"/>
            <Button Content="Importa terreno" Command="{Binding ImportSoilCommand}" Margin="0,4"/></WrapPanel>
           <TextBlock Text="Assegna K0 e kh con la fonte. La falda si definisce in ciascuna fase." TextWrapping="Wrap"/>
          </StackPanel>
         </Expander>
         <Expander Header="Convenzioni e ambito" Margin="0,8">
          <StackPanel Margin="0,8">
           <TextBlock Text="Quote positive verso l'alto. Le forze strutturali si riferiscono alla fascia; quelle dei sostegni al singolo elemento. Il disegno è una sezione del modello piano, non una ricostruzione tridimensionale." TextWrapping="Wrap" Margin="0,0,0,8"/>
           <TextBlock Text="Separare installazione e scavo in fasi diverse quando l'ordine influenza il risultato. Ogni fase elenca tutti i sostegni presenti: quelli omessi vengono rimossi." TextWrapping="Wrap" Margin="0,0,0,8"/>
           <TextBlock Text="Altri casi / combinazioni: definire storie indipendenti e assegnare caso a fasi, carichi e verifiche. Caso vuoto identifica il principale. Geometria e materiali sono condivisi; le azioni sono già combinate." TextWrapping="Wrap" Margin="0,0,0,8"/>
           <TextBlock Text="{Binding Scope}" TextWrapping="Wrap"/>
          </StackPanel>
         </Expander>
        </StackPanel>
       </ScrollViewer>
      </DockPanel>
     </Grid>
    </DockPanel>
   </TabItem>
   <TabItem Tag="tabelle" Header="{Binding Documents[tabelle]}" HeaderTemplate="{StaticResource DocumentHeader}" Visibility="{Binding Documents[tabelle].IsOpen, Converter={StaticResource Shown}}">
    <TabControl common:TabMemory.Key="tabelle" ItemsSource="{Binding Tables}" TabStripPlacement="Left" Margin="8">
     <TabControl.Template><ControlTemplate TargetType="TabControl">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
       </ScrollViewer>
       <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" Margin="8,0,0,0"/>
      </Grid>
     </ControlTemplate></TabControl.Template>
     <TabControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" Padding="8"/></DataTemplate></TabControl.ItemTemplate>
    </TabControl>
   </TabItem>
