       </DockPanel>
       <StackPanel Grid.Row="3" Margin="0,6,8,0">
        <TextBlock Text="Quote in scala · spessore parete, lunghezze sostegni e frecce schematici" TextWrapping="Wrap" FontSize="11"/>
        <TextBlock Text="{Binding Sketch.WaterLabel, StringFormat=Linea blu tratteggiata: {0}}" TextWrapping="Wrap" FontSize="11"/>
        <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding SketchStatus}" TextWrapping="Wrap" Margin="0,4" Foreground="{DynamicResource Token.Series.Orange}"/></ScrollViewer>
       </StackPanel>
      </Grid>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
      <DockPanel Grid.Column="2" Margin="10,0,0,0">
       <StackPanel DockPanel.Dock="Top">
