      <WrapPanel Margin="0,12"><Button Content="Cerca infissione" Command="{Binding SearchEmbedmentCommand}" Margin="0,0,8,8"/>
       <Button Content="Esporta ricerca CSV" Command="{Binding EmbedmentCsvCommand}" Margin="0,0,0,8"/></WrapPanel>
      <TextBlock Text="Il limite riguarda lo spostamento in testa. Il minimo sulla griglia vale solo per i criteri elencati: altre combinazioni e verifiche dell'opera restano da eseguire. Un candidato più corto non valutabile impedisce di dimostrare il minimo." TextWrapping="Wrap"/>
     </StackPanel></ScrollViewer>
     <Grid Grid.Column="1" Margin="20,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
