       <DataGrid.Columns><DataGridTextColumn Header="Infissione [m]" Binding="{Binding Embedment, Converter={StaticResource Number}, ConverterParameter=m}"/>
        <DataGridTextColumn Header="Piede [m]" Binding="{Binding ToeElevation, Converter={StaticResource Number}, ConverterParameter=m}"/>
        <DataGridTextColumn Header="Esito" Binding="{Binding OutcomeText}"/><DataGridTextColumn Header="Diagnostica" Binding="{Binding Diagnostic}"/></DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="2" Text="{Binding EmbedmentCandidateDiagnostic}" TextWrapping="Wrap" Margin="0,12"/>
      <DataGrid Grid.Row="3" ItemsSource="{Binding EmbedmentCriteria}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
       <DataGrid.Columns><DataGridTextColumn Header="Criterio" Binding="{Binding Label}"/><DataGridTextColumn Header="Fase" Binding="{Binding Stage}"/>
        <DataGridTextColumn Header="Domanda" SortMemberPath="Demand"><DataGridTextColumn.Binding><MultiBinding Converter="{StaticResource Number}"><Binding Path="Demand"/><Binding Path="Unit"/></MultiBinding></DataGridTextColumn.Binding></DataGridTextColumn><DataGridTextColumn Header="Limite" SortMemberPath="Limit"><DataGridTextColumn.Binding><MultiBinding Converter="{StaticResource Number}"><Binding Path="Limit"/><Binding Path="Unit"/></MultiBinding></DataGridTextColumn.Binding></DataGridTextColumn>
        <DataGridTextColumn Header="Unità" Binding="{Binding Unit}"/><DataGridTextColumn Header="Utilizzo" Binding="{Binding Ratio, Converter={StaticResource Number}, ConverterParameter=-}"/>
        <DataGridTextColumn Header="Esito" Binding="{Binding OutcomeText}"/><DataGridTextColumn Header="Metodo / fonte" Binding="{Binding Method}"/></DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Grid>
