        <DataGridTextColumn Header="N [kN]" Binding="{Binding Normal, Converter={StaticResource Number}, ConverterParameter=kN}"/><DataGridTextColumn Header="V [kN]" Binding="{Binding Shear, Converter={StaticResource Number}, ConverterParameter=kN}"/>
        <DataGridTextColumn Header="M [kNm]" Binding="{Binding Moment, Converter={StaticResource Number}, ConverterParameter=kNm}"/><DataGridTextColumn Header="p sx [kPa]" Binding="{Binding LeftPressure, Converter={StaticResource Number}, ConverterParameter=kPa}"/>
        <DataGridTextColumn Header="p dx [kPa]" Binding="{Binding RightPressure, Converter={StaticResource Number}, ConverterParameter=kPa}"/>
