       <Run Text=" · "/><Run Text="{Binding SelectedTubeCheck.Section}"/><Run Text=" · z="/><Run Text="{Binding SelectedTubeCheck.Elevation, Converter={StaticResource Number}, ConverterParameter=m}"/>
       <Run Text=" m, "/><Run Text="{Binding SelectedTubeCheck.Side}"/><Run Text=" · N="/><Run Text="{Binding SelectedTubeCheck.Normal, Converter={StaticResource Number}, ConverterParameter=kN}"/>
       <Run Text=" kN, V="/><Run Text="{Binding SelectedTubeCheck.Shear, Converter={StaticResource Number}, ConverterParameter=kN}"/><Run Text=" kN, M="/><Run Text="{Binding SelectedTubeCheck.Moment, Converter={StaticResource Number}, ConverterParameter=kNm}"/><Run Text=" kNm"/></TextBlock>
      <TextBlock Text="{Binding SelectedTubeCheck.Properties.Source}" TextWrapping="Wrap" Margin="0,8"/>
      <TextBlock Text="{Binding SelectedTubeCheck.Diagnostic}" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <WrapPanel><TextBlock Text="EI lordo della fascia [kNm²]: "/><TextBlock Text="{Binding SelectedTubeCheck.Properties.EquivalentRigidity, Converter={StaticResource Number}, ConverterParameter=kNm²}"/>
       <TextBlock Text="    D / t [mm]: "/><TextBlock Text="{Binding SelectedTubeCheck.Properties.Diameter, Converter={StaticResource Number}, ConverterParameter=mm}"/><TextBlock Text=" / "/><TextBlock Text="{Binding SelectedTubeCheck.Properties.Thickness, Converter={StaticResource Number}, ConverterParameter=mm}"/>
       <TextBlock Text="    interasse [m]: "/><TextBlock Text="{Binding SelectedTubeCheck.Properties.Spacing, Converter={StaticResource Number}, ConverterParameter=m}"/></WrapPanel>
      <DataGrid ItemsSource="{Binding SelectedTubeCheck.Checks}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="200" Margin="0,8">
       <DataGrid.Columns><DataGridTextColumn Header="Metodo" Binding="{Binding Method}"/><DataGridTextColumn Header="Domanda" SortMemberPath="Demand"><DataGridTextColumn.Binding><MultiBinding Converter="{StaticResource Number}"><Binding Path="Demand"/><Binding Path="Unit"/></MultiBinding></DataGridTextColumn.Binding></DataGridTextColumn>
        <DataGridTextColumn Header="Capacità" SortMemberPath="Capacity"><DataGridTextColumn.Binding><MultiBinding Converter="{StaticResource Number}"><Binding Path="Capacity"/><Binding Path="Unit"/></MultiBinding></DataGridTextColumn.Binding></DataGridTextColumn><DataGridTextColumn Header="Unità" Binding="{Binding Unit}"/>
        <DataGridTextColumn Header="Utilizzo" Binding="{Binding Ratio, Converter={StaticResource Number}, ConverterParameter=-}"/><DataGridTextColumn Header="Esito" Binding="{Binding OutcomeText}"/></DataGrid.Columns>
      </DataGrid>
      <ItemsControl ItemsSource="{Binding SelectedTubeCheck.Checks}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,5">
       <TextBlock Text="{Binding Reference}" TextWrapping="Wrap"/><TextBlock Text="{Binding Diagnostic}" TextWrapping="Wrap"/>
      </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></ScrollViewer>
    </Grid>
   </TabItem>
   <TabItem Tag="pali-ca" Header="{Binding Documents[pali-ca]}" HeaderTemplate="{StaticResource DocumentHeader}" Visibility="{Binding Documents[pali-ca].IsOpen, Converter={StaticResource Shown}}">
    <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="180"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Esporta CSV sezioni e dettagli" Command="{Binding RcPileCsvCommand}"/>
      <TextBlock Text="Azioni per singolo palo, N positivo a trazione. Resistenza/SLE e dettagli costruttivi hanno esiti separati." TextWrapping="Wrap"/>
     </DockPanel>
     <DataGrid Grid.Row="1" ItemsSource="{Binding RcPiles}" SelectedItem="{Binding SelectedRcPileCheck}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
      <DataGrid.Columns><DataGridTextColumn Header="Fase" Binding="{Binding Stage}"/><DataGridTextColumn Header="Sezione" Binding="{Binding Section}"/>
       <DataGridTextColumn Header="z [m]" Binding="{Binding Elevation, Converter={StaticResource Number}, ConverterParameter=m}"/><DataGridTextColumn Header="Lato" Binding="{Binding Side, Converter={StaticResource Term}, ConverterParameter=side}"/>
       <DataGridTextColumn Header="N [kN]" Binding="{Binding Normal, Converter={StaticResource Number}, ConverterParameter=kN}"/><DataGridTextColumn Header="V [kN]" Binding="{Binding Shear, Converter={StaticResource Number}, ConverterParameter=kN}"/>
       <DataGridTextColumn Header="M [kNm]" Binding="{Binding Moment, Converter={StaticResource Number}, ConverterParameter=kNm}"/><DataGridTextColumn Header="Fattore fascia→palo" Binding="{Binding StripToMemberFactor, Converter={StaticResource Number}, ConverterParameter=-}"/>
       <DataGridTextColumn Header="Esito locale" Binding="{Binding OutcomeText}"/></DataGrid.Columns>
     </DataGrid>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8,0,0">
      <TextBlock Text="{Binding SelectedRcPileCheck.Reference}" FontWeight="SemiBold"/>
      <TextBlock Margin="0,5" TextWrapping="Wrap"><Run Text="Taglio selezionato: "/><Run Text="{Binding SelectedRcPileCheck.Stage}"/><Run Text=" · "/><Run Text="{Binding SelectedRcPileCheck.Section}"/>
       <Run Text=" · z="/><Run Text="{Binding SelectedRcPileCheck.Elevation, Converter={StaticResource Number}, ConverterParameter=m}"/><Run Text=" m, "/><Run Text="{Binding SelectedRcPileCheck.Side}"/>
       <Run Text=" · N="/><Run Text="{Binding SelectedRcPileCheck.Normal, Converter={StaticResource Number}, ConverterParameter=kN}"/><Run Text=" kN; V="/><Run Text="{Binding SelectedRcPileCheck.Shear, Converter={StaticResource Number}, ConverterParameter=kN}"/>
       <Run Text=" kN; M="/><Run Text="{Binding SelectedRcPileCheck.Moment, Converter={StaticResource Number}, ConverterParameter=kNm}"/><Run Text=" kNm"/></TextBlock>
      <TextBlock Text="{Binding SelectedRcPileCheck.Diagnostic}" TextWrapping="Wrap" Margin="0,4"/>
      <TextBlock TextWrapping="Wrap" Margin="0,4"><Run Text="D [mm]: "/><Run Text="{Binding SelectedRcPileCheck.Properties.Diameter, Converter={StaticResource Number}, ConverterParameter=mm}"/>
       <Run Text="; barre: "/><Run Text="{Binding SelectedRcPileCheck.Properties.BarCount}"/><Run Text="φ"/><Run Text="{Binding SelectedRcPileCheck.Properties.BarDiameter, Converter={StaticResource Number}, ConverterParameter=mm}"/>
       <Run Text="; staffe φ"/><Run Text="{Binding SelectedRcPileCheck.Properties.LinkDiameter, Converter={StaticResource Number}, ConverterParameter=mm}"/><Run Text="/"/><Run Text="{Binding SelectedRcPileCheck.Properties.LinkSpacing, Converter={StaticResource Number}, ConverterParameter=mm}"/>
       <Run Text=" mm; EI lordo fascia [kNm²]: "/><Run Text="{Binding SelectedRcPileCheck.Properties.EquivalentRigidity, Converter={StaticResource Number}, ConverterParameter=kNm²}"/></TextBlock>
      <TextBlock TextWrapping="Wrap" Margin="0,4"><Run Text="Coefficienti SLU del profilo: γc="/><Run Text="{Binding SelectedRcPileCheck.Properties.GammaC, Converter={StaticResource Number}, ConverterParameter=-}"/>
       <Run Text="; γs="/><Run Text="{Binding SelectedRcPileCheck.Properties.GammaS, Converter={StaticResource Number}, ConverterParameter=-}"/><Run Text="; αcc="/><Run Text="{Binding SelectedRcPileCheck.Properties.AlphaCC, Converter={StaticResource Number}, ConverterParameter=-}"/></TextBlock>
      <DataGrid ItemsSource="{Binding SelectedRcPileCheck.Checks}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
       <DataGrid.Columns><DataGridTextColumn Header="Controllo" Binding="{Binding Method}"/><DataGridTextColumn Header="Domanda" SortMemberPath="Demand"><DataGridTextColumn.Binding><MultiBinding Converter="{StaticResource Number}"><Binding Path="Demand"/><Binding Path="Unit"/></MultiBinding></DataGridTextColumn.Binding></DataGridTextColumn>
        <DataGridTextColumn Header="Capacità" SortMemberPath="Capacity"><DataGridTextColumn.Binding><MultiBinding Converter="{StaticResource Number}"><Binding Path="Capacity"/><Binding Path="Unit"/></MultiBinding></DataGridTextColumn.Binding></DataGridTextColumn><DataGridTextColumn Header="Unità" Binding="{Binding Unit}"/>
        <DataGridTextColumn Header="Utilizzo" Binding="{Binding Ratio, Converter={StaticResource Number}, ConverterParameter=-}"/><DataGridTextColumn Header="Esito" Binding="{Binding OutcomeText}"/></DataGrid.Columns>
      </DataGrid>
      <ItemsControl ItemsSource="{Binding SelectedRcPileCheck.Checks}"><ItemsControl.ItemTemplate><DataTemplate>
       <TextBlock Text="{Binding Diagnostic}" TextWrapping="Wrap" Margin="0,4"/>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="Dettagli costruttivi — esiti separati" FontWeight="SemiBold" Margin="0,8"/>
      <DataGrid ItemsSource="{Binding SelectedRcPileCheck.Details}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
       <DataGrid.Columns><DataGridTextColumn Header="Regola" Binding="{Binding Label}"/><DataGridTextColumn Header="Valore" SortMemberPath="Actual"><DataGridTextColumn.Binding><MultiBinding Converter="{StaticResource Number}"><Binding Path="Actual"/><Binding Path="Unit"/></MultiBinding></DataGridTextColumn.Binding></DataGridTextColumn>
        <DataGridTextColumn Header="Limite" SortMemberPath="Limit"><DataGridTextColumn.Binding><MultiBinding Converter="{StaticResource Number}"><Binding Path="Limit"/><Binding Path="Unit"/></MultiBinding></DataGridTextColumn.Binding></DataGridTextColumn><DataGridTextColumn Header="Unità" Binding="{Binding Unit}"/>
        <DataGridTextColumn Header="Esito" Binding="{Binding OutcomeText}"/><DataGridTextColumn Header="Criterio" Binding="{Binding Diagnostic}"/></DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="{Binding SelectedRcPileCheck.Properties.Source}" TextWrapping="Wrap" Margin="0,8"/>
     </StackPanel></ScrollViewer>
    </Grid>
   </TabItem>
   <TabItem Tag="inviluppi" Header="{Binding Documents[inviluppi]}" HeaderTemplate="{StaticResource DocumentHeader}" Visibility="{Binding Documents[inviluppi].IsOpen, Converter={StaticResource Shown}}">
    <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel><Button DockPanel.Dock="Right" Content="Esporta CSV inviluppi" Command="{Binding EnvelopeCsvCommand}"/>
      <StackPanel Orientation="Horizontal"><TextBlock Text="Grandezza" VerticalAlignment="Center"/>
       <ComboBox ItemsSource="{Binding EnvelopeSeries}" SelectedItem="{Binding SelectedEnvelopeSeries}" DisplayMemberPath="Diagram" MinWidth="210" Margin="8,0"/>
      </StackPanel></DockPanel>
     <TextBlock Grid.Row="1" Text="{Binding EnvelopeStatus}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,4"/>
     <StackPanel Grid.Row="2"><TextBlock Text="{Binding EnvelopeExtrema}" TextWrapping="Wrap" Margin="0,0,0,4"/>
      <TextBlock Text="Selezionare una quota per leggere le azioni concomitanti. Minimo e massimo possono appartenere a fasi diverse; non formano una combinazione. La curva interpola le stazioni campionate, con estremi e discontinuità conservati." TextWrapping="Wrap" Margin="0,0,0,8"/>
     </StackPanel>
     <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <local:EmbeddedWallDiagram Points="{Binding EnvelopeMinimum}" Comparison="{Binding EnvelopeMaximum}" Quantity="{Binding SelectedEnvelopeSeries.Diagram, TargetNullValue='Spostamento [mm]'}" PrimaryLabel="minimo" ComparisonLabel="massimo"/>
      <Grid Grid.Column="1" Margin="10,0,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="210"/></Grid.RowDefinitions>
       <DataGrid ItemsSource="{Binding EnvelopeStations}" SelectedItem="{Binding SelectedEnvelopeStation}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
        <DataGrid.Columns><DataGridTextColumn Header="Quota [m]" Binding="{Binding Elevation, Converter={StaticResource Number}, ConverterParameter=m}"/><DataGridTextColumn Header="Lato" Binding="{Binding Side, Converter={StaticResource Term}, ConverterParameter=side}"/>
         <DataGridTextColumn Header="Minimo" SortMemberPath="Minimum.Value"><DataGridTextColumn.Binding><MultiBinding Converter="{StaticResource Number}"><Binding Path="Minimum.Value"/><Binding Path="DataContext.SelectedEnvelopeSeries.Unit" RelativeSource="{RelativeSource AncestorType=DataGrid}"/></MultiBinding></DataGridTextColumn.Binding></DataGridTextColumn><DataGridTextColumn Header="Caso min" Binding="{Binding Minimum.CaseId}"/>
         <DataGridTextColumn Header="Fase min" Binding="{Binding Minimum.Stage}"/><DataGridTextColumn Header="Massimo" SortMemberPath="Maximum.Value"><DataGridTextColumn.Binding><MultiBinding Converter="{StaticResource Number}"><Binding Path="Maximum.Value"/><Binding Path="DataContext.SelectedEnvelopeSeries.Unit" RelativeSource="{RelativeSource AncestorType=DataGrid}"/></MultiBinding></DataGridTextColumn.Binding></DataGridTextColumn>
         <DataGridTextColumn Header="Caso max" Binding="{Binding Maximum.CaseId}"/><DataGridTextColumn Header="Fase max" Binding="{Binding Maximum.Stage}"/></DataGrid.Columns>
       </DataGrid>
       <TextBlock Grid.Row="1" Text="Osservazioni concomitanti alla quota selezionata — azioni dell'intera fascia" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8"/>
       <DataGrid Grid.Row="2" ItemsSource="{Binding EnvelopeConcomitant}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
        <DataGrid.Columns><DataGridTextColumn Header="Estremo" Binding="{Binding Key}"/><DataGridTextColumn Header="Caso" Binding="{Binding Value.CaseId}"/>
         <DataGridTextColumn Header="Fase" Binding="{Binding Value.Stage}"/><DataGridTextColumn Header="Sezione" Binding="{Binding Value.Point.Section}"/>
         <DataGridTextColumn Header="N [kN]" Binding="{Binding Value.Point.Normal, Converter={StaticResource Number}, ConverterParameter=kN}"/><DataGridTextColumn Header="V [kN]" Binding="{Binding Value.Point.Shear, Converter={StaticResource Number}, ConverterParameter=kN}"/>
         <DataGridTextColumn Header="M [kNm]" Binding="{Binding Value.Point.Moment, Converter={StaticResource Number}, ConverterParameter=kNm}"/><DataGridTextColumn Header="u [mm]" Binding="{Binding Value.Point.Displacement, Converter={StaticResource Number}, ConverterParameter=mm}"/>
         <DataGridTextColumn Header="Rotazione [rad]" Binding="{Binding Value.Point.Rotation, Converter={StaticResource Number}, ConverterParameter=rad}"/></DataGrid.Columns>
       </DataGrid>
      </Grid>
     </Grid>
    </Grid>
   </TabItem>
  </TabControl>
  </DockPanel>
  </Grid>
 </DockPanel>
</UserControl>
