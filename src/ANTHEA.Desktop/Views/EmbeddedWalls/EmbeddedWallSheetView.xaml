            <ComboBox ItemsSource="{Binding ImportScenarios}" SelectedItem="{Binding ImportScenario}" Width="100" Margin="8,0"/>
            <Button Content="Importa terreno" Command="{Binding ImportSoilCommand}" Margin="0,4"/></WrapPanel>
           <TextBlock Text="Assegna K0 e kh con la fonte. La falda si definisce in ciascuna fase." TextWrapping="Wrap"/>
          </StackPanel>
         </Expander>
         <Expander Header="Convenzioni e ambito" Margin="0,8">
          <StackPanel Margin="0,8">
           <TextBlock Text="Quote positive verso l'alto. Le forze strutturali si riferiscono alla fascia; quelle dei sostegni al singolo elemento. Il disegno è una sezione del modello piano, non una ricostruzione tridimensionale." TextWrapping="Wrap" Margin="0,0,0,8"/>
           <TextBlock Text="Separare installazione e scavo in fasi diverse quando l'ordine influenza il risultato. Ogni fase elenca tutti i sostegni presenti: quelli omessi vengono rimossi." TextWrapping="Wrap" Margin="0,0,0,8"/>
           <TextBlock Text="Altri casi / combinazioni: definire storie indipendenti e assegnare caso a fasi, carichi e verifiche. Caso vuoto identifica il principale. Geometria e materiali sono condivisi; le azioni sono già combinate." TextWrapping="Wrap" Margin="0,0,0,8"/>
           <TextBlock Text="{Binding Scope}" TextWrapping="Wrap"/>
          </StackPanel>
         </Expander>
        </StackPanel>
       </ScrollViewer>
      </DockPanel>
