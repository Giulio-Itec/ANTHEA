    <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="Ricerca per tutti i casi assegnati" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock Text="Il modello deve descrivere tutta la parete più lunga. Si esplorano tutte le profondità della griglia, ricalcolando fasi, filtrazione e verifiche richieste. Quote positive verso l'alto; infissione positiva sotto il riferimento assegnato." TextWrapping="Wrap" Margin="0,0,0,12"/>
