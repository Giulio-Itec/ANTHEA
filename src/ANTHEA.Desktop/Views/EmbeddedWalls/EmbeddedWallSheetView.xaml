            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Token.Selection}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Token.Selection.Border}"/></Trigger>
           </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
         </Style></ListBox.ItemContainerStyle>
         <ListBox.ItemTemplate><DataTemplate>
          <TextBlock x:Name="Title" Text="{Binding Title}" TextWrapping="Wrap" FontSize="12" Margin="14,0,0,0"/>
          <DataTemplate.Triggers><DataTrigger Binding="{Binding IsCase}" Value="True">
