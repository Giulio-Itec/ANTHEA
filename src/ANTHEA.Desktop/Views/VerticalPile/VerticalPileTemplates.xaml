<!--
  Data templates of the vertical pile and micropile sheet (F5.6): MvvmSheetEditor finds the view of VerticalPileSheetViewModel here, and
  WpfDialogService the dialog of «Copia in…»/«Copia da…» (ChooseSurveyCopy of the historic view: the question, the choice, «Copia» and
  «Annulla», in a window of 430×210).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:X.Desktop.Views.VerticalPile"
 xmlns:pile="clr-namespace:Anthea.Presentation.Modules.VerticalPile;assembly=ANTHEA.Presentation">
 <DataTemplate DataType="{x:Type pile:VerticalPileSheetViewModel}"><views:VerticalPileSheetView/></DataTemplate>
 <DataTemplate DataType="{x:Type pile:SurveyCopyDialogViewModel}">
  <Border Width="414" Height="171" Background="{DynamicResource Token.Paper}" BorderBrush="{DynamicResource Token.Border}" BorderThickness="1" Padding="12">
   <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Question}" FontSize="{DynamicResource Font.Body}" Foreground="{DynamicResource Token.Ink}" TextWrapping="Wrap" VerticalAlignment="Center"/>
    <WrapPanel DockPanel.Dock="Bottom">
     <Button Content="Copia" IsDefault="True" Command="{Binding ConfirmCommand}" Background="{DynamicResource Token.Selected}" Foreground="{DynamicResource Token.OnCommandBar}"/>
     <Button Content="Annulla" IsCancel="True" Command="{Binding DismissCommand}" Background="{DynamicResource Token.Paper}" Foreground="{DynamicResource Token.Ink}"/>
    </WrapPanel>
    <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedItem="{Binding Selected}" Margin="8" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
 </DataTemplate>
</ResourceDictionary>
