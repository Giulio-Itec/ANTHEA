<!-- Data templates of the material sheets (F5.5): MvvmSheetEditor finds here the views of the concrete and of the reinforcing steel. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:X.Desktop.Views.Materials"
 xmlns:charts="clr-namespace:X.Desktop"
 xmlns:rheology="clr-namespace:Anthea.Presentation.Modules.Rheology;assembly=ANTHEA.Presentation"
 xmlns:materials="clr-namespace:Anthea.Presentation.Modules.Materials;assembly=ANTHEA.Presentation">
 <DataTemplate DataType="{x:Type materials:ConcreteMaterialSheetViewModel}"><views:ConcreteMaterialSheetView/></DataTemplate>
 <DataTemplate DataType="{x:Type materials:RebarMaterialSheetViewModel}"><views:RebarMaterialSheetView/></DataTemplate>
 <DataTemplate DataType="{x:Type rheology:RheologySheetViewModel}"><charts:ConcreteTimeEffectsView DataContext="{Binding Model}"/></DataTemplate>
</ResourceDictionary>
