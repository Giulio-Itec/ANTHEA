<!--
  View of the Bridge Design sheet (F5.12, decision Q3): BridgeDesignSheetViewModel shown with the layout of the historic view (BridgeDesignWorkspace
  inside SheetEditor). Two pages:
  - «Progetto»: title, subtitle and scope; the column of the inputs with its five tabs and, beside it (under it below 1100 of width), the card of the
    drawing with its buttons, the configuration and the exports; the four metrics; the tabs of the results (quantities, details with the moment
    diagram, comparison A / B, prices, assumptions, sections and dimensions); the alternatives; the status line;
  - «Ottimizzazione»: the choices of the search beside the preview of the solution, the charts of the explored variables and of the cloud with the
    legend of the typologies, the ranking with the reasons of exclusion.
  Every element of the inputs and of the panels has its own template (BridgeDesignResources.xaml, decision BD6): the parameters keep their raw text,
  their red border and their slider, not the compact FieldForm (D9). Colours and font sizes are theme tokens only (rule P7). The code-behind draws
  the bridge, the preview and the charts with the historic drawings (Q3), keeps the layout of the two widths, the locks and the limits of the search,
  prints «Stampa scheda» (BD8); every write into the document goes through the ViewModel.
  Read-only revision: parameters, choices, options, typologies and the commands that change the data are locked (the commands by their CanExecute);
  pages, tabs, «Prospetto», «Sezione», «Ottimizza», «Sezioni e quote», the exports, «Stampa scheda», «Interrompi», «Suggerisci campate», «Aggiorna
  elenco» and the selection of the solutions stay usable, as in the historic view; «Gestisci prezzario…» is locked (BD4).
-->
<UserControl x:Class="X.Desktop.Views.BridgeDesign.BridgeDesignSheetView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:X.Desktop"
 xmlns:views="clr-namespace:X.Desktop.Views.BridgeDesign"
 xmlns:bd="clr-namespace:Anthea.Presentation.Modules.BridgeDesign;assembly=ANTHEA.Presentation"
 xmlns:p="clr-namespace:Anthea.Application.Presentation;assembly=ANTHEA.Application"
 xmlns:model="clr-namespace:Anthea.Application.BridgeDesign;assembly=ANTHEA.Application"
 Background="{DynamicResource Token.Surface}">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="BridgeDesignResources.xaml"/></ResourceDictionary.MergedDictionaries>
   <!-- A bar of buttons (Ui.Bar): the buttons side by side, as wide as their caption. -->
   <DataTemplate x:Key="BarButton" DataType="{x:Type bd:BridgeDesignButton}">
    <Button Style="{StaticResource Command}" Content="{Binding Caption}" Command="{Binding Command}"/>
   </DataTemplate>
   <ItemsPanelTemplate x:Key="Bar"><WrapPanel/></ItemsPanelTemplate>
  </ResourceDictionary>
 </UserControl.Resources>

 <TabControl x:Name="Pages" SelectedIndex="{Binding Page}">
  <!-- ================================================================ «Progetto» -->
  <TabItem Style="{StaticResource Tab}" Header="Progetto">
   <ScrollViewer x:Name="DesignScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,16,20,12">
     <StackPanel Margin="2,0,0,10">
      <TextBlock Style="{StaticResource Title}" Text="{x:Static p:BridgeDesignPresentation.Title}"/>
      <TextBlock Style="{StaticResource T13Muted}" Text="{x:Static p:BridgeDesignPresentation.Subtitle}"/>
     </StackPanel>
     <TextBlock Style="{StaticResource T11BoldAccent}" Margin="2,0,0,12" Text="{x:Static p:BridgeDesignPresentation.ScopeLine}"/>
     <Grid x:Name="Upper">
      <Grid.ColumnDefinitions><ColumnDefinition Width="375"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <!-- The inputs: five tabs, each a scrolled panel of 490 at most. -->
      <Border x:Name="InputCard" Style="{StaticResource Paper}" Padding="10" Margin="0,0,12,0">
       <TabControl x:Name="InputTabs" MinHeight="470" SelectedIndex="{Binding InputTab}">
        <TabItem Style="{StaticResource Tab}" Header="{Binding Source={x:Static p:BridgeDesignPresentation.InputTabs}, Path=[0]}">
         <local:ChainedScrollViewer MaxHeight="490" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl Style="{StaticResource Items}" ItemsSource="{Binding Inputs[0]}"/>
         </local:ChainedScrollViewer>
        </TabItem>
        <TabItem Style="{StaticResource Tab}" Header="{Binding Source={x:Static p:BridgeDesignPresentation.InputTabs}, Path=[1]}">
         <local:ChainedScrollViewer MaxHeight="490" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl Style="{StaticResource Items}" Margin="4" ItemsSource="{Binding Inputs[1]}"/>
         </local:ChainedScrollViewer>
        </TabItem>
        <TabItem Style="{StaticResource Tab}" Header="{Binding Source={x:Static p:BridgeDesignPresentation.InputTabs}, Path=[2]}">
         <local:ChainedScrollViewer MaxHeight="490" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl Style="{StaticResource Items}" ItemsSource="{Binding Inputs[2]}"/>
         </local:ChainedScrollViewer>
        </TabItem>
        <TabItem Style="{StaticResource Tab}" Header="{Binding Source={x:Static p:BridgeDesignPresentation.InputTabs}, Path=[3]}">
         <local:ChainedScrollViewer MaxHeight="490" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl Style="{StaticResource Items}" ItemsSource="{Binding Inputs[3]}"/>
         </local:ChainedScrollViewer>
        </TabItem>
        <TabItem Style="{StaticResource Tab}" Header="{Binding Source={x:Static p:BridgeDesignPresentation.InputTabs}, Path=[4]}">
         <local:ChainedScrollViewer MaxHeight="490" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl Style="{StaticResource Items}" ItemsSource="{Binding Inputs[4]}"/>
         </local:ChainedScrollViewer>
        </TabItem>
       </TabControl>
      </Border>
      <!-- The drawing: the buttons, the drawing (400 high), the configuration, the exports. -->
      <Border x:Name="DrawingCard" Grid.Column="1" Style="{StaticResource Paper}">
       <StackPanel>
        <WrapPanel x:Name="DrawingButtons">
         <Button Style="{StaticResource Command}" Content="Prospetto" Command="{Binding ElevationCommand}"/>
         <Button Style="{StaticResource Command}" Content="Sezione" Command="{Binding SectionCommand}"/>
         <Button Style="{StaticResource Command}" Content="Nuovo paesaggio" Command="{Binding NewSceneCommand}"/>
         <Button x:Name="RandomButton" Style="{StaticResource Command}" Content="Ponte casuale" Command="{Binding RandomCommand}"/>
         <Button Style="{StaticResource Command}" Content="Ottimizza" Command="{Binding OptimizeCommand}"/>
         <Button Style="{StaticResource Command}" Content="Fissa A" Command="{Binding PinCommand}"/>
         <Button Style="{StaticResource Command}" Content="Annulla" Command="{Binding UndoCommand}"/>
         <Button Style="{StaticResource Command}" Content="Sezioni e quote" Command="{Binding DimensionsCommand}" Click="ShowOutputs_Click"/>
        </WrapPanel>
        <ContentControl x:Name="DrawingHost" Focusable="False" IsTabStop="False" Height="400" MinWidth="300"/>
        <TextBlock x:Name="ConfigurationText" Style="{StaticResource T12Muted}" Text="{Binding Configuration}"/>
        <WrapPanel>
         <Button Style="{StaticResource Command}" Content="Esporta quantità CSV" Command="{Binding ExportCsvCommand}"/>
         <Button Style="{StaticResource Command}" Content="Immagine PNG" Command="{Binding ExportPngCommand}"/>
         <Button x:Name="PrintButton" Style="{StaticResource Command}" Content="Stampa scheda" Click="Print_Click"/>
        </WrapPanel>
       </StackPanel>
      </Border>
     </Grid>
     <!-- The four metrics: title 10, value 26, caption 11. -->
     <UniformGrid x:Name="MetricsGrid" Columns="4" Margin="0,12,0,12">
      <Border Style="{StaticResource Paper}" Padding="14" Margin="0,0,6,0">
       <StackPanel>
        <TextBlock Style="{StaticResource T11BoldMuted}" Text="{Binding Metrics[0].Label}"/>
        <TextBlock x:Name="MetricValue0" Style="{StaticResource Title}" Text="{Binding Metrics[0].Value}"/>
        <TextBlock x:Name="MetricCaption0" Style="{StaticResource T11Muted}" Text="{Binding Metrics[0].Caption}"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Paper}" Padding="14" Margin="6,0,6,0">
       <StackPanel>
        <TextBlock Style="{StaticResource T11BoldMuted}" Text="{Binding Metrics[1].Label}"/>
        <TextBlock x:Name="MetricValue1" Style="{StaticResource Title}" Text="{Binding Metrics[1].Value}"/>
        <TextBlock x:Name="MetricCaption1" Style="{StaticResource T11Muted}" Text="{Binding Metrics[1].Caption}"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Paper}" Padding="14" Margin="6,0,6,0">
       <StackPanel>
        <TextBlock Style="{StaticResource T11BoldMuted}" Text="{Binding Metrics[2].Label}"/>
        <TextBlock x:Name="MetricValue2" Style="{StaticResource Title}" Text="{Binding Metrics[2].Value}"/>
        <TextBlock x:Name="MetricCaption2" Style="{StaticResource T11Muted}" Text="{Binding Metrics[2].Caption}"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Paper}" Padding="14" Margin="6,0,0,0">
       <StackPanel>
        <TextBlock Style="{StaticResource T11BoldMuted}" Text="{Binding Metrics[3].Label}"/>
        <TextBlock x:Name="MetricValue3" Style="{StaticResource Title}" Text="{Binding Metrics[3].Value}"/>
        <TextBlock x:Name="MetricCaption3" Style="{StaticResource T11Muted}" Text="{Binding Metrics[3].Caption}"/>
       </StackPanel>
      </Border>
     </UniformGrid>
     <!-- The results. -->
     <Border x:Name="OutputCard" Style="{StaticResource Paper}">
      <TabControl x:Name="OutputTabs" MinHeight="330" SelectedIndex="{Binding OutputTab}">
       <TabItem Style="{StaticResource Tab}" Header="{Binding Source={x:Static p:BridgeDesignPresentation.OutputTabs}, Path=[0]}">
        <ItemsControl Style="{StaticResource Items}" ItemsSource="{Binding Quantities}"/>
       </TabItem>
       <TabItem Style="{StaticResource Tab}" Header="{Binding Source={x:Static p:BridgeDesignPresentation.OutputTabs}, Path=[1]}">
        <local:ChainedScrollViewer MaxHeight="365" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <ItemsControl Style="{StaticResource Items}" ItemsSource="{Binding Details}"/>
        </local:ChainedScrollViewer>
       </TabItem>
       <TabItem Style="{StaticResource Tab}" Header="{Binding Source={x:Static p:BridgeDesignPresentation.OutputTabs}, Path=[2]}">
        <StackPanel>
         <ItemsControl Style="{StaticResource Items}" ItemsSource="{Binding Comparison, Converter={StaticResource Kind}, ConverterParameter=others}"/>
         <ItemsControl Style="{StaticResource Items}" ItemsSource="{Binding Comparison, Converter={StaticResource Kind}, ConverterParameter=buttons}"
          ItemsPanel="{StaticResource Bar}" ItemTemplate="{StaticResource BarButton}"/>
        </StackPanel>
       </TabItem>
       <TabItem Style="{StaticResource Tab}" Header="{Binding Source={x:Static p:BridgeDesignPresentation.OutputTabs}, Path=[3]}">
        <StackPanel>
         <ItemsControl Style="{StaticResource Items}" ItemsSource="{Binding Prices, Converter={StaticResource Kind}, ConverterParameter=first}"/>
         <local:ChainedScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl Style="{StaticResource Items}" Margin="4" ItemsSource="{Binding Prices, Converter={StaticResource Kind}, ConverterParameter=rest}"/>
         </local:ChainedScrollViewer>
        </StackPanel>
       </TabItem>
       <TabItem Style="{StaticResource Tab}" Header="{Binding Source={x:Static p:BridgeDesignPresentation.OutputTabs}, Path=[4]}">
        <local:ChainedScrollViewer MaxHeight="365" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <ItemsControl Style="{StaticResource Items}" Margin="4" ItemsSource="{Binding Assumptions}"/>
        </local:ChainedScrollViewer>
       </TabItem>
       <TabItem Style="{StaticResource Tab}" Header="{Binding Source={x:Static p:BridgeDesignPresentation.OutputTabs}, Path=[5]}">
        <local:ChainedScrollViewer MaxHeight="500" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <StackPanel>
          <ItemsControl Style="{StaticResource Items}" ItemsSource="{Binding Technical, Converter={StaticResource Kind}, ConverterParameter=others}"/>
          <ItemsControl Style="{StaticResource Items}" ItemsSource="{Binding Technical, Converter={StaticResource Kind}, ConverterParameter=buttons}"
           ItemsPanel="{StaticResource Bar}" ItemTemplate="{StaticResource BarButton}"/>
         </StackPanel>
        </local:ChainedScrollViewer>
       </TabItem>
      </TabControl>
     </Border>
     <!-- «Alternative per ridurre le quantità e le emissioni», with a result. -->
     <ItemsControl x:Name="AdvicePanel" Style="{StaticResource Items}" Margin="0,14,0,0" ItemsSource="{Binding Advice}"
      Visibility="{Binding Advice, Converter={StaticResource Present}}">
      <ItemsControl.Resources>
       <!-- The buttons of the alternatives: the caption on the left (the restore of the environmental factors centred, as the historic button). -->
       <DataTemplate DataType="{x:Type bd:BridgeDesignButton}">
        <Button x:Name="Advice" Style="{StaticResource Command}" HorizontalContentAlignment="Left" Content="{Binding Caption}" Command="{Binding Command}"/>
        <DataTemplate.Triggers>
         <DataTrigger Binding="{Binding Caption}" Value="{x:Static p:BridgeDesignPresentation.RestoreEnvironmentButton}"><Setter TargetName="Advice" Property="HorizontalContentAlignment" Value="Center"/></DataTrigger>
        </DataTemplate.Triggers>
       </DataTemplate>
      </ItemsControl.Resources>
     </ItemsControl>
     <TextBlock x:Name="StatusText" Margin="4,10,4,6" Text="{Binding Status}">
      <TextBlock.Style>
       <Style TargetType="TextBlock" BasedOn="{StaticResource T12Muted}">
        <Style.Triggers><DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Token.Status.Fail}"/></DataTrigger></Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
    </StackPanel>
   </ScrollViewer>
  </TabItem>

  <!-- ================================================================ «Ottimizzazione» -->
  <TabItem Style="{StaticResource Tab}" Header="Ottimizzazione">
   <local:ChainedScrollViewer x:Name="OptimizationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,16,20,20">
     <TextBlock Style="{StaticResource Title}" Text="{x:Static p:BridgeDesignOptimizationPresentation.Title}"/>
     <TextBlock Style="{StaticResource T12Muted}" Text="La preview segue il migliore provvisorio, al massimo due volte al secondo. Il progetto cambia solo con Applica."/>
     <Grid x:Name="SearchUpper">
      <Grid.ColumnDefinitions><ColumnDefinition Width="335"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <!-- 1 · the choices of the search. -->
      <Border x:Name="SetupCard" Style="{StaticResource Paper}" Margin="0,0,12,12">
       <StackPanel>
        <TextBlock Style="{StaticResource Heading}" Text="1 · Imposta la ricerca"/>
        <TextBlock Style="{StaticResource T12Bold}" Text="Obiettivo"/>
        <ComboBox x:Name="ObjectiveChoice" Style="{StaticResource Choice}" ItemsSource="{x:Static p:BridgeDesignOptimizationPresentation.Objectives}"
         SelectedIndex="{Binding Objective}" IsEnabled="{Binding CanEdit}"/>
        <TextBlock Style="{StaticResource T13Bold}" Text="Mantieni costante"/>
        <StackPanel x:Name="LockPanel">
         <CheckBox Tag="family" Content="Tipologia" Margin="4,5,4,5" Foreground="{DynamicResource Token.Ink}" IsChecked="{Binding Locks[family], Mode=OneWay}" IsEnabled="{Binding CanEdit}" Checked="Lock_Changed" Unchecked="Lock_Changed"/>
         <CheckBox Tag="spans" Content="Numero campate" Margin="4,5,4,5" Foreground="{DynamicResource Token.Ink}" IsChecked="{Binding Locks[spans], Mode=OneWay}" IsEnabled="{Binding CanEdit}" Checked="Lock_Changed" Unchecked="Lock_Changed"/>
         <CheckBox Tag="depth" Content="Altezza in campata" Margin="4,5,4,5" Foreground="{DynamicResource Token.Ink}" IsChecked="{Binding Locks[depth], Mode=OneWay}" IsEnabled="{Binding CanEdit}" Checked="Lock_Changed" Unchecked="Lock_Changed"/>
         <CheckBox Tag="section" Content="Dimensioni della sezione" Margin="4,5,4,5" Foreground="{DynamicResource Token.Ink}" IsChecked="{Binding Locks[section], Mode=OneWay}" IsEnabled="{Binding CanEdit}" Checked="Lock_Changed" Unchecked="Lock_Changed"/>
         <CheckBox Tag="continuous" Content="Continuità" Margin="4,5,4,5" Foreground="{DynamicResource Token.Ink}" IsChecked="{Binding Locks[continuous], Mode=OneWay}" IsEnabled="{Binding CanEdit}" Checked="Lock_Changed" Unchecked="Lock_Changed"/>
         <CheckBox Tag="pier" Content="Schema pila e quote imposte" Margin="4,5,4,5" Foreground="{DynamicResource Token.Ink}" IsChecked="{Binding Locks[pier], Mode=OneWay}" IsEnabled="{Binding CanEdit}" Checked="Lock_Changed" Unchecked="Lock_Changed"/>
         <CheckBox Tag="foundation" Content="Fondazione e lunghezza pali" Margin="4,5,4,5" Foreground="{DynamicResource Token.Ink}" IsChecked="{Binding Locks[foundation], Mode=OneWay}" IsEnabled="{Binding CanEdit}" Checked="Lock_Changed" Unchecked="Lock_Changed"/>
        </StackPanel>
        <TextBlock Style="{StaticResource T13Bold}" Text="Intervalli · minimo / massimo"/>
        <WrapPanel>
         <TextBlock Style="{StaticResource T12}" Text="Campate [n.]"/>
         <TextBox Tag="campate-min" Style="{StaticResource SearchEdit}" Text="{Binding Limits[campate-min], Mode=OneWay}" IsReadOnly="{Binding CanEdit, Converter={StaticResource Not}}" TextChanged="Limit_Changed" LostKeyboardFocus="Limit_Left"/>
         <TextBox Tag="campate-max" Style="{StaticResource SearchEdit}" Text="{Binding Limits[campate-max], Mode=OneWay}" IsReadOnly="{Binding CanEdit, Converter={StaticResource Not}}" TextChanged="Limit_Changed" LostKeyboardFocus="Limit_Left"/>
        </WrapPanel>
        <Button Style="{StaticResource Command}" Content="Suggerisci campate dalla lunghezza" Command="{Binding SuggestSpansCommand}"/>
        <WrapPanel>
         <TextBlock Style="{StaticResource T12}" Text="Altezza [m]"/>
         <TextBox Tag="altezza-min" Style="{StaticResource SearchEdit}" Text="{Binding Limits[altezza-min], Mode=OneWay}" IsReadOnly="{Binding CanEdit, Converter={StaticResource Not}}" TextChanged="Limit_Changed" LostKeyboardFocus="Limit_Left"/>
         <TextBox Tag="altezza-max" Style="{StaticResource SearchEdit}" Text="{Binding Limits[altezza-max], Mode=OneWay}" IsReadOnly="{Binding CanEdit, Converter={StaticResource Not}}" TextChanged="Limit_Changed" LostKeyboardFocus="Limit_Left"/>
        </WrapPanel>
        <TextBlock Style="{StaticResource T11Muted}" Text="0 = nessun limite. Minimo in campata; massimo anche sulle pile."/>
        <TextBlock Style="{StaticResource T13Bold}" Text="Griglie · minimo / massimo / passo [%]"/>
        <TextBlock Style="{StaticResource T12}" Text="Altezza rispetto al predimensionamento"/>
        <WrapPanel>
         <TextBox Tag="altezza-da" Style="{StaticResource SearchEdit}" Text="{Binding Limits[altezza-da], Mode=OneWay}" IsEnabled="{Binding DepthGridEnabled}" IsReadOnly="{Binding CanEdit, Converter={StaticResource Not}}" TextChanged="Limit_Changed" LostKeyboardFocus="Limit_Left"/>
         <TextBox Tag="altezza-a" Style="{StaticResource SearchEdit}" Text="{Binding Limits[altezza-a], Mode=OneWay}" IsEnabled="{Binding DepthGridEnabled}" IsReadOnly="{Binding CanEdit, Converter={StaticResource Not}}" TextChanged="Limit_Changed" LostKeyboardFocus="Limit_Left"/>
         <TextBox Tag="altezza-passo" Style="{StaticResource SearchEdit}" Text="{Binding Limits[altezza-passo], Mode=OneWay}" IsEnabled="{Binding DepthGridEnabled}" IsReadOnly="{Binding CanEdit, Converter={StaticResource Not}}" TextChanged="Limit_Changed" LostKeyboardFocus="Limit_Left"/>
        </WrapPanel>
        <TextBlock Style="{StaticResource T12}" Text="Lunghezza pali rispetto alla classe di terreno"/>
        <WrapPanel>
         <TextBox Tag="pali-da" Style="{StaticResource SearchEdit}" Text="{Binding Limits[pali-da], Mode=OneWay}" IsEnabled="{Binding PileGridEnabled}" IsReadOnly="{Binding CanEdit, Converter={StaticResource Not}}" TextChanged="Limit_Changed" LostKeyboardFocus="Limit_Left"/>
         <TextBox Tag="pali-a" Style="{StaticResource SearchEdit}" Text="{Binding Limits[pali-a], Mode=OneWay}" IsEnabled="{Binding PileGridEnabled}" IsReadOnly="{Binding CanEdit, Converter={StaticResource Not}}" TextChanged="Limit_Changed" LostKeyboardFocus="Limit_Left"/>
         <TextBox Tag="pali-passo" Style="{StaticResource SearchEdit}" Text="{Binding Limits[pali-passo], Mode=OneWay}" IsEnabled="{Binding PileGridEnabled}" IsReadOnly="{Binding CanEdit, Converter={StaticResource Not}}" TextChanged="Limit_Changed" LostKeyboardFocus="Limit_Left"/>
        </WrapPanel>
        <TextBlock Style="{StaticResource T11Muted}" Text="100–200%; massimo 11 valori per griglia. Spessori e interassi liberi seguono lo standard della tipologia."/>
        <WrapPanel>
         <Button x:Name="RunButton" Style="{StaticResource Primary}" Content="Avvia ottimizzazione" Command="{Binding RunOptimizationCommand}"/>
         <Button Style="{StaticResource Command}" Content="Interrompi" Command="{Binding StopOptimizationCommand}"/>
        </WrapPanel>
        <Expander Header="Costanti e significato dei blocchi" Foreground="{DynamicResource Token.Ink}">
         <TextBlock Style="{StaticResource T12}" Text="Sito, lunghezza, larghezza, materiali, carichi e prezzi restano quelli del progetto. Altezza e sezione bloccate usano le quote adottate. Per pile e fondazioni, le quote imposte restano fisse; quelle a 0 restano automatiche. La configurazione corrente viene sempre confrontata, anche se esterna alle griglie percentuali, purché soddisfi i filtri."/>
        </Expander>
       </StackPanel>
      </Border>
      <!-- The preview of the best solution or of the solution selected. -->
      <Border x:Name="PreviewCard" Grid.Column="1" Style="{StaticResource Paper}" Margin="0,0,0,12">
       <StackPanel>
        <TextBlock x:Name="BestText" Style="{StaticResource T13Bold}" Text="{Binding SearchBest}"/>
        <ProgressBar x:Name="SearchProgress" Height="5" Margin="0,8,0,8" Maximum="{Binding ProgressMaximum}" Value="{Binding Progress, Mode=OneWay}"/>
        <TextBlock x:Name="SearchStatusText" Style="{StaticResource T12Muted}" Text="{Binding SearchStatus}"/>
        <TextBlock x:Name="SelectionText" Style="{StaticResource Heading}" Text="{Binding SearchSelection}"/>
        <WrapPanel>
         <Button Style="{StaticResource Command}" Content="Prospetto" Command="{Binding SolutionElevationCommand}"/>
         <Button Style="{StaticResource Command}" Content="Sezione" Command="{Binding SolutionSectionCommand}"/>
         <Button x:Name="ApplyButton" Style="{StaticResource Primary}" Content="Applica soluzione selezionata" Command="{Binding ApplySolutionCommand}" Click="ShowOutputs_Click"/>
        </WrapPanel>
        <ContentControl x:Name="PreviewHost" Focusable="False" IsTabStop="False" Height="265"/>
        <ItemsControl Style="{StaticResource Items}" ItemsSource="{Binding SearchChanges}"/>
       </StackPanel>
      </Border>
     </Grid>
     <Grid x:Name="Charts">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <!-- 2 · the explored variables. -->
      <Border x:Name="TraceCard" Style="{StaticResource Paper}" Margin="0,0,12,12">
       <StackPanel>
        <TextBlock Style="{StaticResource Heading}" Text="2 · Variabili esplorate"/>
        <ComboBox x:Name="VariableChoice" Style="{StaticResource Choice}" ItemsSource="{x:Static p:BridgeDesignOptimizationPresentation.Variables}"
         SelectedIndex="{Binding Variable}" IsEnabled="{Binding CanEdit}"/>
        <ContentControl x:Name="TraceHost" Focusable="False" IsTabStop="False" Height="310"/>
        <TextBlock Style="{StaticResource T11Muted}" Text="Ogni punto è un tentativo calcolato. Grigio = escluso. Nei grafici costo e CO₂ la linea scura è il minimo progressivo. Le quote non calcolabili sono omesse."/>
       </StackPanel>
      </Border>
      <!-- 3 · the cloud of the solutions. -->
      <Border x:Name="CloudCard" Grid.Column="1" Style="{StaticResource Paper}" Margin="0,0,0,12">
       <StackPanel>
        <TextBlock Style="{StaticResource Heading}" Text="3 · Famiglia di soluzioni plausibili"/>
        <WrapPanel>
         <ComboBox x:Name="FilterChoice" Style="{StaticResource Choice}" ItemsSource="{x:Static views:BridgeDesignSheetView.FilterItems}"
          SelectedIndex="{Binding FamilyFilter, Converter={StaticResource FamilyFilter}}" IsEnabled="{Binding CanEdit}"/>
         <CheckBox x:Name="ParetoBox" Content="Solo frontiera Pareto" Margin="5" Foreground="{DynamicResource Token.Ink}" IsChecked="{Binding ParetoOnly}" IsEnabled="{Binding CanEdit}"/>
        </WrapPanel>
        <ContentControl x:Name="CloudHost" Focusable="False" IsTabStop="False" Height="310"/>
        <TextBlock Style="{StaticResource T11Muted}" Text="In basso a sinistra: meno costo e CO₂. Anello = Pareto; stella = ottimo; croce = progetto corrente. Clicca un punto per esaminarlo, anche fuori dalle prime N."/>
       </StackPanel>
      </Border>
     </Grid>
     <!-- The legend of the typologies, in the colours of the charts. -->
     <ItemsControl x:Name="Legend" Style="{StaticResource Items}" ItemsSource="{x:Static model:BridgeDesignModel.Families}" ItemsPanel="{StaticResource Bar}">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <TextBlock Style="{StaticResource T11}" Foreground="{Binding Id, Converter={StaticResource LegendBrush}}">
         <Run Text="● "/><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="   "/>
        </TextBlock>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock Style="{StaticResource Heading}" Text="4 · Alternative ordinate per l’obiettivo scelto"/>
     <WrapPanel>
      <TextBlock Style="{StaticResource T12Bold}" Text="Mostra le prime N"/>
      <TextBox x:Name="TopBox" Tag="prime" Style="{StaticResource SearchEdit}" Text="{Binding Limits[prime], Mode=OneWay}" IsReadOnly="{Binding CanEdit, Converter={StaticResource Not}}"
       TextChanged="Limit_Changed" LostKeyboardFocus="Limit_Left"/>
      <Button Style="{StaticResource Command}" Content="Aggiorna elenco" Command="{Binding RefreshRankingCommand}"/>
     </WrapPanel>
     <ItemsControl x:Name="SearchResultsPanel" Style="{StaticResource Items}" ItemsSource="{Binding SearchResults}"/>
     <TextBlock Style="{StaticResource T11Muted}" Text="Pareto: nessun’altra soluzione esplorata migliora costo o CO₂ senza peggiorare l’altro indicatore. Compromesso: 0,5 C/Cmin + 0,5 CO₂/CO₂min."/>
     <TextBlock Style="{StaticResource T12Bold}" Text="{x:Static views:BridgeDesignSheetView.SearchScope}"/>
    </StackPanel>
   </local:ChainedScrollViewer>
  </TabItem>
 </TabControl>
</UserControl>
