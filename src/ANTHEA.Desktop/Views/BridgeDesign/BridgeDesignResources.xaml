<!--
  Resources of the views of Bridge Design (F5.12), merged by BridgeDesignSheetView and by the price editor (PriceCatalogueView): the texts of
  Ui.Text in their sizes (10 and 11 → Font.Caption, 12 → Font.Small, 13 → Font.Body, 14 → Font.Subheading, 15 and 17 → Font.Heading, 21, 24 and 26
  → Font.Title, decision D8), Ui.Paper with the border of the cards (D12), the light and the primary buttons (S17), and one template for each
  element of the sheet (decision BD6): the texts by their role, the tables, the buttons, the groups, the moment diagram, the parameters with their
  slider, the choices, the options and the buttons of the typologies with their icons. The templates are implicit (by type), found from the item:
  no selector and no static state (rule P3). Theme tokens only (rule P7); the drawings keep their colours (Q3).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:common="clr-namespace:X.Desktop.Views.Common"
 xmlns:views="clr-namespace:X.Desktop.Views.BridgeDesign"
 xmlns:bd="clr-namespace:Anthea.Presentation.Modules.BridgeDesign;assembly=ANTHEA.Presentation">
 <common:NegationConverter x:Key="Not"/>
 <BooleanToVisibilityConverter x:Key="Visible"/>
 <views:PresentShownConverter x:Key="Present"/>
 <views:TextSizeConverter x:Key="Size"/>
 <views:ItemsOfKindConverter x:Key="Kind"/>
 <views:FamilyFilterConverter x:Key="FamilyFilter"/>
 <views:FamilyLegendBrushConverter x:Key="LegendBrush"/>

 <!-- Texts: Ui.Text of the historic view (wrapping, vertically centred, ink). -->
 <Style x:Key="T13" TargetType="TextBlock">
  <Setter Property="FontSize" Value="{DynamicResource Font.Body}"/>
  <Setter Property="Foreground" Value="{DynamicResource Token.Ink}"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
 </Style>
 <Style x:Key="T13Bold" TargetType="TextBlock" BasedOn="{StaticResource T13}">
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <Style x:Key="T13Muted" TargetType="TextBlock" BasedOn="{StaticResource T13}">
  <Setter Property="Foreground" Value="{DynamicResource Token.Muted}"/>
 </Style>
 <Style x:Key="T12" TargetType="TextBlock" BasedOn="{StaticResource T13}">
  <Setter Property="FontSize" Value="{DynamicResource Font.Small}"/>
 </Style>
 <Style x:Key="T12Bold" TargetType="TextBlock" BasedOn="{StaticResource T12}">
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <Style x:Key="T12Muted" TargetType="TextBlock" BasedOn="{StaticResource T12}">
  <Setter Property="Foreground" Value="{DynamicResource Token.Muted}"/>
 </Style>
 <Style x:Key="T11" TargetType="TextBlock" BasedOn="{StaticResource T13}">
  <Setter Property="FontSize" Value="{DynamicResource Font.Caption}"/>
 </Style>
 <Style x:Key="T11Muted" TargetType="TextBlock" BasedOn="{StaticResource T11}">
  <Setter Property="Foreground" Value="{DynamicResource Token.Muted}"/>
 </Style>
 <Style x:Key="T11BoldMuted" TargetType="TextBlock" BasedOn="{StaticResource T11Muted}">
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <!-- The scope line under the title (11, bold, Ui.Blue). -->
 <Style x:Key="T11BoldAccent" TargetType="TextBlock" BasedOn="{StaticResource T11}">
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{DynamicResource Token.Accent}"/>
 </Style>
 <Style x:Key="T14" TargetType="TextBlock" BasedOn="{StaticResource T13}">
  <Setter Property="FontSize" Value="{DynamicResource Font.Subheading}"/>
 </Style>
 <!-- The headings of the panels and of the cards (15 and 17, bold). -->
 <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource T13}">
  <Setter Property="FontSize" Value="{DynamicResource Font.Heading}"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <!-- The titles of the pages and of the price editor (24, 21) and the values of the metrics (26), bold. -->
 <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource T13}">
  <Setter Property="FontSize" Value="{DynamicResource Font.Title}"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>

 <!-- Ui.Paper: paper, the border of the cards (D12), padding 12 unless said. -->
 <Style x:Key="Paper" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource Token.Paper}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Token.Border}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="12"/>
 </Style>
 <!-- Ui.Tab: the tabs on paper. -->
 <Style x:Key="Tab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
  <Setter Property="Background" Value="{DynamicResource Token.Paper}"/>
 </Style>
 <!-- Ui.Button: a light button with the implicit style of the theme (padding, margin, height), S17. -->
 <Style x:Key="Command" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource Token.Paper}"/>
  <Setter Property="Foreground" Value="{DynamicResource Token.Ink}"/>
 </Style>
 <!-- Ui.Button(primary: true) and the typology chosen (Ui.SetSelected). -->
 <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource Token.Selected}"/>
  <Setter Property="Foreground" Value="{DynamicResource Token.OnCommandBar}"/>
 </Style>
 <!-- The edit boxes of the search (SearchEdit: 58 wide, margin 3). -->
 <Style x:Key="SearchEdit" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
  <Setter Property="Width" Value="58"/>
  <Setter Property="Margin" Value="3"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
 </Style>
 <!-- Ui.Choice: a combo box with a margin of 2, the wheel to the page while it is closed. -->
 <Style x:Key="Choice" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
  <Setter Property="Margin" Value="2"/>
  <Setter Property="views:BridgeDesignWheel.Forward" Value="True"/>
 </Style>
 <Style x:Key="Items" TargetType="ItemsControl">
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="IsTabStop" Value="False"/>
 </Style>

 <!-- ================================================================ one template for each element (BD6) -->

 <!-- A text by its role: body 12 (13 and 14 for the placeholders), title 15 and 17 bold, highlight 12–14 bold, note 11 or 12 muted, warning 12 in
      the colour of the notes, error 13 in the colour of a failure. -->
 <DataTemplate DataType="{x:Type bd:BridgeDesignText}">
  <TextBlock x:Name="Text" Style="{StaticResource T12}" Text="{Binding Text}"/>
  <DataTemplate.Triggers>
   <DataTrigger Binding="{Binding Role}" Value="Title"><Setter TargetName="Text" Property="FontSize" Value="{DynamicResource Font.Heading}"/><Setter TargetName="Text" Property="FontWeight" Value="SemiBold"/></DataTrigger>
   <DataTrigger Binding="{Binding Role}" Value="Highlight"><Setter TargetName="Text" Property="FontSize" Value="{DynamicResource Font.Body}"/><Setter TargetName="Text" Property="FontWeight" Value="SemiBold"/></DataTrigger>
   <DataTrigger Binding="{Binding Role}" Value="Note"><Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Token.Muted}"/></DataTrigger>
   <DataTrigger Binding="{Binding Converter={StaticResource Size}}" Value="Caption"><Setter TargetName="Text" Property="FontSize" Value="{DynamicResource Font.Caption}"/></DataTrigger>
   <DataTrigger Binding="{Binding Converter={StaticResource Size}}" Value="Subheading"><Setter TargetName="Text" Property="FontSize" Value="{DynamicResource Font.Subheading}"/></DataTrigger>
   <DataTrigger Binding="{Binding Role}" Value="Warning"><Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Token.Note.Foreground}"/></DataTrigger>
   <DataTrigger Binding="{Binding Role}" Value="Error"><Setter TargetName="Text" Property="FontSize" Value="{DynamicResource Font.Body}"/><Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Token.Status.Fail}"/></DataTrigger>
  </DataTemplate.Triggers>
 </DataTemplate>

 <!-- A table (Table of the historic view): read-only, wrapping cells, the heights and the widths of the historic tables; the selection of the ranking. -->
 <DataTemplate DataType="{x:Type bd:BridgeDesignTable}">
  <views:BridgeDesignGrid Table="{Binding}"/>
 </DataTemplate>

 <!-- A button of a panel: the whole width, as Ui.Button in a stack. -->
 <DataTemplate DataType="{x:Type bd:BridgeDesignButton}">
  <Button Style="{StaticResource Command}" Content="{Binding Caption}" Command="{Binding Command}"/>
 </DataTemplate>

 <!-- A group: an expander with its header and its items (the reasons of exclusion of the search). -->
 <DataTemplate DataType="{x:Type bd:BridgeDesignGroup}">
  <Expander Header="{Binding Header}" Foreground="{DynamicResource Token.Ink}">
   <ItemsControl Style="{StaticResource Items}" ItemsSource="{Binding Items}"/>
  </Expander>
 </DataTemplate>

 <!-- The moment diagram of the details: the historic drawing (Q3), 180 high. -->
 <DataTemplate DataType="{x:Type bd:BridgeDesignMomentChart}">
  <views:BridgeDesignMomentHost Result="{Binding Result}" Height="180"/>
 </DataTemplate>

 <!-- A parameter (Number of the historic view): label 12, the raw text (76 wide, centred, red border when invalid), unit 11, and the slider of the
      inputs (BridgeDesignSlider: the range before the value, never coercing the value of the sheet). Read-only revision: the text cannot be typed
      and the slider is disabled. -->
 <DataTemplate DataType="{x:Type bd:BridgeDesignParameter}">
  <StackPanel>
   <Grid Margin="3,6,3,3">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
    <TextBlock Style="{StaticResource T12}" Text="{Binding Label}"/>
    <TextBox x:Name="Edit" Grid.Column="1" TextAlignment="Center" MinHeight="26" AutomationProperties.Name="{Binding Label}" BorderBrush="{DynamicResource Token.Border}"
     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
     IsReadOnly="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=views:BridgeDesignSheetView}, Converter={StaticResource Not}, FallbackValue=False}"/>
    <TextBlock Grid.Column="2" Style="{StaticResource T11Muted}" Margin="5,0,0,0" Text="{Binding Unit}"/>
   </Grid>
   <views:BridgeDesignSlider x:Name="Range" Parameter="{Binding}" Margin="6,0,6,2" views:BridgeDesignWheel.Forward="True"
    AutomationProperties.Name="{Binding Label, StringFormat='{}{0} · cursore'}" Visibility="{Binding HasSlider, Converter={StaticResource Visible}}"
    IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=views:BridgeDesignSheetView}, FallbackValue=True}"/>
  </StackPanel>
  <DataTemplate.Triggers>
   <DataTrigger Binding="{Binding Invalid}" Value="True"><Setter TargetName="Edit" Property="BorderBrush" Value="{DynamicResource Token.Status.Fail}"/></DataTrigger>
  </DataTemplate.Triggers>
 </DataTemplate>

 <!-- A choice: label 12 over the combo box (margin 4,8,4,3); the items before the item chosen. -->
 <DataTemplate DataType="{x:Type bd:BridgeDesignChoice}">
  <StackPanel Margin="4,8,4,3">
   <TextBlock Style="{StaticResource T12}" Text="{Binding Label}"/>
   <ComboBox Style="{StaticResource Choice}" AutomationProperties.Name="{Binding Label}" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}"
    IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=views:BridgeDesignSheetView}, FallbackValue=True}"/>
  </StackPanel>
 </DataTemplate>

 <!-- An option of the spans (Toggle of the historic view). -->
 <DataTemplate DataType="{x:Type bd:BridgeDesignOption}">
  <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="6,12,6,8" Foreground="{DynamicResource Token.Ink}"
   IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=views:BridgeDesignSheetView}, FallbackValue=True}"/>
 </DataTemplate>

 <!-- The buttons of the typologies, two for each row: name 11 bold, the icon of the typology (112 × 32, the ink of the button), the usual spans 10;
      the typology chosen dark, as Ui.SetSelected. -->
 <DataTemplate DataType="{x:Type bd:BridgeDesignFamilies}">
  <ItemsControl Style="{StaticResource Items}" ItemsSource="{Binding Families}">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate>
    <DataTemplate DataType="{x:Type bd:BridgeDesignFamilyOption}">
     <Button x:Name="Family" Style="{StaticResource Command}" MinHeight="82" Padding="6" AutomationProperties.Name="{Binding Name}" CommandParameter="{Binding Id}"
      Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
      <StackPanel>
       <TextBlock Style="{StaticResource T11}" FontWeight="SemiBold" Text="{Binding Name}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
       <views:BridgeDesignFamilyIcon Family="{Binding Id}" Ink="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="112" Height="32"/>
       <TextBlock x:Name="Range" Style="{StaticResource T11Muted}" Text="{Binding Range}"/>
      </StackPanel>
     </Button>
     <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsSelected}" Value="True">
       <Setter TargetName="Family" Property="Background" Value="{DynamicResource Token.Selected}"/>
       <Setter TargetName="Family" Property="Foreground" Value="{DynamicResource Token.OnCommandBar}"/>
       <Setter TargetName="Range" Property="Foreground" Value="{DynamicResource Token.OnCommandBar.Muted}"/>
      </DataTrigger>
     </DataTemplate.Triggers>
    </DataTemplate>
   </ItemsControl.ItemTemplate>
  </ItemsControl>
 </DataTemplate>
</ResourceDictionary>
