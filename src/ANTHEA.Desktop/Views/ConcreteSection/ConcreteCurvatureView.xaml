<!--
  The tab 07 «Momento–curvatura» of the RC section (F5.10 view after S9) on ConcreteCurvatureViewModel, with the layout of BuildCurvaturePanel of the
  historic view (WorkspaceLayout and Rows): the load path with «Calcola curva», «Interrompi», «Esporta CSV…» and the notice; the chart M [kNm] · χ [1/m]
  over the text of the result. The chart is the Plot of the historic view, fed by the data of the curve in the code-behind (Q3). Theme tokens only (P7).
-->
<UserControl x:Class="X.Desktop.Views.ConcreteSection.ConcreteCurvatureView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:X.Desktop"
 xmlns:views="clr-namespace:X.Desktop.Views.ConcreteSection">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ConcreteSectionResources.xaml"/></ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid x:Name="Columns" Tag="ingressi" Margin="0,10,0,0">
  <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="285"/><ColumnDefinition Width="8"/><ColumnDefinition Width="7*" MinWidth="650"/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Paper}">
   <DockPanel>
    <StackPanel Style="{StaticResource PanelHeading}"><TextBlock Style="{StaticResource T14Bold}" Text="Percorso di carico"/></StackPanel>
    <local:ChainedScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <ContentControl Style="{StaticResource Form}" Content="{Binding Form}"/>
      <WrapPanel>
       <Button Style="{StaticResource Command}" Content="Calcola curva" Command="{Binding CalculateCommand}"/>
       <Button Style="{StaticResource Command}" Content="Interrompi" Command="{Binding StopCommand}"/>
       <Button Style="{StaticResource Command}" Content="Esporta CSV…" Command="{Binding ExportCommand}"/>
      </WrapPanel>
      <TextBlock Style="{StaticResource T12}" Text="{Binding Notice}"/>
     </StackPanel>
    </local:ChainedScrollViewer>
   </DockPanel>
  </Border>
  <GridSplitter Style="{StaticResource ColumnSplitter}"/>
  <Grid x:Name="Rows" Tag="righe" Grid.Column="2">
   <Grid.RowDefinitions><RowDefinition Height="3.7*" MinHeight="160"/><RowDefinition Height="8"/><RowDefinition Height="2*" MinHeight="155"/></Grid.RowDefinitions>
   <Border Style="{StaticResource Frame}">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="2,0,2,6">
      <TextBlock Style="{StaticResource T14Bold}" Text="M [kNm] · χ [1/m]"/>
      <WrapPanel>
       <Button Style="{StaticResource Command}" Content="Adatta" Click="Fit_Click"/>
       <Button Style="{StaticResource Command}" Content="PNG" Click="Png_Click"/>
       <Button Style="{StaticResource Command}" Content="Espandi" Click="Expand_Click"/>
      </WrapPanel>
     </StackPanel>
     <ContentControl x:Name="ChartHost" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </DockPanel>
   </Border>
   <GridSplitter Style="{StaticResource RowSplitter}"/>
   <TextBox Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding Text, Mode=OneWay}"
    AutomationProperties.Name="Risultato della curva"/>
  </Grid>
 </Grid>
</UserControl>
