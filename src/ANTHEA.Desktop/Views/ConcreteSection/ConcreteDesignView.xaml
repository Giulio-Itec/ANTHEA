<!--
  The tab 08 «Calcola armature» of the RC section (F5.10 view after S9) on ConcreteDesignViewModel, with the layout of BuildDesignPanel of the historic
  view: the search with the notice, «Sezione →», «Dettagli →», «SLE / esposizione →», the form and the limits of every check; above the results
  «Calcola armature», «Ferma ricerca», the progress and the status; the selected configuration drawn, the result of the search with «Applica
  configurazione»; the alternatives with «Mostra le prime», the checks of the proposal, the search and the discarded configurations. The section is
  the drawing of the historic view, fed by the data of the proposal in the code-behind (Q3). Theme tokens only (P7).
-->
<UserControl x:Class="X.Desktop.Views.ConcreteSection.ConcreteDesignView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:X.Desktop.Views.Common"
 xmlns:local="clr-namespace:X.Desktop"
 xmlns:views="clr-namespace:X.Desktop.Views.ConcreteSection"
 xmlns:sys="clr-namespace:System;assembly=System.Runtime">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ConcreteSectionResources.xaml"/></ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid x:Name="Columns" Tag="ingressi" Margin="0,10,0,0">
  <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="285"/><ColumnDefinition Width="8"/><ColumnDefinition Width="7*" MinWidth="650"/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Paper}">
   <DockPanel>
    <StackPanel Style="{StaticResource PanelHeading}">
     <TextBlock Style="{StaticResource T14Bold}" Text="Ricerca dell’armatura"/>
     <TextBlock Style="{StaticResource PanelSubtitle}" Text="Elenchi discreti · numeri separati da punto e virgola"/>
    </StackPanel>
    <local:ChainedScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock Style="{StaticResource T11}" Text="{Binding Notice}"/>
      <WrapPanel>
       <Button Style="{StaticResource Command}" Content="Sezione →" Command="{Binding ShowTabCommand}">
        <Button.CommandParameter><sys:Int32>0</sys:Int32></Button.CommandParameter>
       </Button>
       <Button Style="{StaticResource Command}" Content="Dettagli →" Command="{Binding ShowTabCommand}">
        <Button.CommandParameter><sys:Int32>5</sys:Int32></Button.CommandParameter>
       </Button>
      </WrapPanel>
      <Button Style="{StaticResource Command}" Content="SLE / esposizione →" Command="{Binding ShowTabCommand}" HorizontalAlignment="Left">
       <Button.CommandParameter><sys:Int32>3</sys:Int32></Button.CommandParameter>
      </Button>
      <ContentControl Style="{StaticResource Form}" Content="{Binding Form}"/>
      <Expander Style="{StaticResource Group}" IsExpanded="True">
       <Expander.Header><TextBlock Style="{StaticResource T14Bold}" Text="Limiti per ciascuna verifica"/></Expander.Header>
       <StackPanel>
        <TextBlock Style="{StaticResource T11}" Text="{Binding LimitsNotice}"/>
        <ContentControl Style="{StaticResource Form}" Content="{Binding Limits}"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </local:ChainedScrollViewer>
   </DockPanel>
  </Border>
  <GridSplitter Style="{StaticResource ColumnSplitter}"/>
  <DockPanel Grid.Column="2">
   <StackPanel DockPanel.Dock="Top">
    <WrapPanel>
     <Button Style="{StaticResource Command}" Content="Calcola armature" Command="{Binding RunCommand}"/>
     <Button Style="{StaticResource Command}" Content="Ferma ricerca" Command="{Binding StopCommand}"/>
    </WrapPanel>
    <ProgressBar Height="4" Minimum="0" Maximum="1" Margin="0,5,0,5" Value="{Binding Progress, Mode=OneWay}" AutomationProperties.Name="Avanzamento della ricerca"/>
    <TextBlock Style="{StaticResource T12}" Text="{Binding Status}"/>
   </StackPanel>
   <Grid x:Name="Rows" Tag="righe">
    <Grid.RowDefinitions><RowDefinition Height="3.7*" MinHeight="160"/><RowDefinition Height="8"/><RowDefinition Height="2*" MinHeight="155"/></Grid.RowDefinitions>
    <Grid x:Name="Results" Tag="risultati">
     <Grid.ColumnDefinitions><ColumnDefinition Width="6*" MinWidth="350"/><ColumnDefinition Width="8"/><ColumnDefinition Width="4*" MinWidth="230"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Frame}">
      <DockPanel>
       <StackPanel DockPanel.Dock="Top" Margin="2,0,2,6">
        <TextBlock Style="{StaticResource T14Bold}" Text="Configurazione selezionata"/>
        <WrapPanel>
         <Button Style="{StaticResource Command}" Content="Adatta" Click="Fit_Click"/>
         <Button Style="{StaticResource Command}" Content="PNG" Click="Png_Click"/>
         <Button Style="{StaticResource Command}" Content="Espandi" Click="Expand_Click"/>
        </WrapPanel>
       </StackPanel>
       <ContentControl x:Name="PreviewHost" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
      </DockPanel>
     </Border>
     <GridSplitter Style="{StaticResource ColumnSplitter}"/>
     <Border Grid.Column="2" Style="{StaticResource Paper}">
      <DockPanel>
       <StackPanel Style="{StaticResource PanelHeading}"><TextBlock Style="{StaticResource T14Bold}" Text="Risultato della ricerca"/></StackPanel>
       <Button DockPanel.Dock="Bottom" Style="{StaticResource Command}" Content="Applica configurazione" Command="{Binding ApplyCommand}" HorizontalAlignment="Left"/>
       <local:ChainedScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
         <TextBlock Style="{StaticResource T12Bold}" Text="{Binding Description}"/>
         <ContentControl Style="{StaticResource Form}" Content="{Binding Metrics}" ContentTemplate="{StaticResource SummaryCards}"/>
         <TextBlock Style="{StaticResource T11Muted}" Text="{Binding Scope}"/>
        </StackPanel>
       </local:ChainedScrollViewer>
      </DockPanel>
     </Border>
    </Grid>
    <GridSplitter Style="{StaticResource RowSplitter}"/>
    <TabControl common:TabMemory.Key="alternative" Grid.Row="2">
     <TabItem Header="Alternative">
      <DockPanel>
       <ContentControl DockPanel.Dock="Top" Style="{StaticResource Form}" Content="{Binding Shown}"/>
       <views:ConcreteTableGrid Table="{Binding Ranking}" StretchColumns="True" AutomationProperties.Name="Alternative"/>
      </DockPanel>
     </TabItem>
     <TabItem Header="Verifiche della proposta">
      <local:ChainedScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <ContentControl Style="{StaticResource Form}" Content="{Binding Checks}" ContentTemplate="{StaticResource SummaryCards}"/>
      </local:ChainedScrollViewer>
     </TabItem>
     <TabItem Header="Ricerca e scarti">
      <local:ChainedScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <TextBlock Style="{StaticResource T11}" Text="{Binding Diagnostics}"/>
      </local:ChainedScrollViewer>
     </TabItem>
    </TabControl>
   </Grid>
  </DockPanel>
 </Grid>
</UserControl>
