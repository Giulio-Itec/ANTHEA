<!--
  The window «Wizard · Sezione in cemento armato» (F5.10 view after S9, S1b) on ConcreteTemplateWizardViewModel, shown by the dialog service, with the
  layout of ConcreteTemplateWizardWindow of the historic view: the form on the left (430), the preview of the section with the note, the error,
  «Applica sezione» and «Annulla» on the right. The preview is the drawing of the historic view, fed by the geometry of the wizard in the code-behind
  (Q3). Tokens only (P7).
-->
<UserControl x:Class="X.Desktop.Views.ConcreteSection.ConcreteTemplateWizardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="1140" Height="780" Background="{DynamicResource Token.Surface}">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ConcreteSectionResources.xaml"/></ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <ContentControl Style="{StaticResource Form}" Margin="12" Content="{Binding Form}"/>
  </ScrollViewer>
  <DockPanel Grid.Column="1" Margin="12">
   <StackPanel DockPanel.Dock="Bottom">
    <TextBlock Style="{StaticResource T12}" Text="{Binding Note}"/>
    <TextBlock Style="{StaticResource T12}" Text="{Binding Error}"/>
    <WrapPanel>
     <Button Style="{StaticResource Command}" Content="Applica sezione" Command="{Binding ApplyCommand}"/>
     <Button Style="{StaticResource Command}" Content="Annulla" Command="{Binding CancelCommand}" IsCancel="True"/>
    </WrapPanel>
   </StackPanel>
   <ContentControl x:Name="PreviewHost" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </DockPanel>
 </Grid>
</UserControl>
