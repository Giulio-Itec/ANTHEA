<!--
  Data templates of the RC section sheet (F5.10, view after S9): MvvmSheetEditor finds the view of ConcreteSheetViewModel here, the dialog service the
  view of its dialogs. The Release keeps the historic view until its switch (decision C10); the UiTests bench chooses this view with the option
  module-impl and str_palo=mvvm.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:X.Desktop.Views.ConcreteSection"
 xmlns:concrete="clr-namespace:Anthea.Presentation.Modules.ConcreteSection;assembly=ANTHEA.Presentation">
 <DataTemplate DataType="{x:Type concrete:ConcreteSheetViewModel}"><views:ConcreteSectionSheetView/></DataTemplate>
 <!-- The dialogs of the sheet on the dialog service: «Nuovo materiale · …», the wizard of the sections, «Sollecitazioni della sezione»; the non modal
      window «Proprietà / report della sezione», opened by the view of the sheet. -->
 <DataTemplate DataType="{x:Type concrete:ConcreteMaterialDialogViewModel}"><views:ConcreteMaterialDialogView/></DataTemplate>
 <DataTemplate DataType="{x:Type concrete:ConcreteTemplateWizardViewModel}"><views:ConcreteTemplateWizardView/></DataTemplate>
 <DataTemplate DataType="{x:Type concrete:SectionActionsViewModel}"><views:SectionActionsDialogView/></DataTemplate>
 <DataTemplate DataType="{x:Type concrete:ConcreteSectionPropertiesViewModel}"><views:ConcreteSectionPropertiesView/></DataTemplate>
 <!-- «Scala…» of a domain panel (the window of AddDomainScaleControls of the historic view: the form, the message, «Applica»). -->
 <DataTemplate DataType="{x:Type concrete:ConcreteDomainScaleDialogViewModel}">
  <Border Background="{DynamicResource Token.Paper}" Padding="16" Width="470">
   <StackPanel>
    <ContentControl Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" Content="{Binding Form}"/>
    <TextBlock FontSize="{DynamicResource Font.Small}" Foreground="{DynamicResource Token.Ink}" TextWrapping="Wrap" Text="{Binding Message}"/>
    <Button Content="Applica" Command="{Binding ApplyCommand}" HorizontalAlignment="Left"/>
   </StackPanel>
  </Border>
 </DataTemplate>
</ResourceDictionary>
