<!--
  Resources of the views of the composite bridge section sheet (F5.11), merged by CompositeSectionSheetView, by the window of the detached view
  and by the window «Info modello…»: the texts of Ui.Text in their sizes (10 and 11 → Font.Caption, 12 → Font.Small, 13 → Font.Body, 14 and 15
  → Font.Subheading, the title of the information → Font.Title, decision D8), Ui.Paper and the Panel of the historic view, the groups
  (expanders), the light and the primary buttons, the notice, the converters, the templates of the panels of results (BridgePanel and its
  blocks: text, table, group), of the tables of the properties (PresentationTable) and of the cards of the summary (ConcreteCardsViewModel).
  Theme tokens only (rule P7).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:X.Desktop"
 xmlns:common="clr-namespace:X.Desktop.Views.Common"
 xmlns:views="clr-namespace:X.Desktop.Views.CompositeSection"
 xmlns:presentation="clr-namespace:Anthea.Application.Presentation;assembly=ANTHEA.Application"
 xmlns:concrete="clr-namespace:Anthea.Presentation.Modules.ConcreteSection;assembly=ANTHEA.Presentation"
 xmlns:cs="clr-namespace:Anthea.Presentation.Modules.CompositeSection;assembly=ANTHEA.Presentation">
 <common:NegationConverter x:Key="Not"/>
 <BooleanToVisibilityConverter x:Key="Visible"/>
 <views:TextShownConverter x:Key="TextShown"/>
 <views:PresentShownConverter x:Key="PresentShown"/>
 <views:CollapsedWhenTrueConverter x:Key="Collapsed"/>
 <views:PageShownConverter x:Key="PageShown"/>
 <views:PanelOfConverter x:Key="PanelOf"/>
 <views:CardBrushConverter x:Key="CardBrush"/>
 <views:CompositeSectionPanelSelector x:Key="Panels"/>
 <views:CompositeSectionBlockSelector x:Key="Blocks"/>
 <views:CompositeSectionTableSelector x:Key="Tables"/>
 <views:PropertyTabSelector x:Key="PropertyTabs"/>

 <!-- Texts: Ui.Text of the historic view (wrapping, vertically centred, ink). -->
 <Style x:Key="T13" TargetType="TextBlock">
  <Setter Property="FontSize" Value="{DynamicResource Font.Body}"/>
  <Setter Property="Foreground" Value="{DynamicResource Token.Ink}"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
 </Style>
 <Style x:Key="T12" TargetType="TextBlock" BasedOn="{StaticResource T13}">
  <Setter Property="FontSize" Value="{DynamicResource Font.Small}"/>
 </Style>
 <Style x:Key="T12Bold" TargetType="TextBlock" BasedOn="{StaticResource T12}">
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <Style x:Key="T12Muted" TargetType="TextBlock" BasedOn="{StaticResource T12}">
  <Setter Property="Foreground" Value="{DynamicResource Token.Muted}"/>
 </Style>
 <Style x:Key="T12BoldMuted" TargetType="TextBlock" BasedOn="{StaticResource T12Bold}">
  <Setter Property="Foreground" Value="{DynamicResource Token.Muted}"/>
 </Style>
 <!-- The warnings of the historic view (#8B5916): the note colour of the theme (#865D16 in Chiara). -->
 <Style x:Key="T12Warning" TargetType="TextBlock" BasedOn="{StaticResource T12}">
  <Setter Property="Foreground" Value="{DynamicResource Token.Note.Foreground}"/>
 </Style>
 <Style x:Key="T12BoldWarning" TargetType="TextBlock" BasedOn="{StaticResource T12Bold}">
  <Setter Property="Foreground" Value="{DynamicResource Token.Note.Foreground}"/>
 </Style>
 <Style x:Key="T11" TargetType="TextBlock" BasedOn="{StaticResource T13}">
  <Setter Property="FontSize" Value="{DynamicResource Font.Caption}"/>
 </Style>
 <Style x:Key="T11Bold" TargetType="TextBlock" BasedOn="{StaticResource T11}">
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <Style x:Key="T11Muted" TargetType="TextBlock" BasedOn="{StaticResource T11}">
  <Setter Property="Foreground" Value="{DynamicResource Token.Muted}"/>
 </Style>
 <Style x:Key="T11BoldMuted" TargetType="TextBlock" BasedOn="{StaticResource T11Bold}">
  <Setter Property="Foreground" Value="{DynamicResource Token.Muted}"/>
 </Style>
 <Style x:Key="T14Bold" TargetType="TextBlock" BasedOn="{StaticResource T13}">
  <Setter Property="FontSize" Value="{DynamicResource Font.Subheading}"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource T13}">
  <Setter Property="FontSize" Value="{DynamicResource Font.Title}"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <!-- The heading of a Block of the historic view (15 points, bold) and its subtitle. -->
 <Style x:Key="BlockTitle" TargetType="TextBlock" BasedOn="{StaticResource T14Bold}">
  <Setter Property="Margin" Value="0,12,0,8"/>
 </Style>
 <Style x:Key="BlockSubtitle" TargetType="TextBlock" BasedOn="{StaticResource T11Muted}">
  <Setter Property="Margin" Value="0,0,0,7"/>
 </Style>

 <!-- Ui.Paper with the padding of the panels of the historic view (14), the border of the cards (D12). -->
 <Style x:Key="Paper" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource Token.Paper}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Token.Border}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="14"/>
 </Style>
 <!-- The heading of a Panel of the historic view: title (15, bold) and subtitle (11, muted), 10 above the body. -->
 <Style x:Key="PanelHeading" TargetType="StackPanel">
  <Setter Property="DockPanel.Dock" Value="Top"/>
  <Setter Property="Margin" Value="0,0,0,10"/>
 </Style>
 <Style x:Key="PanelSubtitle" TargetType="TextBlock" BasedOn="{StaticResource T11Muted}">
  <Setter Property="Margin" Value="0,5,0,0"/>
 </Style>
 <!-- Group of the historic view: an expander with the title (14, bold) as header, closed unless said. -->
 <Style x:Key="Group" TargetType="Expander">
  <Setter Property="Padding" Value="0,8,0,10"/>
  <Setter Property="Margin" Value="0,4,0,4"/>
  <Setter Property="Foreground" Value="{DynamicResource Token.Ink}"/>
 </Style>
 <!-- Notice of the historic view: paper with the colours of the notes. -->
 <Style x:Key="Notice" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource Token.Note.Background}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Token.Note.Border}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="10"/>
  <Setter Property="Margin" Value="0,8,0,8"/>
 </Style>
 <Style x:Key="NoticeText" TargetType="TextBlock" BasedOn="{StaticResource T11}">
  <Setter Property="Foreground" Value="{DynamicResource Token.Note.Foreground}"/>
 </Style>
 <!-- Ui.Button: a light button, with the implicit style of the theme (padding, margin, height), as the historic Ui.Button (S17). -->
 <Style x:Key="Command" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource Token.Paper}"/>
  <Setter Property="Foreground" Value="{DynamicResource Token.Ink}"/>
 </Style>
 <!-- Ui.Button(primary: true). -->
 <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource Token.Selected}"/>
  <Setter Property="Foreground" Value="{DynamicResource Token.OnCommandBar}"/>
 </Style>
 <!-- The switches of the toolbar of the drawing. -->
 <Style x:Key="Switch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
  <Setter Property="Margin" Value="8,6,4,4"/>
  <Setter Property="Foreground" Value="{DynamicResource Token.Ink}"/>
 </Style>
 <!-- Ui.Choice: a combo box with a margin of 2. -->
 <Style x:Key="Choice" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
  <Setter Property="Margin" Value="2"/>
 </Style>
 <!-- Host of a FieldForm (DataTemplate of FormViewModel, Views/Common/FieldFormTemplates.xaml). -->
 <Style x:Key="Form" TargetType="ContentControl">
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="IsTabStop" Value="False"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
 </Style>
 <!-- The splitters of the panels: Appearance.Surface, as the historic Split. -->
 <Style x:Key="ColumnSplitter" TargetType="GridSplitter">
  <Setter Property="Background" Value="{DynamicResource Token.Surface}"/>
  <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
  <Setter Property="Width" Value="6"/>
  <Setter Property="HorizontalAlignment" Value="Center"/>
  <Setter Property="VerticalAlignment" Value="Stretch"/>
  <Setter Property="Grid.Column" Value="1"/>
 </Style>
 <Style x:Key="RowSplitter" TargetType="GridSplitter">
  <Setter Property="Background" Value="{DynamicResource Token.Surface}"/>
  <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
  <Setter Property="Height" Value="6"/>
  <Setter Property="HorizontalAlignment" Value="Stretch"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Grid.Row" Value="1"/>
 </Style>

 <!-- The panels of results (Render of the historic view): one block alone, a stack of blocks, or a stack in a scroll viewer of its own. -->
 <DataTemplate x:Key="PanelSingle" DataType="{x:Type presentation:BridgePanel}">
  <ContentControl Style="{StaticResource Form}" VerticalContentAlignment="Stretch" Content="{Binding Blocks[0]}" ContentTemplateSelector="{StaticResource Blocks}"/>
 </DataTemplate>
 <DataTemplate x:Key="PanelStack" DataType="{x:Type presentation:BridgePanel}">
  <ItemsControl Focusable="False" ItemsSource="{Binding Blocks}" ItemTemplateSelector="{StaticResource Blocks}"/>
 </DataTemplate>
 <DataTemplate x:Key="PanelScroll" DataType="{x:Type presentation:BridgePanel}">
  <local:ChainedScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ItemsControl Focusable="False" ItemsSource="{Binding Blocks}" ItemTemplateSelector="{StaticResource Blocks}"/>
  </local:ChainedScrollViewer>
 </DataTemplate>
 <!-- A text of a panel: 12 points, 12 muted, 11 muted (the notes), 13 (the empty placeholders of the studs). -->
 <DataTemplate x:Key="BlockText" DataType="{x:Type presentation:BridgeBlock}">
  <TextBlock x:Name="Text" Style="{StaticResource T12}" Text="{Binding Text}"/>
  <DataTemplate.Triggers>
   <DataTrigger Binding="{Binding Style}" Value="Muted"><Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Token.Muted}"/></DataTrigger>
   <DataTrigger Binding="{Binding Style}" Value="Note">
    <Setter TargetName="Text" Property="FontSize" Value="{DynamicResource Font.Caption}"/><Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Token.Muted}"/>
   </DataTrigger>
   <DataTrigger Binding="{Binding Style}" Value="Plain"><Setter TargetName="Text" Property="FontSize" Value="{DynamicResource Font.Body}"/></DataTrigger>
  </DataTemplate.Triggers>
 </DataTemplate>
 <DataTemplate x:Key="BlockTable" DataType="{x:Type presentation:BridgeBlock}">
  <views:CompositeSectionGrid Headers="{Binding Columns}" Rows="{Binding Rows}"/>
 </DataTemplate>
 <DataTemplate x:Key="BlockGroup" DataType="{x:Type presentation:BridgeBlock}">
  <Expander Style="{StaticResource Group}">
   <Expander.Header><TextBlock Style="{StaticResource T14Bold}" Text="{Binding Text}"/></Expander.Header>
   <ContentControl Style="{StaticResource Form}" Content="{Binding Children, Converter={StaticResource PanelOf}}" ContentTemplateSelector="{StaticResource Panels}"/>
  </Expander>
 </DataTemplate>

 <!-- The tables of the properties (PropertyTable of the historic view): a Block with its title and note, or a closed group. -->
 <DataTemplate x:Key="TableBlock" DataType="{x:Type presentation:PresentationTable}">
  <StackPanel>
   <TextBlock Style="{StaticResource BlockTitle}" Text="{Binding Title}"/>
   <TextBlock Style="{StaticResource BlockSubtitle}" Text="{Binding Note}" Visibility="{Binding Note, Converter={StaticResource TextShown}}"/>
   <views:CompositeSectionGrid Headers="{Binding Columns}" Rows="{Binding Rows}"/>
  </StackPanel>
 </DataTemplate>
 <DataTemplate x:Key="TableGroup" DataType="{x:Type presentation:PresentationTable}">
  <Expander Style="{StaticResource Group}">
   <Expander.Header><TextBlock Style="{StaticResource T14Bold}" Text="{Binding Title}"/></Expander.Header>
   <views:CompositeSectionGrid Headers="{Binding Columns}" Rows="{Binding Rows}"/>
  </Expander>
 </DataTemplate>

 <!-- The cards of the summary (VerificationCards of the historic view, one column): the message, or the summaries with the colour of η. -->
 <DataTemplate x:Key="SummaryCards" DataType="{x:Type concrete:ConcreteCardsViewModel}">
  <StackPanel>
   <TextBlock Style="{StaticResource T12}" Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource TextShown}}"/>
   <ItemsControl Focusable="False" ItemsSource="{Binding Cards}">
    <ItemsControl.ItemTemplate>
     <DataTemplate DataType="{x:Type concrete:ConcreteCard}">
      <Border BorderBrush="{Binding Converter={StaticResource CardBrush}}" BorderThickness="5,0,0,0" Background="{DynamicResource Token.Paper}"
       Padding="5,2,4,2" Margin="0,0,0,3" ToolTip="{Binding ToolTip}">
       <StackPanel>
        <DockPanel>
         <TextBlock DockPanel.Dock="Right" Style="{StaticResource T12Bold}" Margin="6,0,0,0" Text="{Binding Value}"/>
         <TextBlock Style="{StaticResource T11Bold}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Heading}"/>
        </DockPanel>
        <TextBlock Style="{StaticResource T11}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Explanation}"/>
       </StackPanel>
      </Border>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
  </StackPanel>
 </DataTemplate>

  <!-- The tabs of the properties of the section: «Acciaio», «Soletta» (with its form), one for each phase. -->
  <DataTemplate x:Key="SteelProperties" DataType="{x:Type cs:CompositeSectionPropertyTab}">
   <local:ChainedScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl Focusable="False" ItemsSource="{Binding DataContext.SteelPropertyTables, RelativeSource={RelativeSource AncestorType=TabControl}}"
     ItemTemplateSelector="{StaticResource Tables}"/>
   </local:ChainedScrollViewer>
  </DataTemplate>
  <DataTemplate x:Key="SlabProperties" DataType="{x:Type cs:CompositeSectionPropertyTab}">
   <local:ChainedScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}">
     <ContentControl Style="{StaticResource Form}" Content="{Binding SlabPropertiesForm}"/>
     <TextBlock Style="{StaticResource T11Muted}" Text="{Binding SlabPropertiesNote}"/>
     <TextBlock Style="{StaticResource T12Muted}" Text="{Binding SlabPropertyError}" Visibility="{Binding SlabPropertyError, Converter={StaticResource TextShown}}"/>
     <ItemsControl Focusable="False" ItemsSource="{Binding SlabPropertyTables}" ItemTemplateSelector="{StaticResource Tables}"/>
    </StackPanel>
   </local:ChainedScrollViewer>
  </DataTemplate>
  <DataTemplate x:Key="PhaseProperties" DataType="{x:Type cs:CompositeSectionPropertyTab}">
   <local:ChainedScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <TextBlock Style="{StaticResource T12Muted}" Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource TextShown}}"/>
     <StackPanel DataContext="{Binding Properties}" Visibility="{Binding Converter={StaticResource PresentShown}}">
      <TextBlock Style="{StaticResource T14Bold}" Text="{Binding Title}"/>
      <TextBlock Style="{StaticResource T11Muted}" Text="{Binding Description}"/>
      <TextBlock Style="{StaticResource T12}" Text="{Binding Homogenization}" Visibility="{Binding Homogenization, Converter={StaticResource TextShown}}"/>
      <ContentControl Style="{StaticResource Form}" Content="{Binding Properties}" ContentTemplateSelector="{StaticResource Tables}"/>
     </StackPanel>
    </StackPanel>
   </local:ChainedScrollViewer>
  </DataTemplate>
</ResourceDictionary>
