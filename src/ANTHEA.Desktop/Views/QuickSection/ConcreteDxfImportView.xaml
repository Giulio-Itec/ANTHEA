<UserControl x:Class="X.Desktop.Views.QuickSection.ConcreteDxfImportView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="1000" Height="650" Background="{DynamicResource Token.Surface}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../ConcreteSection/ConcreteSectionResources.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="12">
  <Grid.ColumnDefinitions><ColumnDefinition Width="370"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock Text="{Binding Instructions}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <ContentControl Style="{StaticResource Form}" Content="{Binding Form}"/>
    <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Margin="0,12,12,0" Foreground="{DynamicResource Token.Muted}"/>
   </StackPanel>
  </ScrollViewer>
  <DockPanel Grid.Column="1" Margin="14,0,0,0">
   <StackPanel DockPanel.Dock="Bottom">
    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,6"/>
    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Token.Status.Fail}" Margin="0,6"/>
    <WrapPanel HorizontalAlignment="Right">
     <Button Content="Importa sezione" Command="{Binding ApplyCommand}" Style="{StaticResource Command}"/>
     <Button Content="Annulla" Command="{Binding CancelCommand}" IsCancel="True" Style="{StaticResource Command}"/>
    </WrapPanel>
   </StackPanel>
   <ContentControl x:Name="PreviewHost" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </DockPanel>
 </Grid>
</UserControl>
