<!--
  View of QuickSectionSheetViewModel: the whole sheet on one page, as a small calculation window. Left, in the order of the input, four cards:
  1 Geometria, 2 Armature, 3 Sollecitazioni (the combinations, η of each one), 4 Materiali. Right: the choices of the calculation as segmented buttons,
  the result of the selected combination in evidence (MRd, η with its bar, outcome, behaviour, the other values), the drawing area with the tabs
  Sezione / Dominio / M–χ. The fields are those of the ViewModel (the editors are wired in the code-behind as in FieldForm). Colours are theme tokens.
-->
<UserControl x:Class="X.Desktop.Views.QuickSection.QuickSectionSheetView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:forms="clr-namespace:Anthea.Presentation.Forms;assembly=ANTHEA.Presentation"
 xmlns:concrete="clr-namespace:X.Desktop.Views.ConcreteSection"
 xmlns:shell="clr-namespace:X.Desktop.Views.Shell"
 Background="{DynamicResource Token.Surface}" FontSize="{DynamicResource Font.Small}" PreviewKeyDown="Sheet_PreviewKeyDown">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visibility"/>
  <concrete:PresentShownConverter x:Key="Present"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Token.Ink}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="Foreground" Value="{DynamicResource Token.Muted}"/><Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource Token.Muted}"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="22"/></Style>

  <!-- A card: light border, rounded corners. -->
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource Token.Paper}"/><Setter Property="BorderBrush" Value="{DynamicResource Token.Border}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,6,10,8"/><Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="Foreground" Value="{DynamicResource Token.Muted}"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <!-- A command as a link («+ strato», «?»). -->
  <Style x:Key="Link" TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource Token.Accent}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border Background="Transparent" Padding="4,0"><TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/></Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="TextDecorations" Value="Underline"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="T" Property="Foreground" Value="{DynamicResource Token.Disabled}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <!-- A small Excel button: the green sheet with its «X» and an arrow (the content: ↑ export, ↓ import). -->
  <Style x:Key="ExcelButton" TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="2,0,0,0"/><Setter Property="Focusable" Value="False"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="B" Background="Transparent" CornerRadius="4" Padding="3,1">
       <StackPanel Orientation="Horizontal">
        <Border Width="15" Height="15" CornerRadius="2" Background="{DynamicResource Token.Status.Ok}">
         <TextBlock Text="X" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource Token.Badge.Ok}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="{TemplateBinding Content}" Margin="2,0,0,0" FontWeight="Bold" Foreground="{DynamicResource Token.Status.Ok}"/>
       </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Token.Hover}"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <!-- Segmented buttons: a list of choices, the selected one in evidence. -->
  <Style x:Key="SegmentedItem" TargetType="ListBoxItem">
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="B" Padding="9,2" CornerRadius="5" Background="Transparent">
       <TextBlock x:Name="T" Text="{Binding}" Foreground="{DynamicResource Token.Muted}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Token.Hover}"/></Trigger>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="B" Property="Background" Value="{DynamicResource Token.Selection}"/>
        <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Token.Accent}"/><Setter TargetName="T" Property="FontWeight" Value="SemiBold"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="T" Property="Foreground" Value="{DynamicResource Token.Disabled}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="Segmented" TargetType="ListBox">
   <Setter Property="BorderBrush" Value="{DynamicResource Token.Border.Strong}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Background" Value="{DynamicResource Token.Paper}"/><Setter Property="HorizontalAlignment" Value="Left"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ListBox">
      <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="6" Padding="1">
       <ItemsPresenter/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></Setter.Value></Setter>
   <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentedItem}"/>
  </Style>
  <!-- The shape selector; DXF opens the import draft. -->
  <Style x:Key="ShapeItem" TargetType="ListBoxItem" BasedOn="{StaticResource SegmentedItem}">
   <Setter Property="IsEnabled" Value="{Binding Available}"/>
   <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Available}" Value="False"><Setter Property="ToolTip" Value="{Binding Note}"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <!-- The bar of the utilization: filled up to η (1 = full), green within 1, red beyond. -->
  <Style x:Key="Meter" TargetType="ProgressBar">
   <Setter Property="Height" Value="7"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="1"/>
   <Setter Property="Background" Value="{DynamicResource Token.Calculated}"/><Setter Property="Foreground" Value="{DynamicResource Token.Status.Ok}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ProgressBar">
      <Grid>
       <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}"/>
       <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- The editors of a field: text box, choice and check box (the same bindings as FieldForm). -->
  <DataTemplate x:Key="TextEditor" DataType="{x:Type forms:FieldViewModel}">
   <TextBox x:Name="Box" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" MinHeight="21" Margin="1" FontWeight="Normal"
    Background="{DynamicResource Token.Field.Background}" IsReadOnly="{Binding IsInputReadOnly, Mode=OneWay}" ToolTip="{Binding LabelToolTip}"
    AutomationProperties.Name="{Binding LabelToolTip, Mode=OneWay}" IsKeyboardFocusWithinChanged="Editor_FocusChanged"/>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding IsReadOnly}" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Token.Calculated}"/></DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="ChoiceEditor" DataType="{x:Type forms:FieldViewModel}">
   <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" IsEnabled="{Binding CanChange, Mode=OneWay}" Margin="1" FontWeight="Normal"
    ToolTip="{Binding LabelToolTip}" AutomationProperties.Name="{Binding LabelToolTip, Mode=OneWay}"/>
  </DataTemplate>
  <DataTemplate x:Key="BoolEditor" DataType="{x:Type forms:FieldViewModel}">
   <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanChange, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
    ToolTip="{Binding LabelToolTip}" AutomationProperties.Name="{Binding LabelToolTip, Mode=OneWay}"/>
  </DataTemplate>
  <Style x:Key="Editor" TargetType="ContentControl">
   <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="ContentTemplate" Value="{StaticResource TextEditor}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="Choice"><Setter Property="ContentTemplate" Value="{StaticResource ChoiceEditor}"/></DataTrigger>
    <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="Bool"><Setter Property="ContentTemplate" Value="{StaticResource BoolEditor}"/></DataTrigger>
    <Trigger Property="Content" Value="{x:Null}"><Setter Property="ContentTemplate" Value="{x:Null}"/></Trigger>
   </Style.Triggers>
  </Style>
  <!-- A text box of a row (layers, combinations). -->
  <Style x:Key="RowBox" TargetType="TextBox">
   <Setter Property="TextAlignment" Value="Right"/><Setter Property="Margin" Value="1"/><Setter Property="MinHeight" Value="21"/>
   <Setter Property="Background" Value="{DynamicResource Token.Field.Background}"/>
  </Style>

  <!-- A field as a small cell: label and unit above, editor below. -->
  <DataTemplate x:Key="Cell" DataType="{x:Type forms:FieldViewModel}">
   <StackPanel Width="70" Margin="0,0,4,0">
    <StackPanel Orientation="Horizontal" ToolTip="{Binding LabelToolTip}">
     <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}"/>
     <TextBlock Text="{Binding Unit, StringFormat=' [{0}]'}" Style="{StaticResource Muted}" Visibility="{Binding HasUnit, Converter={StaticResource Visibility}}"/>
    </StackPanel>
    <ContentControl Content="{Binding}" Style="{StaticResource Editor}"/>
   </StackPanel>
  </DataTemplate>
  <!-- A value of the engine: label, value, unit. -->
  <DataTemplate x:Key="ValueRow">
   <Grid Margin="0,0,10,1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="Label" Text="{Binding Label}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
    <TextBlock x:Name="Value" Grid.Column="1" Text="{Binding Value}" TextAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="130" ToolTip="{Binding Value}"/>
    <TextBlock Grid.Column="2" Text="{Binding Unit}" Margin="3,0,0,0" Style="{StaticResource Muted}"/>
   </Grid>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding InUse}" Value="True">
     <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Token.Accent}"/><Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
     <Setter TargetName="Value" Property="FontWeight" Value="Bold"/>
    </DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
  <ItemsPanelTemplate x:Key="TwoColumns"><UniformGrid Columns="2"/></ItemsPanelTemplate>
  <!-- A check of the result: its name (only when there are two), the value in evidence, the bar of the ratio and the outcome. -->
  <DataTemplate x:Key="CheckBlock">
   <StackPanel>
    <TextBlock x:Name="Heading" Text="{Binding Heading}" FontWeight="SemiBold" Foreground="{DynamicResource Token.Accent}" Margin="0,2,0,0"/>
    <TextBlock x:Name="Value" Text="{Binding Value}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,2"/>
    <Grid Margin="0,0,0,3">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ProgressBar Value="{Binding Ratio, Mode=OneWay, FallbackValue=0, TargetNullValue=0}" VerticalAlignment="Center" Margin="0,0,8,0"
      Visibility="{Binding Ratio, Converter={StaticResource Present}}">
      <ProgressBar.Style>
       <Style TargetType="ProgressBar" BasedOn="{StaticResource Meter}">
        <Style.Triggers><DataTrigger Binding="{Binding Passed}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Token.Status.Fail}"/></DataTrigger></Style.Triggers>
       </Style>
      </ProgressBar.Style>
     </ProgressBar>
     <TextBlock Grid.Column="1" Text="{Binding Detail}" TextWrapping="Wrap" MaxWidth="320"/>
    </Grid>
   </StackPanel>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding Heading}" Value=""><Setter TargetName="Heading" Property="Visibility" Value="Collapsed"/></DataTrigger>
    <DataTrigger Binding="{Binding Heading}" Value="Fessurazione"><Setter TargetName="Value" Property="FontSize" Value="18"/></DataTrigger>
    <DataTrigger Binding="{Binding Heading}" Value="Tensioni"><Setter TargetName="Value" Property="FontSize" Value="18"/></DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
  <!-- A field of a material: label, editor (the class is a choice), unit. -->
  <DataTemplate x:Key="MaterialRow" DataType="{x:Type forms:FieldViewModel}">
   <Grid Margin="0,0,0,1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LabelToolTip}"/>
    <ContentControl Grid.Column="1" Content="{Binding}" Style="{StaticResource Editor}"/>
    <TextBlock Grid.Column="2" Text="{Binding Unit}" Margin="4,0,0,0" Style="{StaticResource Muted}"/>
   </Grid>
  </DataTemplate>
  <!-- A value of a material calculated by the engine: read-only, on the background of the calculated fields. -->
  <!-- The value that the calculation uses among similar ones (the n of the method n) is in evidence, with its note under it. -->
  <DataTemplate x:Key="CalculatedRow">
   <Border x:Name="Row" Background="Transparent" CornerRadius="4" Margin="0,0,0,1">
    <StackPanel>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="Label" Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
      <Border Grid.Column="1" Background="{DynamicResource Token.Calculated}" CornerRadius="4" Margin="1" Padding="4,2" ToolTip="Calcolato dal motore">
       <TextBlock x:Name="Value" Text="{Binding Value}" TextAlignment="Right" HorizontalAlignment="Stretch"/>
      </Border>
      <TextBlock Grid.Column="2" Text="{Binding Unit}" Margin="4,0,0,0" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
     </Grid>
     <TextBlock x:Name="Note" Text="{Binding Note}" Visibility="Collapsed" Margin="4,0,4,2" FontSize="11" Foreground="{DynamicResource Token.Accent}" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding InUse}" Value="True">
     <Setter TargetName="Row" Property="Background" Value="{DynamicResource Token.Selection}"/>
     <Setter TargetName="Label" Property="FontWeight" Value="Bold"/><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Token.Accent}"/>
     <Setter TargetName="Value" Property="FontWeight" Value="Bold"/>
     <Setter TargetName="Note" Property="Visibility" Value="Visible"/>
    </DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
 </UserControl.Resources>

 <shell:MinimumSizeViewport MinimumContentWidth="{Binding SheetMinimumWidth}" MinimumContentHeight="650">
 <Grid Margin="10,8,10,8">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="410"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="420"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

  <!-- Title and shape. -->
  <Grid Grid.ColumnSpan="4" Margin="0,0,0,8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="ToggleShear" Grid.Column="3" Content="{Binding ShearToggleText}" Command="{Binding ToggleShearCommand}" Margin="10,0,0,0" Padding="10,2"
    ToolTip="Apri o richiudi il pannello taglio: i dati vengono conservati anche a pannello chiuso" AutomationProperties.Name="Apri o chiudi verifica a taglio"/>
   <TextBlock Text="Nome sezione" Style="{StaticResource Muted}" Margin="0,0,6,0"/>
   <TextBox x:Name="TitleBox" Grid.Column="1" Text="{Binding Title}" IsReadOnly="{Binding IsReadOnly}" MinHeight="22"
    ToolTip="Nome della sezione, salvato nel documento e mostrato nella scheda, nella finestra e nelle relazioni" AutomationProperties.Name="Nome della sezione"/>
   <ListBox Grid.Column="2" Style="{StaticResource Segmented}" ItemContainerStyle="{StaticResource ShapeItem}" ItemsSource="{Binding ShapeChoices}"
    SelectedValuePath="Name" SelectedValue="{Binding Shape}" IsEnabled="{Binding CanEdit}"
    Margin="10,0,0,0" ToolTip="Forma della sezione" AutomationProperties.Name="Forma della sezione"/>
  </Grid>

  <!-- The data, in the order of the input. -->
  <StackPanel Grid.Row="1">
   <Border Style="{StaticResource Card}">
    <StackPanel>
     <DockPanel Margin="0,0,0,3">
      <Button DockPanel.Dock="Right" Content="? copriferro" Style="{StaticResource Link}" Command="{Binding CoverHelpCommand}" ToolTip="Che cosa misura il copriferro c" Visibility="{Binding IsParametric, Converter={StaticResource Visibility}}"/>
      <TextBlock Text="1 · Geometria" Style="{StaticResource CardTitle}"/>
     </DockPanel>
     <ItemsControl ItemsSource="{Binding GeometryForm.Fields}" ItemTemplate="{StaticResource Cell}" Focusable="False">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     </ItemsControl>
     <StackPanel Visibility="{Binding IsDxf, Converter={StaticResource Visibility}}">
      <Button Content="Importa / sostituisci DXF…" Command="{Binding ImportDxfCommand}" Style="{StaticResource Link}" HorizontalAlignment="Left"/>
      <TextBlock Text="{Binding DxfDescription}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
      <TextBlock Text="{Binding DxfDimensions}" FontWeight="SemiBold" TextWrapping="Wrap"/>
     </StackPanel>
    </StackPanel>
   </Border>

   <Border Style="{StaticResource Card}">
    <StackPanel>
     <DockPanel Margin="0,0,0,3">
      <Button DockPanel.Dock="Right" Content="+ strato" Command="{Binding AddLayerCommand}" ToolTip="Aggiungi uno strato di barre">
       <Button.Style>
        <Style TargetType="Button" BasedOn="{StaticResource Link}">
         <Style.Triggers><DataTrigger Binding="{Binding HasLayers}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style>
       </Button.Style>
      </Button>
      <TextBlock Text="2 · Armature" Style="{StaticResource CardTitle}"/>
     </DockPanel>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,3" Visibility="{Binding IsParametric, Converter={StaticResource Visibility}}">
      <TextBlock Text="Staffe Ø [mm]" Style="{StaticResource Muted}" Margin="0,0,8,0" ToolTip="Diametro delle staffe"/>
      <ContentControl Content="{Binding StirrupField}" Style="{StaticResource Editor}" Width="60"/>
     </StackPanel>
     <!-- Layers of bars: rectangular and flanged sections. -->
     <StackPanel>
      <StackPanel.Style>
       <Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HasLayers}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
      </StackPanel.Style>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="104"/><ColumnDefinition Width="58"/><ColumnDefinition Width="46"/><ColumnDefinition Width="54"/><ColumnDefinition Width="60"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
       <TextBlock Grid.Column="1" Text="Posizione" Style="{StaticResource Muted}"/>
       <TextBlock Grid.Column="2" Text="d [mm]" Style="{StaticResource Caption}" ToolTip="Distanza dell'asse delle barre dal bordo superiore («Da sopra») o inferiore («Da sotto»)"/>
       <TextBlock Grid.Column="3" Text="n" Style="{StaticResource Caption}"/>
       <TextBlock Grid.Column="4" Text="Ø [mm]" Style="{StaticResource Caption}"/>
       <TextBlock Grid.Column="5" Text="As [cm²]" Style="{StaticResource Caption}" ToolTip="Area delle barre dello strato, calcolata dal motore"/>
      </Grid>
      <ItemsControl ItemsSource="{Binding LayerRows}" Focusable="False">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="104"/><ColumnDefinition Width="58"/><ColumnDefinition Width="46"/><ColumnDefinition Width="54"/><ColumnDefinition Width="60"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}"/>
          <ComboBox Grid.Column="1" ItemsSource="{Binding Positions}" SelectedItem="{Binding Position}" IsEnabled="{Binding CanEdit}" Margin="1"
           ToolTip="Superiore e Inferiore: a copriferro + staffa dal bordo; Da sopra e Da sotto: alla distanza d dal bordo superiore o inferiore"/>
          <TextBox Grid.Column="2" Text="{Binding Distance}" IsEnabled="{Binding UsesDistance}" IsReadOnly="{Binding IsReadOnly}" Style="{StaticResource RowBox}"
           ToolTip="Distanza dell'asse delle barre dal bordo superiore («Da sopra») o inferiore («Da sotto»)"/>
          <TextBox Grid.Column="3" Text="{Binding Count}" IsReadOnly="{Binding IsReadOnly}" Style="{StaticResource RowBox}" ToolTip="Numero delle barre dello strato"/>
          <TextBox Grid.Column="4" Text="{Binding Diameter}" IsReadOnly="{Binding IsReadOnly}" Style="{StaticResource RowBox}" ToolTip="Diametro delle barre dello strato"/>
          <Border Grid.Column="5" Background="{DynamicResource Token.Calculated}" CornerRadius="4" Margin="2,1" Padding="4,2" ToolTip="Area delle barre dello strato, calcolata dal motore">
           <TextBlock Text="{Binding Area}" TextAlignment="Right"/>
          </Border>
          <Button Grid.Column="6" Content="✕" Style="{StaticResource Link}" Command="{Binding RemoveCommand}" HorizontalAlignment="Center" ToolTip="Togli lo strato"
           AutomationProperties.Name="Togli lo strato"/>
         </Grid>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
     <StackPanel Visibility="{Binding IsDxf, Converter={StaticResource Visibility}}">
      <TextBlock Text="Barre dal DXF · coordinate dal baricentro del calcestruzzo. Staffe non importate." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"/>
      <DataGrid ItemsSource="{Binding DxfBars}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" MaxHeight="160" HorizontalScrollBarVisibility="Disabled">
       <DataGrid.Columns>
        <DataGridTextColumn Header="X [mm]" Binding="{Binding X, StringFormat={}{0:0.###}}" Width="*"/>
        <DataGridTextColumn Header="Y [mm]" Binding="{Binding Y, StringFormat={}{0:0.###}}" Width="*"/>
        <DataGridTextColumn Header="Ø [mm]" Binding="{Binding Diametro, StringFormat={}{0:0.###}}" Width="*"/>
        <DataGridTextColumn Header="As [mm²]" Binding="{Binding Area, StringFormat={}{0:0.##}}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </StackPanel>
     <!-- Rings of the circular section. -->
     <StackPanel Visibility="{Binding IsCircular, Converter={StaticResource Visibility}}">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="24"/><ColumnDefinition Width="60"/><ColumnDefinition Width="60"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
       <TextBlock Grid.Column="2" Text="n" Style="{StaticResource Caption}"/>
       <TextBlock Grid.Column="3" Text="Ø [mm]" Style="{StaticResource Caption}"/>
       <TextBlock Grid.Column="4" Text="Ø st. [mm]" Style="{StaticResource Caption}" ToolTip="{Binding SecondRingLinkHelp}"/>
      </Grid>
      <ItemsControl ItemsSource="{Binding BarRows}" Focusable="False">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="24"/><ColumnDefinition Width="60"/><ColumnDefinition Width="60"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Title}"/>
          <ContentControl Grid.Column="1" Content="{Binding Enabled}" Style="{StaticResource Editor}"/>
          <ContentControl Grid.Column="2" Content="{Binding Count}" Style="{StaticResource Editor}"/>
          <ContentControl Grid.Column="3" Content="{Binding Diameter}" Style="{StaticResource Editor}"/>
          <ContentControl Grid.Column="4" Content="{Binding Link}" Style="{StaticResource Editor}"/>
         </Grid>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </StackPanel>
   </Border>

   <Border Style="{StaticResource Card}">
    <StackPanel>
     <DockPanel Margin="0,0,0,3">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <Button x:Name="ResetCombinationSettings" Content="↺" Width="26" Padding="0" Style="{StaticResource Link}" Command="{Binding ResetCombinationSettingsCommand}"
        ToolTip="Ripristina le impostazioni di tutte le combinazioni: SLU plastico, SLV elastico, SLE metodo n; segno del momento dalle sollecitazioni. Conserva nomi, stati limite, sollecitazioni, ordine e impostazioni generali."
        AutomationProperties.Name="Ripristina impostazioni delle combinazioni"/>
       <TextBlock Text="Sposta" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,2,0"/>
       <Button x:Name="MoveCombinationUp" Content="↑" Width="24" Padding="0" Style="{StaticResource Link}" Command="{Binding MoveCombinationUpCommand}"
        ToolTip="Sposta la combinazione selezionata una posizione sopra" AutomationProperties.Name="Sposta la combinazione sopra"/>
       <Button x:Name="MoveCombinationDown" Content="↓" Width="24" Padding="0" Style="{StaticResource Link}" Command="{Binding MoveCombinationDownCommand}"
        ToolTip="Sposta la combinazione selezionata una posizione sotto" AutomationProperties.Name="Sposta la combinazione sotto"/>
       <Button Content="+ combinazione" Style="{StaticResource Link}" Command="{Binding AddCombinationCommand}" ToolTip="Aggiungi una combinazione"/>
      </StackPanel>
      <TextBlock Text="3 · Sollecitazioni" Style="{StaticResource CardTitle}"/>
      <Button Content="↑" Style="{StaticResource ExcelButton}" Margin="8,0,0,0" Command="{Binding ExportExcelCommand}" AutomationProperties.Name="Esporta in Excel"
