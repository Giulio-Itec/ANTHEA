      <TextBlock Text="{Binding ShearGeometryDiameter}" Margin="0,0,0,4" Visibility="{Binding EffectiveStirrup, Converter={StaticResource Visibility}}"/>
      <ContentControl x:Name="IndependentShearDiameter" Content="{Binding ShearDiameterField}" ContentTemplate="{StaticResource ShearField}"
       Visibility="{Binding IndependentShearReinforcement, Converter={StaticResource Visibility}}"/>
      <ItemsControl ItemsSource="{Binding ShearMainFields}" ItemsPanel="{StaticResource TwoColumns}" ItemTemplate="{StaticResource ShearField}" Focusable="False"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel Language="it-IT">
      <TextBlock Text="3 · Risultati a taglio" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
      <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
       <TextBlock Text="Dir." Style="{StaticResource Muted}"/>
       <TextBlock Grid.Column="1" Text="VEd [kN]" TextAlignment="Right" Margin="0,0,16,0" Style="{StaticResource Muted}"/>
       <TextBlock Grid.Column="2" Text="VRd [kN]" TextAlignment="Right" Margin="0,0,16,0" Style="{StaticResource Muted}"/>
       <TextBlock Grid.Column="3" Text="Utilizzo η · limite 1,00" TextAlignment="Right" Style="{StaticResource Muted}"/>
      </Grid>
      <ItemsControl x:Name="ShearResultTable" ItemsSource="{Binding ShearResults}" Focusable="False">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="{DynamicResource Token.Border}" BorderThickness="0,1,0,0" Padding="0,8,0,8">
         <Grid>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Axis}" FontWeight="SemiBold" FontSize="14"/>
          <TextBlock Grid.Column="1" Text="{Binding Demand, StringFormat={}{0:F2}, TargetNullValue=—}" TextAlignment="Right" Margin="0,0,16,0" FontSize="14"/>
          <TextBlock Grid.Column="2" Text="{Binding VRd, StringFormat={}{0:F2}}" TextAlignment="Right" Margin="0,0,16,0" FontSize="14"/>
          <TextBlock x:Name="ShearUtilization" Grid.Column="3" Text="{Binding Ratio, StringFormat={}{0:F2}, TargetNullValue=—}" TextAlignment="Right" FontWeight="SemiBold" FontSize="14"/>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding ResistanceStatus}" Style="{StaticResource Muted}" Margin="0,3,16,0"/>
          <ProgressBar Grid.Row="1" Grid.Column="3" Value="{Binding Ratio, Mode=OneWay, TargetNullValue=0}" Margin="0,5,0,0"
           Visibility="{Binding Ratio, Converter={StaticResource Present}}" ToolTip="{Binding Ratio, StringFormat='Utilizzo η = {0:F2} · limite 1,00'}">
           <ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource Meter}">
            <Style.Triggers><DataTrigger Binding="{Binding Passed}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Token.Status.Fail}"/></DataTrigger></Style.Triggers>
           </Style></ProgressBar.Style>
          </ProgressBar>
         </Grid>
        </Border>
        <DataTemplate.Triggers>
         <DataTrigger Binding="{Binding Passed}" Value="True"><Setter TargetName="ShearUtilization" Property="Foreground" Value="{DynamicResource Token.Status.Ok}"/></DataTrigger>
         <DataTrigger Binding="{Binding Passed}" Value="False"><Setter TargetName="ShearUtilization" Property="Foreground" Value="{DynamicResource Token.Status.Fail}"/></DataTrigger>
        </DataTemplate.Triggers>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding ShearStatus}" TextWrapping="Wrap" Margin="0,5,0,0">
       <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ShearStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </StackPanel></Border>
    </StackPanel>
   </ScrollViewer>
  </Border>
 </Grid>
 </shell:MinimumSizeViewport>
</UserControl>
