          <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource Token.Selection}"/></DataTrigger></Style.Triggers>
         </Style></Border.Style>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="80"/><ColumnDefinition Width="120"/><ColumnDefinition Width="50"/><ColumnDefinition Width="50"/><ColumnDefinition Width="50"/><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
          <RadioButton IsChecked="{Binding IsSelected}" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="Mostra i risultati a taglio di questa combinazione"/>
          <TextBox Grid.Column="1" Text="{Binding Name}" IsReadOnly="{Binding IsReadOnly}" Style="{StaticResource RowBox}" TextAlignment="Left" ToolTip="Nome della combinazione a taglio"/>
          <ComboBox Grid.Column="2" ItemsSource="{Binding Conditions}" DisplayMemberPath="ShortLabel" SelectedValuePath="Code" SelectedValue="{Binding Condition}" IsEnabled="{Binding CanEdit}" Margin="1" MinHeight="21" FontSize="{DynamicResource Font.Small}" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Tipologia di verifica a taglio"/>
          <TextBox Grid.Column="3" Text="{Binding N}" IsReadOnly="{Binding IsReadOnly}" Style="{StaticResource RowBox}" ToolTip="N [kN], negativo a compressione"/>
          <TextBox Grid.Column="4" Text="{Binding Vx}" IsReadOnly="{Binding IsReadOnly}" Style="{StaticResource RowBox}" ToolTip="Vx [kN]" AutomationProperties.Name="Taglio Vx in kN"/>
          <TextBox Grid.Column="5" Text="{Binding Vy}" IsReadOnly="{Binding IsReadOnly}" Style="{StaticResource RowBox}" ToolTip="Vy [kN]" AutomationProperties.Name="Taglio Vy in kN"/>
          <StackPanel Grid.Column="6" Grid.ColumnSpan="2" Orientation="Horizontal" ToolTip="{Binding Status}">
           <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
            <DataTrigger Binding="{Binding Passed}" Value="True"><Setter Property="TextElement.Foreground" Value="{DynamicResource Token.Status.Ok}"/></DataTrigger>
            <DataTrigger Binding="{Binding Passed}" Value="False"><Setter Property="TextElement.Foreground" Value="{DynamicResource Token.Status.Fail}"/></DataTrigger>
           </Style.Triggers></Style></StackPanel.Style>
           <TextBlock Text="{Binding RatioX}" Width="30" TextAlignment="Center"/><TextBlock Text="{Binding RatioY}" Width="30" TextAlignment="Center"/>
          </StackPanel>
          <Button Grid.Column="8" Content="✕" Style="{StaticResource Link}" Command="{Binding RemoveCommand}" ToolTip="Togli la combinazione a taglio"/>
         </Grid>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="N, Vx, Vy di progetto [kN] · N &lt; 0 compressione" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Visibility="{Binding ShearWithLinks, Converter={StaticResource Visibility}}"><StackPanel>
      <TextBlock Text="2 · Armatura effettiva a taglio" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
