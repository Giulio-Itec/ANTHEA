     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="64"/><ColumnDefinition Width="74"/><ColumnDefinition Width="56"/><ColumnDefinition Width="56"/><ColumnDefinition Width="48"/><ColumnDefinition Width="50"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1" Text="Nome" Style="{StaticResource Muted}"/>
      <TextBlock Grid.Column="2" Text="SL" Style="{StaticResource Caption}" ToolTip="Stato limite della combinazione: SLU (plastico), SLV (elastico), SLE rara, frequente e quasi permanente (metodo n, tensioni e fessurazione); scegliendolo, modello e verifica in alto tornano quelli dello stato limite"/>
      <TextBlock Grid.Column="3" Text="N" Style="{StaticResource Caption}" ToolTip="N [kN], negativo a compressione"/>
      <TextBlock Grid.Column="4" Text="Mx" Style="{StaticResource Caption}" ToolTip="Mx [kNm]"/>
      <TextBlock Grid.Column="5" Text="My" Style="{StaticResource Caption}" ToolTip="My [kNm], usato solo con la flessione deviata"/>
      <TextBlock Grid.Column="6" Text="{Binding RatioHeader}" Style="{StaticResource Caption}" ToolTip="η (SLU, SLV), σ/σlim (SLE rara), wk/wlim o il maggiore con σ/σlim (SLE frequente e quasi permanente)"/>
     </Grid>
     <ItemsControl ItemsSource="{Binding CombinationRows}" Focusable="False">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Border CornerRadius="5" Padding="0,1">
         <Border.Style>
          <Style TargetType="Border">
           <Setter Property="Background" Value="Transparent"/>
           <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource Token.Selection}"/></DataTrigger></Style.Triggers>
          </Style>
         </Border.Style>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="64"/><ColumnDefinition Width="74"/><ColumnDefinition Width="56"/><ColumnDefinition Width="56"/><ColumnDefinition Width="48"/><ColumnDefinition Width="50"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
          <RadioButton IsChecked="{Binding IsSelected}" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="Mostra i risultati di questa combinazione"
           AutomationProperties.Name="Seleziona la combinazione"/>
          <TextBox Grid.Column="1" Text="{Binding Name}" IsReadOnly="{Binding IsReadOnly}" Style="{StaticResource RowBox}" TextAlignment="Left" ToolTip="Nome della combinazione"/>
          <ComboBox Grid.Column="2" ItemsSource="{Binding States}" SelectedValuePath="Code" SelectedValue="{Binding State}" IsEnabled="{Binding CanEdit}" Margin="1" MinHeight="21"
           FontSize="{DynamicResource Font.Small}" ToolTip="Stato limite della combinazione" AutomationProperties.Name="Stato limite della combinazione"/>
          <TextBox Grid.Column="3" Text="{Binding N}" IsReadOnly="{Binding IsReadOnly}" Style="{StaticResource RowBox}" ToolTip="N (negativo a compressione)"/>
          <TextBox Grid.Column="4" Text="{Binding Mx}" IsReadOnly="{Binding IsReadOnly}" Style="{StaticResource RowBox}" ToolTip="Mx"/>
          <TextBox Grid.Column="5" Text="{Binding My}" IsReadOnly="{Binding MyReadOnly}" ToolTip="My: usato solo con la flessione deviata">
           <TextBox.Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource RowBox}">
             <Style.Triggers><DataTrigger Binding="{Binding MyEditable}" Value="False"><Setter Property="Background" Value="{DynamicResource Token.Calculated}"/></DataTrigger></Style.Triggers>
            </Style>
           </TextBox.Style>
          </TextBox>
          <!-- The ratio of the engine as a pill: green within 1, red beyond. -->
          <Border Grid.Column="6" CornerRadius="8" Padding="6,1" Margin="4,0,0,0" HorizontalAlignment="Center" ToolTip="{Binding RatioToolTip}">
           <Border.Style>
            <Style TargetType="Border">
             <Setter Property="Background" Value="Transparent"/>
             <Style.Triggers>
              <DataTrigger Binding="{Binding Passed}" Value="True"><Setter Property="Background" Value="{DynamicResource Token.Badge.Ok}"/></DataTrigger>
              <DataTrigger Binding="{Binding Passed}" Value="False"><Setter Property="Background" Value="{DynamicResource Token.Warning.Background}"/></DataTrigger>
             </Style.Triggers>
            </Style>
           </Border.Style>
           <TextBlock Text="{Binding Ratio}">
            <TextBlock.Style>
             <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Style.Triggers>
               <DataTrigger Binding="{Binding Passed}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Token.Status.Ok}"/></DataTrigger>
               <DataTrigger Binding="{Binding Passed}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Token.Status.Fail}"/></DataTrigger>
              </Style.Triggers>
             </Style>
            </TextBlock.Style>
           </TextBlock>
          </Border>
          <Button Grid.Column="7" Content="✕" Style="{StaticResource Link}" Command="{Binding RemoveCommand}" HorizontalAlignment="Center" ToolTip="Togli la combinazione"
           AutomationProperties.Name="Togli la combinazione"/>
         </Grid>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock Text="N [kN], M [kNm] · N &lt; 0 compressione · risultati della riga selezionata" Style="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
   </Border>

   <Border Style="{StaticResource Card}" ToolTip="NTC 2018 · coefficienti e diagrammi della sezione in c.a.">
    <StackPanel>
     <DockPanel Margin="0,0,0,3">
      <TextBlock DockPanel.Dock="Right" Text="NTC 2018" Style="{StaticResource Muted}"/>
      <TextBlock Text="4 · Materiali" Style="{StaticResource CardTitle}"/>
     </DockPanel>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="Calcestruzzo" Style="{StaticResource Muted}" Margin="0,0,0,2"/>
       <ItemsControl ItemsSource="{Binding ConcreteFields}" ItemTemplate="{StaticResource MaterialRow}" Focusable="False"/>
       <ItemsControl ItemsSource="{Binding ConcreteValues}" ItemTemplate="{StaticResource CalculatedRow}" Focusable="False"/>
       <ContentControl Content="{Binding CreepField}" ContentTemplate="{StaticResource MaterialRow}" Focusable="False" IsTabStop="False" Margin="0,2,0,0"/>
       <ContentControl Content="{Binding ExposureField}" ContentTemplate="{StaticResource MaterialRow}" Focusable="False" IsTabStop="False"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
       <TextBlock Text="Acciaio" Style="{StaticResource Muted}" Margin="0,0,0,2"/>
       <ItemsControl ItemsSource="{Binding SteelFields}" ItemTemplate="{StaticResource MaterialRow}" Focusable="False"/>
       <ItemsControl ItemsSource="{Binding SteelValues}" ItemTemplate="{StaticResource CalculatedRow}" Focusable="False"/>
      </StackPanel>
     </Grid>
    </StackPanel>
   </Border>
  </StackPanel>

  <!-- The calculation, the result of the selected combination and the drawing area. -->
  <DockPanel Grid.Row="1" Grid.Column="2">
   <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Grid.Row="2" Grid.ColumnSpan="5" Text="Modello e verifica della combinazione selezionata; scegliendo lo SL nella riga tornano quelli dello stato limite." Style="{StaticResource Muted}"
      Margin="0,3,0,0" TextWrapping="Wrap"/>
     <TextBlock Text="Modello" Style="{StaticResource Muted}" Margin="0,0,8,4"/>
     <ListBox Grid.Column="1" Style="{StaticResource Segmented}" ItemsSource="{Binding Models}" SelectedItem="{Binding Model}" IsEnabled="{Binding CanEdit}" Margin="0,0,0,4"
      ToolTip="Modello resistente della combinazione selezionata (SLU plastico e SLV elastico di base). Il modulo grande usa un modello per stato limite: vede quello di base." AutomationProperties.Name="Modello"/>
     <TextBlock Grid.Column="2" Text="Flessione" Style="{StaticResource Muted}" Margin="14,0,8,4"/>
     <ListBox Grid.Column="3" Style="{StaticResource Segmented}" ItemsSource="{Binding Bendings}" SelectedItem="{Binding Bending}" IsEnabled="{Binding CanEdit}" Margin="0,0,0,4"
      ToolTip="Retta: My non è usato" AutomationProperties.Name="Flessione"/>
     <TextBlock Grid.Row="1" Text="Verifica" Style="{StaticResource Muted}" Margin="0,0,8,0"/>
     <!-- The check: one list for each bending, the one of the bending shown. -->
     <ListBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource Segmented}" ItemsSource="{Binding StraightMethods}" SelectedItem="{Binding StraightMethod}"
      IsEnabled="{Binding CanEdit}" Visibility="{Binding IsStraight, Converter={StaticResource Visibility}}"
      ToolTip="Della combinazione selezionata: momento positivo o negativo (SLU, SLV), oppure tensioni con il metodo n (la combinazione diventa SLE rara)" AutomationProperties.Name="Verifica"/>
     <ListBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" ItemsSource="{Binding BiaxialMethods}" SelectedItem="{Binding BiaxialMethod}" IsEnabled="{Binding CanEdit}"
      ToolTip="Capacità allo SLU (il segno viene da Mx e My di ogni combinazione), oppure tensioni con il metodo n" AutomationProperties.Name="Verifica">
      <ListBox.Style>
       <Style TargetType="ListBox" BasedOn="{StaticResource Segmented}">
        <Style.Triggers><DataTrigger Binding="{Binding IsStraight}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
       </Style>
      </ListBox.Style>
     </ListBox>
    </Grid>
   </Border>

   <!-- The result in evidence. -->
   <Border DockPanel.Dock="Top" Style="{StaticResource Card}" BorderBrush="{DynamicResource Token.Accent}">
    <StackPanel>
     <StackPanel Visibility="{Binding Summary, Converter={StaticResource Present}}">
      <TextBlock Text="{Binding Summary.Title}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary.Title}"/>
      <!-- One check, or two of the same importance (quasi-permanent: cracking and stresses), each with its value, bar and outcome. -->
      <ContentControl Content="{Binding Summary}" ContentTemplate="{StaticResource CheckBlock}" Focusable="False" IsTabStop="False"/>
      <ContentControl Content="{Binding Summary.Secondary}" ContentTemplate="{StaticResource CheckBlock}" Focusable="False" IsTabStop="False"
       Visibility="{Binding Summary.Secondary, Converter={StaticResource Present}}" Margin="0,2,0,0"/>
      <Border Padding="8,1" CornerRadius="8" HorizontalAlignment="Left" Visibility="{Binding IsDuctile, Converter={StaticResource Present}}">
       <Border.Style>
        <Style TargetType="Border">
         <Setter Property="Background" Value="{DynamicResource Token.Warning.Background}"/>
         <Style.Triggers><DataTrigger Binding="{Binding IsDuctile}" Value="True"><Setter Property="Background" Value="{DynamicResource Token.Badge.Ok}"/></DataTrigger></Style.Triggers>
        </Style>
       </Border.Style>
       <TextBlock Text="{Binding Summary.Behaviour}" TextWrapping="Wrap">
        <TextBlock.Style>
         <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
          <Setter Property="Foreground" Value="{DynamicResource Token.Status.Fail}"/>
          <Style.Triggers><DataTrigger Binding="{Binding IsDuctile}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Token.Status.Ok}"/></DataTrigger></Style.Triggers>
         </Style>
        </TextBlock.Style>
       </TextBlock>
      </Border>
     </StackPanel>
     <ItemsControl ItemsSource="{Binding ResultValues}" ItemsPanel="{StaticResource TwoColumns}" ItemTemplate="{StaticResource ValueRow}" Focusable="False" Margin="0,6,0,0"/>
     <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
     <ItemsControl ItemsSource="{Binding Errors}" Focusable="False">
      <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource Token.Warning.Foreground}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </Border>

   <!-- The drawing area: section, domain or moment–curvature. -->
   <Border Style="{StaticResource Card}" Margin="0">
    <DockPanel>
     <!-- 19/11/2026: «Centra sezione» brings the section back to the middle of the drawing at its full size (as the double click), after zoom and drags. -->
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <Button x:Name="CenterSection" DockPanel.Dock="Bottom" Content="⌖ Centra sezione" Style="{StaticResource Link}" HorizontalAlignment="Right" Margin="0,4,0,0" Click="CenterSection_Click"
       ToolTip="Riporta la sezione al centro del disegno, alla dimensione intera (come il doppio clic)" AutomationProperties.Name="Centra sezione"
       Visibility="{Binding ShowsSection, Converter={StaticResource Visibility}}"/>
      <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding Displays}" SelectedItem="{Binding Display}" HorizontalAlignment="Left"
       ToolTip="Sezione, dominio, momento–curvatura o disposizione delle azioni in 3D" AutomationProperties.Name="Mostra"/>
     </DockPanel>
     <Grid>
      <ContentControl x:Name="DrawingHost" Focusable="False" Visibility="{Binding ShowsSection, Converter={StaticResource Visibility}}"/>
      <ContentControl x:Name="ChartHost" Focusable="False" Visibility="{Binding ShowsChart, Converter={StaticResource Visibility}}"/>
      <Grid x:Name="ActionsPanel" Visibility="{Binding ShowsActions, Converter={StaticResource Visibility}}">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
       <Grid Margin="0,2,0,6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ListBox x:Name="ActionsSourceSelector" Style="{StaticResource Segmented}" ItemsSource="{Binding ActionSources}" SelectedItem="{Binding ActionsSource}" AutomationProperties.Name="Tabella delle azioni 3D"/>
        <ComboBox x:Name="ActionsCombinationSelector" Grid.Column="1" ItemsSource="{Binding ActionCombinations}" DisplayMemberPath="Name" SelectedValuePath="Id"
         SelectedValue="{Binding ActionCombinationId}" Margin="8,0" MinWidth="65" AutomationProperties.Name="Combinazione delle azioni 3D"/>
        <Button x:Name="CenterActions" Grid.Column="2" Content="⌖ Centra vista" Style="{StaticResource Link}" Click="CenterActions_Click" AutomationProperties.Name="Centra vista 3D"/>
       </Grid>
       <ContentControl x:Name="ActionsHost" Grid.Row="1" Focusable="False" MinHeight="220"/>
      </Grid>
     </Grid>
    </DockPanel>
   </Border>
  </DockPanel>
  <Border x:Name="ShearPanel" Grid.Row="1" Grid.Column="3" Width="510" Margin="10,0,0,0" BorderThickness="1,0,0,0" Padding="10,0,0,0"
   BorderBrush="{DynamicResource Token.Border.Strong}" Visibility="{Binding ShearExpanded, Converter={StaticResource Visibility}}">
   <Border.Resources>
    <DataTemplate x:Key="ShearField" DataType="{x:Type forms:FieldViewModel}">
     <Grid Margin="0,0,8,4" Visibility="{Binding IsVisible, Converter={StaticResource Visibility}}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Label}" Style="{StaticResource Muted}"/>
       <TextBlock Text="{Binding Unit, StringFormat=' [{0}]'}" Style="{StaticResource Muted}" Visibility="{Binding HasUnit, Converter={StaticResource Visibility}}"/>
      </StackPanel>
      <ContentControl Grid.Column="1" Content="{Binding}" Style="{StaticResource Editor}"/>
     </Grid>
    </DataTemplate>
   </Border.Resources>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,10,0">
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="Verifica a taglio" FontSize="16" FontWeight="SemiBold"/>
