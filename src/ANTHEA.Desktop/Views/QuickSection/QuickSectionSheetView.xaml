      <TextBlock Text="Modello della combinazione selezionata" Style="{StaticResource Muted}" Margin="0,4,0,3"/>
      <ListBox x:Name="ShearModelSelector" Style="{StaticResource Segmented}" ItemsSource="{Binding ShearModels}" SelectedItem="{Binding ShearModel}" IsEnabled="{Binding CanEditSelectedShear}" AutomationProperties.Name="Modello di calcolo a taglio">
       <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="190"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel>
      <DockPanel Margin="0,0,0,4">
       <Button x:Name="ResetShearConditions" DockPanel.Dock="Right" Content="↺" Width="26" Padding="0" Style="{StaticResource Link}" Command="{Binding ResetShearConditionsCommand}" ToolTip="Ripristina soltanto il modello armato/non armato di tutte le combinazioni secondo la tipologia scelta nella tabella. Conserva sollecitazioni, armatura e altri parametri." AutomationProperties.Name="Ripristino condizioni a taglio"/>
       <TextBlock Text="1 · Combinazioni a taglio" Style="{StaticResource CardTitle}"/>
       <Button x:Name="ExportShearExcel" Content="↑" Style="{StaticResource ExcelButton}" Margin="8,0,0,0" Command="{Binding ExportShearExcelCommand}" ToolTip="Esporta in Excel le combinazioni a taglio" AutomationProperties.Name="Esporta taglio in Excel"/>
       <Button x:Name="ImportShearExcel" Content="↓" Style="{StaticResource ExcelButton}" Command="{Binding ImportShearExcelCommand}" ToolTip="Importa da Excel: rilegge il file esportato dopo Ctrl+S e sostituisce soltanto le combinazioni a taglio" AutomationProperties.Name="Importa taglio da Excel" HorizontalAlignment="Left"/>
      </DockPanel>
      <DockPanel Margin="0,0,0,5">
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="↑" Style="{StaticResource Link}" Command="{Binding MoveShearUpCommand}" ToolTip="Sposta sopra la combinazione a taglio"/>
        <Button Content="↓" Style="{StaticResource Link}" Command="{Binding MoveShearDownCommand}" ToolTip="Sposta sotto la combinazione a taglio"/>
        <Button Content="+ combo" Style="{StaticResource Link}" Command="{Binding AddShearCombinationCommand}"/>
       </StackPanel>
       <Button x:Name="CopyShearCombinations" Content="Copia combinazioni" Command="{Binding CopyShearCombinationsCommand}" HorizontalAlignment="Left" Padding="7,2"
        ToolTip="Copia nomi e N dal momento. Aggiorna le righe già copiate conservando Vx, Vy e tipologia di verifica; mantiene le righe aggiunte qui. I momenti copiati sono usati solo dai modelli che li richiedono."/>
      </DockPanel>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="80"/><ColumnDefinition Width="120"/><ColumnDefinition Width="50"/><ColumnDefinition Width="50"/><ColumnDefinition Width="50"/><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
       <TextBlock Grid.Column="1" Text="Nome" Style="{StaticResource Muted}"/><TextBlock Grid.Column="2" Text="Verifica" Style="{StaticResource Caption}"/>
       <TextBlock Grid.Column="3" Text="N" Style="{StaticResource Caption}"/><TextBlock Grid.Column="4" Text="Vx" Style="{StaticResource Caption}"/><TextBlock Grid.Column="5" Text="Vy" Style="{StaticResource Caption}"/>
       <TextBlock Grid.Column="6" Text="ηx" Style="{StaticResource Caption}"/><TextBlock Grid.Column="7" Text="ηy" Style="{StaticResource Caption}"/>
      </Grid>
      <ItemsControl x:Name="ShearCombinations" ItemsSource="{Binding ShearCombinationRows}" Focusable="False">
