<!--
  Data templates of the retaining wall sheet (F5.9): MvvmSheetEditor finds the view of RetainingWallSheetViewModel here, and WpfDialogService
  the dialog of the values used in the calculation (RetainingWallParametersViewModel, decision MU10). The soil transfer dialog is the shared one
  of Views/Shared/SoilTransferTemplates.xaml (T5).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:X.Desktop.Views.RetainingWall"
 xmlns:wall="clr-namespace:Anthea.Presentation.Modules.RetainingWall;assembly=ANTHEA.Presentation">
 <DataTemplate DataType="{x:Type wall:RetainingWallSheetViewModel}"><views:RetainingWallSheetView/></DataTemplate>
 <DataTemplate DataType="{x:Type wall:RetainingWallParametersViewModel}"><views:RetainingWallParametersView/></DataTemplate>
</ResourceDictionary>
