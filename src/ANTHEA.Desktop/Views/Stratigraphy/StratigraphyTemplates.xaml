<!--
  Data templates of the stratigraphy (F5.6b): MvvmSheetEditor finds the view of StratigraphySheetViewModel here; the editor of a document
  (the sheet and the preview of an AI draft) and the dialog of the AI import, which WpfDialogService shows (1200×850 as the historic
  window, frame included).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:X.Desktop.Views.Stratigraphy"
 xmlns:strat="clr-namespace:Anthea.Presentation.Modules.Stratigraphy;assembly=ANTHEA.Presentation">
 <DataTemplate DataType="{x:Type strat:StratigraphySheetViewModel}"><views:StratigraphySheetView/></DataTemplate>
 <DataTemplate DataType="{x:Type strat:StratigraphyEditorViewModel}"><views:StratigraphyEditorView/></DataTemplate>
 <DataTemplate DataType="{x:Type strat:StratigraphyImportDialogViewModel}"><views:StratigraphyImportDialogView/></DataTemplate>
</ResourceDictionary>
