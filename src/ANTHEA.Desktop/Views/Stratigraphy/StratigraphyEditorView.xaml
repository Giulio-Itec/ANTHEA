<UserControl x:Class="X.Desktop.Views.Stratigraphy.StratigraphyEditorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:X.Desktop.Views.Stratigraphy"
 xmlns:strat="clr-namespace:Anthea.Presentation.Modules.Stratigraphy;assembly=ANTHEA.Presentation">
 <UserControl.Resources>
  <views:SoilColorConverter x:Key="SoilColor"/>
  <views:NullVisibilityConverter x:Key="WhenSet"/>
  <views:TextToolTipConverter x:Key="TextToolTip"/>
  <BooleanToVisibilityConverter x:Key="Visible"/>

  <!-- Texts: Ui.Text of the historic view (wrapping, vertically centred, ink); 12 → Font.Small. -->
  <Style x:Key="Text" TargetType="TextBlock">
   <Setter Property="FontSize" Value="{DynamicResource Font.Small}"/>
   <Setter Property="Foreground" Value="{DynamicResource Token.Ink}"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- Headings of the historic view: 23 → Font.Title (D9), 16 → Font.Heading, 14 → Font.Subheading, semibold. -->
  <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource Text}">
   <Setter Property="FontSize" Value="{DynamicResource Font.Title}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Text}">
   <Setter Property="FontSize" Value="{DynamicResource Font.Heading}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Subheading" TargetType="TextBlock" BasedOn="{StaticResource Text}">
   <Setter Property="FontSize" Value="{DynamicResource Font.Subheading}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <!-- Ui.Button: a light button. -->
  <Style x:Key="Command" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource Token.Paper}"/>
   <Setter Property="Foreground" Value="{DynamicResource Token.Ink}"/>
  </Style>
  <Style x:Key="Option" TargetType="CheckBox">
   <Setter Property="Margin" Value="0,4,0,8"/>
   <Setter Property="Foreground" Value="{DynamicResource Token.Ink}"/>
  </Style>
  <Style x:Key="Form" TargetType="ContentControl">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="IsTabStop" Value="False"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Stretch"/>
  </Style>

  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource Token.Paper}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Token.Border}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <DataTemplate x:Key="TextEditor">
   <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputReadOnly}"
    IsEnabled="{Binding IsEnabled}" AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Label}"
    FontSize="{DynamicResource Font.Small}" Margin="3" MinHeight="28" MaxHeight="64" AcceptsReturn="{Binding Multiline}" TextWrapping="Wrap" VerticalContentAlignment="Center"
    KeyDown="Field_KeyDown" GotKeyboardFocus="Field_Focus" LostKeyboardFocus="Field_Focus"/>
  </DataTemplate>
  <DataTemplate x:Key="ChoiceEditor">
   <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" IsEnabled="{Binding CanChange}"
    AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Label}" Margin="3" MinHeight="28"
    FontSize="{DynamicResource Font.Small}" KeyDown="Field_KeyDown"/>
  </DataTemplate>
  <DataTemplate x:Key="GeneralField">
   <StackPanel Margin="0,0,12,8">
    <TextBlock Style="{StaticResource Text}" Text="{Binding Label}" MinHeight="32"/>
    <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch">
     <ContentControl.Style><Style TargetType="ContentControl">
      <Setter Property="ContentTemplate" Value="{StaticResource TextEditor}"/>
      <Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="Choice"><Setter Property="ContentTemplate" Value="{StaticResource ChoiceEditor}"/></DataTrigger></Style.Triggers>
     </Style></ContentControl.Style>
    </ContentControl>
   </StackPanel>
  </DataTemplate>
  <Style x:Key="LayerHeader" TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="{DynamicResource Token.CommandBar}"/>
   <Setter Property="Foreground" Value="{DynamicResource Token.OnCommandBar}"/>
   <Setter Property="FontSize" Value="{DynamicResource Font.Small}"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="5"/>
   <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/></DataTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>


 <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
 <StackPanel x:Name="Columns" Margin="16">
 <Border Style="{StaticResource Card}"><StackPanel>     <TextBlock Style="{StaticResource Title}" Text="Stratigrafia del terreno"/>
     <StackPanel>
      <Button x:Name="ImportButton" Content="Importa relazione PDF con AI…" Style="{StaticResource Command}"
       Visibility="{Binding ImportVisible, Converter={StaticResource Visible}}"
       Command="{Binding DataContext.ImportCommand, RelativeSource={RelativeSource AncestorType=views:StratigraphySheetView}, FallbackValue={x:Null}}"
       ToolTip="{Binding DataContext.ImportToolTip, RelativeSource={RelativeSource AncestorType=views:StratigraphySheetView}, Converter={StaticResource TextToolTip}, FallbackValue={x:Null}}"
       ToolTipService.ShowOnDisabled="True"/>
      <ItemsControl x:Name="GeneralForm" ItemsSource="{Binding GeneralForm.Fields}" ItemTemplate="{StaticResource GeneralField}">
<ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
      <TextBlock Style="{StaticResource Text}" Text="Origine delle profondità: piano campagna (0 m). Un solo livello di falda; nessuna modellazione artesiana o di falde sospese."/>
     </StackPanel>
     <TextBlock Style="{StaticResource Heading}" Text="Strati · dall’alto verso il basso"/>
<DataGrid x:Name="LayerList" ItemsSource="{Binding TableRows}" SelectedIndex="{Binding SelectedLayerIndex}"
 AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
 SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" FrozenColumnCount="1"
 EnableRowVirtualization="False" EnableColumnVirtualization="False" ColumnHeaderStyle="{StaticResource LayerHeader}"
 RowHeight="44" ColumnHeaderHeight="54" MinHeight="100" MaxHeight="300"
 Background="{DynamicResource Token.Paper}" Foreground="{DynamicResource Token.Ink}" BorderBrush="{DynamicResource Token.Border}"
 GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource Token.Border}" VerticalGridLinesBrush="{DynamicResource Token.Border}"
 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
 <DataGrid.Columns>
 <DataGridTemplateColumn Header="Strato" Width="2*" MinWidth="170">
  <DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel>
   <Border Width="14" Height="14" Margin="6,0,2,0" Background="{Binding Color, Converter={StaticResource SoilColor}, FallbackValue={StaticResource Token.Muted}}" BorderBrush="{DynamicResource Token.Muted}" BorderThickness="1"/>
   <ContentControl Content="{Binding Identity[name]}" ContentTemplate="{StaticResource TextEditor}" VerticalAlignment="Center" HorizontalContentAlignment="Stretch"/>
  </DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
 </DataGridTemplateColumn>
<DataGridTemplateColumn Header="Terreno" Width="*" MinWidth="115"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Identity[behavior]}" ContentTemplate="{StaticResource ChoiceEditor}" VerticalAlignment="Center" HorizontalContentAlignment="Stretch"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Spessore S&#10;[m]" Width="*" MinWidth="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><ContentControl Content="{Binding Thickness[thickness]}" ContentTemplate="{StaticResource TextEditor}" VerticalAlignment="Center" HorizontalContentAlignment="Stretch" Visibility="{Binding Thickness, Converter={StaticResource WhenSet}}"/><TextBlock Text="∞" Style="{StaticResource Text}" HorizontalAlignment="Center" ToolTip="Ultimo strato esteso indefinitamente" Visibility="{Binding IsInfinite, Converter={StaticResource Visible}}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Peso γ&#10;[kN/m³]" Width="*" MinWidth="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Means[gamma]}" ContentTemplate="{StaticResource TextEditor}" VerticalAlignment="Center" HorizontalContentAlignment="Stretch"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Peso saturo γsat&#10;[kN/m³]" Width="*" MinWidth="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Means[gamma_sat]}" ContentTemplate="{StaticResource TextEditor}" VerticalAlignment="Center" HorizontalContentAlignment="Stretch"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Attrito φ′&#10;[°]" Width="*" MinWidth="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Means[phi]}" ContentTemplate="{StaticResource TextEditor}" VerticalAlignment="Center" HorizontalContentAlignment="Stretch"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Coesione c′&#10;[kPa]" Width="*" MinWidth="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Means[c]}" ContentTemplate="{StaticResource TextEditor}" VerticalAlignment="Center" HorizontalContentAlignment="Stretch"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Resistenza cu&#10;[kPa]" Width="*" MinWidth="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Means[cu]}" ContentTemplate="{StaticResource TextEditor}" VerticalAlignment="Center" HorizontalContentAlignment="Stretch"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
</DataGrid.Columns></DataGrid>     <WrapPanel x:Name="Actions">
      <Button Content="+ Strato" Style="{StaticResource Command}" Command="{Binding AddLayerCommand}"/>
      <Button Content="Duplica" Style="{StaticResource Command}" Command="{Binding DuplicateLayerCommand}"/>
      <Button Content="Elimina" Style="{StaticResource Command}" Command="{Binding RemoveLayerCommand}"/>
      <Button Content="↑" Style="{StaticResource Command}" Command="{Binding MoveLayerUpCommand}"/>
      <Button Content="↓" Style="{StaticResource Command}" Command="{Binding MoveLayerDownCommand}"/>
     </WrapPanel>

 <TextBlock Style="{StaticResource Text}" Text="Parametri medi. Una cella vuota indica un dato non disponibile. Seleziona una riga per i dettagli e i valori minimi."/>
 </StackPanel></Border><Border x:Name="ProfileCard" Style="{StaticResource Card}"><StackPanel>
<TextBlock Style="{StaticResource Heading}" Text="Profilo stratigrafico · profondità [m]" Margin="0,0,0,8"/>
<ContentControl x:Name="ProfileHost" Height="360" Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
<TextBlock Style="{StaticResource Text}" Text="Origine: piano campagna (0 m). Seleziona uno strato nel profilo per modificarne i dati."/>
<TextBlock x:Name="StatusText" Style="{StaticResource Text}" Text="{Binding Status}" Margin="0,8,0,0"/>
</StackPanel></Border><Border Style="{StaticResource Card}" Visibility="{Binding LayerForm, Converter={StaticResource WhenSet}}">     <StackPanel x:Name="LayerFields" Visibility="{Binding LayerForm, Converter={StaticResource WhenSet}}">
      <TextBlock Style="{StaticResource Heading}" Margin="0,0,0,8"><Run Text="Dettagli dello strato: "/><Run Text="{Binding LayerForm[name].EditText, Mode=OneWay}"/></TextBlock>
<ContentControl x:Name="DescriptionForm" Style="{StaticResource Form}" Content="{Binding DescriptionForm}"/>
<Expander x:Name="Advanced" Header="Classificazione, fonti e valori minimi" Margin="0,8,0,0" Foreground="{DynamicResource Token.Ink}"><StackPanel Margin="0,8,0,0">
      <ContentControl x:Name="IdentityForm" Style="{StaticResource Form}" Content="{Binding LayerForm}"/>
      <TextBlock Style="{StaticResource Text}" Text="Per terreni misti scegli la componente prevalente e specifica la miscela nella descrizione. Il retino è una convenzione grafica, non assegna parametri."/>

      <CheckBox x:Name="InfiniteOption" Style="{StaticResource Option}" Content="{x:Static strat:StratigraphyFields.InfiniteLabel}"
       IsChecked="{Binding IsInfinite, Mode=OneWay}" Command="{Binding ToggleInfiniteCommand}"/>

      <CheckBox x:Name="MinimaOption" Style="{StaticResource Option}" Content="{x:Static strat:StratigraphyFields.MinimaLabel}"
       IsChecked="{Binding HasMinimum, Mode=OneWay}" Command="{Binding ToggleMinimumCommand}"/>
      <Grid x:Name="Parameters">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,8,0">
        <TextBlock Style="{StaticResource Subheading}" Text="Fonti dei valori medi"/>
        <ContentControl x:Name="MeansForm" Style="{StaticResource Form}" Content="{Binding MeansForm}"/>
       </StackPanel>
       <StackPanel Grid.Column="1" Margin="8,0,0,0">
        <TextBlock Style="{StaticResource Subheading}" Text="Valori minimi · opzionali"/>
        <ContentControl x:Name="MinimaForm" Style="{StaticResource Form}" Content="{Binding MinimaForm}"/>
        <TextBlock x:Name="MinimaNote" Style="{StaticResource Text}" Text="{Binding MinimaNote, Mode=OneWay}"
         Visibility="{Binding MinimaForm, Converter={StaticResource WhenSet}, ConverterParameter=Invert}"/>
       </StackPanel>
      </Grid>
      <TextBlock Style="{StaticResource Text}" Text="Vuoto = dato non disponibile. Nessuna correlazione automatica o applicazione di coefficienti parziali."/>
      <ContentControl x:Name="NotesForm" Style="{StaticResource Form}" Content="{Binding NotesForm}"/>
      </StackPanel></Expander>
     </StackPanel>
</Border>
 </StackPanel></ScrollViewer>
</UserControl>
