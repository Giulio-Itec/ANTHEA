<!--
  Data templates and styles of the draft of the new shell (F5.13 c, for the user's checkpoint on the layout; docs/refactoring/f5-13-shell.md,
  section «Bozza della disposizione per il punto di controllo»). Merged by ShellWindow and DetachedShellWindow, not by App.xaml: the Release
  keeps MainWindow. One template per ViewModel type (decision Q3): the pages of the navigation (home, «Moduli singoli», «Progetti»,
  «Modelli», «Esempi»), the tabs (a sheet shows the view of its module, found by type in the application resources; the Wiki and the models
  their own view), the revision bar, the status line of the shared data, the notice of the linked model, the nodes of the tree. Texts,
  orders and conditions come from the ViewModels (the historic ones of MainWindow); colours and font sizes are theme tokens only (P7).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:X.Desktop.Views.Shell"
 xmlns:examples="clr-namespace:X.Desktop.Views.Examples"
 xmlns:ex="clr-namespace:Anthea.Presentation.Examples;assembly=ANTHEA.Presentation"
 xmlns:nav="clr-namespace:Anthea.Presentation.Shell.Navigation;assembly=ANTHEA.Presentation"
 xmlns:proj="clr-namespace:Anthea.Presentation.Shell.Projects;assembly=ANTHEA.Presentation"
 xmlns:tabs="clr-namespace:Anthea.Presentation.Shell.Tabs;assembly=ANTHEA.Presentation"
 xmlns:cmd="clr-namespace:Anthea.Presentation.Shell.Commands;assembly=ANTHEA.Presentation"
 xmlns:shell="clr-namespace:Anthea.Presentation.Shell;assembly=ANTHEA.Presentation"
 xmlns:hosting="clr-namespace:X.Desktop">

 <BooleanToVisibilityConverter x:Key="WhenTrue"/>
 <views:InverseVisibilityConverter x:Key="WhenFalse"/>
 <views:PresenceVisibilityConverter x:Key="WhenPresent"/>
 <views:AllVisibleConverter x:Key="AllTrue"/>
 <views:TypeVisibilityConverter x:Key="OfType"/>
 <views:ShortcutTextConverter x:Key="Shortcut"/>
 <views:ModuleIconConverter x:Key="ModuleIcon"/>

 <!-- Texts (Ui.Text of the historic shell): body, muted, headings, titles of the pages. -->
 <Style x:Key="Shell.Text" TargetType="TextBlock">
  <Setter Property="FontSize" Value="{DynamicResource Font.Body}"/>
  <Setter Property="Foreground" Value="{DynamicResource Token.Ink}"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
 </Style>
 <Style x:Key="Shell.Muted" TargetType="TextBlock" BasedOn="{StaticResource Shell.Text}">
  <Setter Property="Foreground" Value="{DynamicResource Token.Muted}"/>
 </Style>
 <Style x:Key="Shell.Heading" TargetType="TextBlock" BasedOn="{StaticResource Shell.Text}">
  <Setter Property="FontSize" Value="{DynamicResource Font.Heading}"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <Style x:Key="Shell.Title" TargetType="TextBlock" BasedOn="{StaticResource Shell.Text}">
  <Setter Property="FontSize" Value="{DynamicResource Font.Title}"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <Style x:Key="Shell.Display" TargetType="TextBlock" BasedOn="{StaticResource Shell.Text}">
  <Setter Property="FontSize" Value="{DynamicResource Font.Display}"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <Style x:Key="Shell.OnBar" TargetType="TextBlock" BasedOn="{StaticResource Shell.Text}">
  <Setter Property="Foreground" Value="{DynamicResource Token.OnCommandBar}"/>
 </Style>
 <Style x:Key="Shell.OnBarMuted" TargetType="TextBlock" BasedOn="{StaticResource Shell.Text}">
  <Setter Property="Foreground" Value="{DynamicResource Token.OnCommandBar.Muted}"/>
  <Setter Property="FontSize" Value="{DynamicResource Font.Small}"/>
 </Style>

 <!-- Ui.Paper: the cards of the pages. -->
 <Style x:Key="Shell.Card" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource Token.Paper}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Token.Border}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CornerRadius" Value="4"/>
  <Setter Property="Padding" Value="16"/>
 </Style>

 <!-- Buttons: with the implicit style of the theme (padding, margin, height, S17). -->
 <Style x:Key="Shell.Button" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource Token.Paper}"/>
  <Setter Property="Foreground" Value="{DynamicResource Token.Ink}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Token.Border.Strong}"/>
 </Style>
 <Style x:Key="Shell.Primary" TargetType="Button" BasedOn="{StaticResource Shell.Button}">
  <Setter Property="Background" Value="{DynamicResource Token.Selected}"/>
  <Setter Property="Foreground" Value="{DynamicResource Token.OnCommandBar}"/>
 </Style>
 <!-- Commands of the Navy bars (ProjectCommandButton): the colour of the bar. -->
 <Style x:Key="Shell.BarButton" TargetType="Button" BasedOn="{StaticResource Shell.Button}">
  <Setter Property="Background" Value="{DynamicResource Token.CommandBar}"/>
  <Setter Property="Foreground" Value="{DynamicResource Token.OnCommandBar}"/>
  <Setter Property="BorderBrush" Value="Transparent"/>
  <Setter Property="Height" Value="36"/>
  <Setter Property="Padding" Value="10,2"/>
  <Setter Property="Margin" Value="3"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
 </Style>
 <!-- Buttons of the navigation bar (BuildShell): 45 high, left aligned, semibold; the page on screen selected. -->
 <Style x:Key="Shell.NavButton" TargetType="Button" BasedOn="{StaticResource Shell.Button}">
  <Setter Property="Height" Value="45"/>
  <Setter Property="HorizontalContentAlignment" Value="Left"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Margin" Value="0,2"/>
  <Style.Triggers>
   <DataTrigger Binding="{Binding IsSelected}" Value="True">
    <Setter Property="Background" Value="{DynamicResource Token.Selection}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Token.Selection.Border}"/>
   </DataTrigger>
  </Style.Triggers>
 </Style>

 <!-- Tabs: header of a sheet («•» not saved, «sola lettura» of a revision) and of a page (Wiki, model); the tab with the focus is marked. -->
 <Style x:Key="Shell.TabFrame" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource Token.Surface}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Token.Border}"/>
  <Setter Property="BorderThickness" Value="1,1,1,0"/>
  <Setter Property="CornerRadius" Value="4,4,0,0"/>
  <Setter Property="Margin" Value="0,0,2,0"/>
  <Setter Property="Padding" Value="2,0"/>
  <Style.Triggers>
   <DataTrigger Binding="{Binding IsSelected}" Value="True">
    <Setter Property="Background" Value="{DynamicResource Token.Paper}"/>
   </DataTrigger>
   <DataTrigger Binding="{Binding IsActive}" Value="True">
    <Setter Property="Background" Value="{DynamicResource Token.Selection}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Token.Selection.Border}"/>
   </DataTrigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="Shell.TabButton" TargetType="Button" BasedOn="{StaticResource Shell.Button}">
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="BorderBrush" Value="Transparent"/>
  <Setter Property="Margin" Value="0"/>
  <Setter Property="Padding" Value="8,4"/>
  <Setter Property="MinHeight" Value="30"/>
 </Style>
 <ContextMenu x:Key="Shell.TabMenu" x:Shared="False">
  <MenuItem Header="{x:Static tabs:ShellWindowsViewModel.MoveLabel}" Command="{Binding PlacementTarget.Tag.MoveToNewWindowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
   CommandParameter="{Binding}"/>
  <MenuItem Header="{x:Static tabs:ShellWindowsViewModel.ReattachLabel}" Command="{Binding PlacementTarget.Tag.ReattachCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
   CommandParameter="{Binding}"/>
  <Separator/>
  <MenuItem Header="Chiudi" Command="{Binding PlacementTarget.Tag.CloseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
 </ContextMenu>
 <!-- The headers find the commands of the windows in the DataContext of the strip (ShellWindowsViewModel). -->
 <DataTemplate x:Key="Shell.SheetTabHeader" DataType="{x:Type tabs:SheetTabViewModel}">
  <Border Style="{StaticResource Shell.TabFrame}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}" ContextMenu="{StaticResource Shell.TabMenu}">
   <StackPanel Orientation="Horizontal">
    <Button Style="{StaticResource Shell.TabButton}" Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
     AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}">
     <StackPanel Orientation="Horizontal">
      <TextBlock Style="{StaticResource Shell.Text}" Text="{Binding Title}" MaxWidth="260" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
      <TextBlock Style="{StaticResource Shell.Text}" Text=" •" FontWeight="Bold" Foreground="{DynamicResource Token.Accent}" Visibility="{Binding IsUnsaved, Converter={StaticResource WhenTrue}}"
       ToolTip="Foglio non salvato"/>
     </StackPanel>
    </Button>
    <Button Style="{StaticResource Shell.TabButton}" Content="×" Padding="6,2" ToolTip="Chiudi la scheda" AutomationProperties.Name="Chiudi la scheda"
     Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
   </StackPanel>
  </Border>
 </DataTemplate>
 <DataTemplate x:Key="Shell.PageTabHeader" DataType="{x:Type tabs:PageTabViewModel}">
  <Border Style="{StaticResource Shell.TabFrame}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}" ContextMenu="{StaticResource Shell.TabMenu}">
   <StackPanel Orientation="Horizontal">
    <Button Style="{StaticResource Shell.TabButton}" Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
     AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}">
     <TextBlock Style="{StaticResource Shell.Text}" Text="{Binding Title}" FontStyle="Italic" MaxWidth="260" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
    </Button>
    <Button Style="{StaticResource Shell.TabButton}" Content="×" Padding="6,2" ToolTip="Chiudi la scheda" AutomationProperties.Name="Chiudi la scheda"
     Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
   </StackPanel>
  </Border>
 </DataTemplate>
 <views:TabHeaderTemplateSelector x:Key="Shell.TabHeader" Sheet="{StaticResource Shell.SheetTabHeader}" Page="{StaticResource Shell.PageTabHeader}"/>
 <!-- The strip of the tabs of one window: its DataContext is ShellWindowsViewModel, its items the tabs of the window. -->
 <Style x:Key="Shell.TabStrip" TargetType="ItemsControl">
  <Setter Property="ItemTemplateSelector" Value="{StaticResource Shell.TabHeader}"/>
  <Setter Property="ItemsPanel">
   <Setter.Value><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></Setter.Value>
  </Setter>
  <Setter Property="Background" Value="{DynamicResource Token.Surface}"/>
  <Setter Property="Padding" Value="8,6,8,0"/>
 </Style>

 <!-- ===================================================================================================== contents of the tabs -->
 <!--
   Small screens (night of 22-23/10, MainWindow.LoadSheetEditor and DisplayAdaptation): the view of a module that follows the window takes the whole
   tab; the others keep the minimum size of MainWindow (SheetLayout, 1120 × 600) and scroll in a smaller window.
 -->
 <DataTemplate x:Key="Shell.SheetFitting" DataType="{x:Type tabs:SheetTabViewModel}">
  <ContentPresenter Content="{Binding Content}"/>
 </DataTemplate>
 <DataTemplate x:Key="Shell.SheetScrolling" DataType="{x:Type tabs:SheetTabViewModel}">
  <views:MinimumSizeViewport x:Name="Viewport" MinimumContentWidth="{x:Static shell:SheetLayout.SheetMinimumWidth}" MinimumContentHeight="{x:Static shell:SheetLayout.SheetMinimumHeight}">
   <ContentPresenter Content="{Binding Content}"/>
  </views:MinimumSizeViewport>
 </DataTemplate>
 <DataTemplate DataType="{x:Type tabs:SheetTabViewModel}">
  <ContentControl x:Name="Sheet" Focusable="False" IsTabStop="False" Content="{Binding}" ContentTemplate="{StaticResource Shell.SheetScrolling}"
   HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <DataTemplate.Triggers>
   <DataTrigger Binding="{Binding FitsWindow}" Value="True">
    <Setter TargetName="Sheet" Property="ContentTemplate" Value="{StaticResource Shell.SheetFitting}"/>
   </DataTrigger>
  </DataTemplate.Triggers>
 </DataTemplate>
 <DataTemplate DataType="{x:Type tabs:PageTabViewModel}">
  <ContentPresenter Content="{Binding Content}"/>
 </DataTemplate>
 <DataTemplate DataType="{x:Type nav:WikiTabViewModel}">
  <views:WikiTabView/>
 </DataTemplate>
 <DataTemplate DataType="{x:Type proj:ModelTabViewModel}">
  <views:ModelTabView/>
 </DataTemplate>
 <!-- The pages of the navigation keep the minimum size of the dashboard of MainWindow (SheetLayout, 870 × 680) and scroll in a smaller window. -->
 <DataTemplate DataType="{x:Type ex:ExampleLibraryViewModel}">
  <views:MinimumSizeViewport MinimumContentWidth="{x:Static shell:SheetLayout.PageMinimumWidth}" MinimumContentHeight="{x:Static shell:SheetLayout.PageMinimumHeight}">
   <Border Padding="42,24,42,36"><examples:ExampleLibraryView/></Border>
  </views:MinimumSizeViewport>
 </DataTemplate>

 <!-- ===================================================================================================== home (MainWindow.ShowHome) -->
 <DataTemplate DataType="{x:Type nav:NavigationViewModel}">
  <views:MinimumSizeViewport MinimumContentWidth="{x:Static shell:SheetLayout.PageMinimumWidth}" MinimumContentHeight="{x:Static shell:SheetLayout.PageMinimumHeight}">
  <Grid Margin="42,24,42,36">
   <Grid.RowDefinitions><RowDefinition Height="250"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="{DynamicResource Token.CommandBar}" Margin="0,0,0,10">
    <DockPanel>
     <Image Source="pack://application:,,,/ANTHEA;component/Assets/logo.png" Width="220" Height="220" Margin="24,8,20,8" Stretch="Uniform"/>
     <StackPanel VerticalAlignment="Center" Margin="20">
      <TextBlock Style="{StaticResource Shell.Display}" Foreground="{DynamicResource Token.OnCommandBar}" Text="{x:Static nav:NavigationViewModel.HomeTitle}"/>
      <TextBlock Style="{StaticResource Shell.Text}" FontSize="{DynamicResource Font.Subheading}" Foreground="{DynamicResource Token.OnCommandBar.Muted}" Margin="0,6,0,12"
       Text="{x:Static nav:NavigationViewModel.HomeText}"/>
      <Button Style="{StaticResource Shell.Primary}" HorizontalAlignment="Left" Content="{Binding ResumeText}" Command="{Binding ResumeCommand}"
       Visibility="{Binding ResumeText, Converter={StaticResource WhenPresent}}"/>
     </StackPanel>
    </DockPanel>
   </Border>
   <ItemsControl Grid.Row="1" ItemsSource="{Binding HomeCards}" Margin="0,10,0,0">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
     <DataTemplate DataType="{x:Type nav:HomeCard}">
      <Border Style="{StaticResource Shell.Card}" Padding="34" Margin="0,0,12,0">
       <DockPanel>
        <Button DockPanel.Dock="Bottom" Style="{StaticResource Shell.Primary}" HorizontalAlignment="Left" MinWidth="185" Content="{Binding Button}"
         Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
        <StackPanel>
         <TextBlock Style="{StaticResource Shell.Display}" Text="{Binding Title}" Margin="0,0,0,24"/>
         <TextBlock Style="{StaticResource Shell.Muted}" FontSize="{DynamicResource Font.Heading}" Text="{Binding Description}" Margin="0,0,0,25"/>
         <TextBlock Style="{StaticResource Shell.Text}" FontWeight="SemiBold" Text="{Binding Badge}"/>
        </StackPanel>
       </DockPanel>
      </Border>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
  </Grid>
  </views:MinimumSizeViewport>
 </DataTemplate>

 <!-- ===================================================================================================== «Moduli singoli» (ShowModules) -->
 <DataTemplate DataType="{x:Type nav:ModuleCatalogViewModel}">
  <views:MinimumSizeViewport MinimumContentWidth="{x:Static shell:SheetLayout.PageMinimumWidth}" MinimumContentHeight="{x:Static shell:SheetLayout.PageMinimumHeight}">
  <DockPanel Margin="42,24,42,36">
   <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
    <TextBlock Style="{StaticResource Shell.Display}" Text="{x:Static nav:ModuleCatalogViewModel.Title}"/>
    <TextBlock Style="{StaticResource Shell.Muted}" Text="{x:Static nav:ModuleCatalogViewModel.Intro}"/>
   </StackPanel>
   <Border DockPanel.Dock="Left" Style="{StaticResource Shell.Card}" Width="185" Margin="0,0,16,0" VerticalAlignment="Top">
    <StackPanel>
     <TextBlock Style="{StaticResource Shell.Text}" FontWeight="SemiBold" Text="{x:Static nav:ModuleCatalogViewModel.DisciplinesTitle}" Margin="0,0,0,6"/>
     <ItemsControl ItemsSource="{Binding Disciplines}">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Button Style="{StaticResource Shell.Button}" Content="{Binding}" HorizontalContentAlignment="Left"
         Command="{Binding DataContext.SelectDisciplineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </Border>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding Areas}">
     <ItemsControl.ItemTemplate>
      <DataTemplate DataType="{x:Type nav:ModuleArea}">
       <StackPanel>
        <TextBlock Style="{StaticResource Shell.Title}" Text="{Binding Title}" Margin="0,10,0,14"/>
        <ItemsControl ItemsSource="{Binding Groups}">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type nav:ModuleGroup}">
           <StackPanel Margin="0,0,14,14">
            <Border Background="{DynamicResource Token.CommandBar}" Padding="8">
             <TextBlock Style="{StaticResource Shell.OnBar}" FontWeight="SemiBold" Text="{Binding Header}"/>
            </Border>
            <ItemsControl ItemsSource="{Binding Cards}">
             <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type nav:ModuleCard}">
               <Border Style="{StaticResource Shell.Card}" Height="200" Margin="0,0,0,8" Padding="12">
                <DockPanel>
                 <!-- «Apri», «Riprendi» for the module of the last sheet, «Dettagli» in preparation (ModuleCard.Button, night of 22-23/10). -->
                 <Button x:Name="Open" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Style="{StaticResource Shell.Primary}" Content="{Binding Button}"
                  Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}"/>
                 <!-- The icon of the module (Ui.ModuleIcon, as ShowModules today; after the checkpoint of 22/10). -->
                 <Viewbox DockPanel.Dock="Left" Width="80" Height="80" Margin="0,0,12,0" VerticalAlignment="Top" Stretch="Uniform">
                  <ContentControl Focusable="False" IsTabStop="False" Content="{Binding Icon, Converter={StaticResource ModuleIcon}}"/>
                 </Viewbox>
                 <StackPanel>
                  <TextBlock x:Name="Status" Style="{StaticResource Shell.Text}" FontSize="{DynamicResource Font.Caption}" FontWeight="SemiBold"
                   Foreground="{DynamicResource Token.Status.Ok}" Text="{Binding Status}"/>
                  <TextBlock Style="{StaticResource Shell.Heading}" Text="{Binding Title}"/>
                  <TextBlock Style="{StaticResource Shell.Muted}" FontSize="{DynamicResource Font.Small}" Text="{Binding Subtitle}"/>
                  <TextBlock Style="{StaticResource Shell.Muted}" FontSize="{DynamicResource Font.Small}" FontWeight="SemiBold" Text="{Binding Owner}"/>
                 </StackPanel>
                </DockPanel>
               </Border>
               <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                 <Setter TargetName="Open" Property="Style" Value="{StaticResource Shell.Button}"/>
                 <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Token.Muted}"/>
                </DataTrigger>
               </DataTemplate.Triggers>
              </DataTemplate>
             </ItemsControl.ItemTemplate>
            </ItemsControl>
           </StackPanel>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
  </DockPanel>
  </views:MinimumSizeViewport>
 </DataTemplate>

 <!-- ===================================================================================================== «Progetti»: overview and catalogue (ProjectPresentation) -->
 <!-- A row of the common data: label and the values of the sheets. -->
 <DataTemplate x:Key="Shell.CommonDataRow" DataType="{x:Type proj:CommonDataRow}">
  <DockPanel Margin="0,2">
   <TextBlock Style="{StaticResource Shell.Muted}" Text="{Binding Label}" Width="220"/>
   <TextBlock Style="{StaticResource Shell.Text}" Text="{Binding Value}"/>
  </DockPanel>
 </DataTemplate>
 <DataTemplate DataType="{x:Type proj:SectionOverviewViewModel}">
  <Grid Margin="14,12,14,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="47*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="30*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Shell.Card}" Padding="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <StackPanel Visibility="{Binding Section, Converter={StaticResource WhenPresent}, ConverterParameter=invert}">
       <TextBlock Style="{StaticResource Shell.Muted}" FontWeight="SemiBold" FontSize="{DynamicResource Font.Small}" Text="{x:Static proj:SectionOverviewViewModel.EmptyCaption}"/>
       <TextBlock Style="{StaticResource Shell.Title}" Text="{x:Static proj:SectionOverviewViewModel.EmptyTitle}"/>
      </StackPanel>
      <StackPanel Visibility="{Binding Section, Converter={StaticResource WhenPresent}}">
       <TextBlock Style="{StaticResource Shell.Muted}" FontWeight="SemiBold" FontSize="{DynamicResource Font.Small}" Text="{x:Static proj:SectionOverviewViewModel.Caption}"/>
       <TextBlock Style="{StaticResource Shell.Title}" Text="{Binding Name}" Margin="0,0,0,12"/>
       <!--
         After the checkpoint of 22/10, in the order of ProjectPresentation.BuildSectionOverview: «Modelli di calcolo» (AddModelsOverview) with the
         models of the section and «+ Importa un modello» outside read-only; «Controlli» with the two statuses and «Confronto e avvisi» (the dialog
         of the comparison); then the common data, the revisions with «Riepilogo modifiche», the actions, the links and «Dettaglio avvisi».
       -->
       <Border Style="{StaticResource Shell.Card}" Margin="0,0,0,10">
        <StackPanel>
         <TextBlock Style="{StaticResource Shell.Heading}" Text="{x:Static proj:SectionOverviewViewModel.ModelsTitle}" Margin="0,0,0,6"/>
         <TextBlock Style="{StaticResource Shell.Muted}" Text="{Binding ModelsText}"/>
         <ItemsControl ItemsSource="{Binding ModelButtons}">
          <ItemsControl.ItemTemplate>
           <DataTemplate DataType="{x:Type proj:OverviewModel}">
            <Button Style="{StaticResource Shell.Button}" HorizontalAlignment="Left" Content="{Binding Label}" AutomationProperties.Name="{Binding Label}"
             Command="{Binding DataContext.OpenOverviewModelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>
       </Border>
       <Border x:Name="Controls" Style="{StaticResource Shell.Card}" Margin="0,0,0,10">
        <StackPanel>
         <TextBlock Style="{StaticResource Shell.Heading}" Text="{x:Static proj:SectionOverviewViewModel.ControlsTitle}" Margin="0,0,0,10"/>
         <WrapPanel>
          <Border x:Name="Conflicts" Background="{DynamicResource Token.Badge.Ok}" CornerRadius="4" Padding="10,7" Margin="0,0,7,10">
           <TextBlock x:Name="ConflictsStatus" Style="{StaticResource Shell.Text}" FontSize="{DynamicResource Font.Small}" FontWeight="SemiBold"
            Foreground="{DynamicResource Token.Status.Coherent}" Text="{Binding ConflictsStatus}"/>
          </Border>
          <Border x:Name="Notices" Background="{DynamicResource Token.Badge.Ok}" CornerRadius="4" Padding="10,7" Margin="0,0,7,10">
           <TextBlock x:Name="NoticesStatus" Style="{StaticResource Shell.Text}" FontSize="{DynamicResource Font.Small}" FontWeight="SemiBold"
            Foreground="{DynamicResource Token.Status.Coherent}" Text="{Binding NoticesStatus}"/>
          </Border>
         </WrapPanel>
         <Button x:Name="Compare" Style="{StaticResource Shell.Button}" HorizontalAlignment="Stretch" Content="{Binding CompareLabel}" AutomationProperties.Name="{Binding CompareLabel}"
          Command="{Binding DataContext.CompareCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Section}"/>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Shell.Card}" Margin="0,0,0,10">
        <StackPanel>
         <TextBlock Style="{StaticResource Shell.Heading}" Text="Dati comuni" Margin="0,0,0,6"/>
         <TextBlock Style="{StaticResource Shell.Muted}" Text="{Binding CommonDataEmpty}" x:Name="NoCommonData" Visibility="Collapsed"/>
         <!-- The first five common data, the others in «Tutti i dati comuni», closed (after the checkpoint, ProjectPresentation as today). -->
         <ItemsControl x:Name="CommonRows" ItemsSource="{Binding FirstCommonData}" ItemTemplate="{StaticResource Shell.CommonDataRow}"/>
         <Expander x:Name="MoreCommonData" Margin="0,6,0,0" IsExpanded="False" Visibility="{Binding HasMoreCommonData, Converter={StaticResource WhenTrue}}">
          <Expander.Header><TextBlock Style="{StaticResource Shell.Text}" FontWeight="SemiBold" Text="{x:Static proj:SectionOverviewViewModel.MoreCommonDataTitle}"/></Expander.Header>
          <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
           <ItemsControl ItemsSource="{Binding MoreCommonData}" ItemTemplate="{StaticResource Shell.CommonDataRow}"/>
          </ScrollViewer>
         </Expander>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Shell.Card}" Margin="0,0,0,10">
        <StackPanel>
         <TextBlock Style="{StaticResource Shell.Heading}" Text="Revisioni" Margin="0,0,0,6"/>
         <TextBlock Style="{StaticResource Shell.Text}" FontWeight="SemiBold" Text="{Binding RevisionTitle}"/>
         <TextBlock Style="{StaticResource Shell.Muted}" Text="{Binding RevisionDate}" Visibility="{Binding RevisionDate, Converter={StaticResource WhenPresent}}"/>
         <TextBlock Style="{StaticResource Shell.Muted}" Text="{Binding RevisionNote}" Visibility="{Binding RevisionNote, Converter={StaticResource WhenPresent}}"/>
         <!-- «Riepilogo modifiche» with archived revisions (ShowProjectRevisions): the dialog of the summary of the revisions of the section. -->
         <Button Style="{StaticResource Shell.Button}" HorizontalAlignment="Left" Margin="0,10,0,6" Content="{x:Static proj:SectionOverviewViewModel.RevisionSummaryLabel}"
          Visibility="{Binding HasRevisionSummary, Converter={StaticResource WhenTrue}}"
          Command="{Binding DataContext.RevisionSummaryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding RevisionScope}"/>
        </StackPanel>
       </Border>
       <!--
         Actions and links of the section (after the checkpoint of 22/10, ProjectPresentation.BuildSectionOverview): «Duplica sezione» outside
         read-only; «Genera report» (part e: the report of the section of MainWindow.ExportSectionReport, enabled with sheets in the section or its
         subsections); the sheets open in their tab, the subsections show their overview. The commands are those of the shell (the DataContext of the window).
       -->
       <WrapPanel Margin="0,0,0,10">
        <Button Style="{StaticResource Shell.Button}" Content="{x:Static proj:SectionOverviewViewModel.DuplicateLabel}" Visibility="{Binding CanDuplicate, Converter={StaticResource WhenTrue}}"
         Command="{Binding DataContext.DuplicateSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Section}"/>
        <Button x:Name="SectionReport" Style="{StaticResource Shell.Primary}" Content="{x:Static proj:SectionOverviewViewModel.ReportLabel}"
         Command="{Binding DataContext.SectionReportCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Section}"/>
       </WrapPanel>
       <Expander x:Name="Links" Margin="0,0,0,10" IsExpanded="False" Visibility="{Binding HasLinks, Converter={StaticResource WhenTrue}}">
        <Expander.Header><TextBlock Style="{StaticResource Shell.Heading}" Text="{x:Static proj:SectionOverviewViewModel.LinksTitle}"/></Expander.Header>
        <StackPanel Margin="0,6,0,0">
         <ItemsControl ItemsSource="{Binding LinkItems}">
          <ItemsControl.ItemTemplate>
           <DataTemplate DataType="{x:Type proj:OverviewLink}">
            <Button Style="{StaticResource Shell.Button}" Content="{Binding Name}" HorizontalContentAlignment="Left" Margin="0,0,0,5" AutomationProperties.Name="{Binding Name}"
             Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Node}"/>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>
       </Expander>
       <!-- «Dettaglio avvisi», closed at the start and only with notices: «• avviso», muted (ProjectPresentation.BuildSectionOverview). -->
       <Expander x:Name="NoticeDetails" Margin="0,0,0,10" IsExpanded="False" Visibility="{Binding HasNotices, Converter={StaticResource WhenTrue}}">
        <Expander.Header><TextBlock Style="{StaticResource Shell.Heading}" Text="{x:Static proj:SectionOverviewViewModel.NoticesTitle}"/></Expander.Header>
        <ItemsControl ItemsSource="{Binding NoticeLines}">
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <TextBlock Style="{StaticResource Shell.Muted}" FontSize="{DynamicResource Font.Small}" Text="{Binding}" Margin="0,4,0,8"/>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
       </Expander>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <!-- «Schede da aggiungere» (ProjectCatalogViewModel of the shell), hidden in the preview of a revision as today. -->
   <Border Grid.Column="2" Style="{StaticResource Shell.Card}" Padding="14" DataContext="{Binding DataContext.Catalogue, RelativeSource={RelativeSource AncestorType=Window}}"
    Visibility="{Binding DataContext.Tree.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WhenFalse}}">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource Shell.Title}" Text="{x:Static proj:ProjectCatalogViewModel.Title}" Margin="0,0,0,8"/>
      <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static proj:ProjectCatalogViewModel.SearchAutomationName}" Margin="0,0,0,6"/>
      <TextBlock Style="{StaticResource Shell.Muted}" FontSize="{DynamicResource Font.Small}" Text="{x:Static proj:ProjectCatalogViewModel.Hint}" Margin="0,0,0,8"/>
      <TextBlock Style="{StaticResource Shell.Muted}" Text="{x:Static proj:ProjectCatalogViewModel.NoResults}" Visibility="{Binding HasNoResults, Converter={StaticResource WhenTrue}}"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Groups}">
       <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type proj:ProjectCatalogGroup}">
         <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpanded}" Visibility="{Binding IsVisible, Converter={StaticResource WhenTrue}}" Margin="0,0,0,6">
          <ItemsControl ItemsSource="{Binding Cards}">
           <ItemsControl.ItemTemplate>
            <!--
              A card (BuildProjectCatalog, night of 22-23/10): the icon of the module, title and subtitle, the grip; dragged on a section of the tree
              (ProjectTreeInput, a copy) or added with the double click to the selected section, opened in its tab.
            -->
            <DataTemplate DataType="{x:Type proj:ProjectCatalogCard}">
             <Border x:Name="Card" Style="{StaticResource Shell.Card}" Padding="10" MinHeight="59" Margin="0,0,0,6" Cursor="Hand" ToolTip="{Binding ToolTip}"
              Visibility="{Binding IsVisible, Converter={StaticResource WhenTrue}}" views:ProjectTreeInput.DragRow="True" AutomationProperties.Name="{Binding Title}">
              <Border.InputBindings>
               <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.AddCatalogSheetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
              </Border.InputBindings>
              <DockPanel>
               <Viewbox DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,10,0" Stretch="Uniform">
                <ContentControl Focusable="False" IsTabStop="False" Content="{Binding Module, Converter={StaticResource ModuleIcon}}"/>
               </Viewbox>
               <Path DockPanel.Dock="Right" Width="10" Height="20" Stretch="Uniform" VerticalAlignment="Center" Fill="{DynamicResource Token.Drawing.Axis}"
                Data="M 5,5 m -2,0 a 2,1.5 0 1 0 4,0 a 2,1.5 0 1 0 -4,0 M 5,12 m -2,0 a 2,1.5 0 1 0 4,0 a 2,1.5 0 1 0 -4,0 M 5,19 m -2,0 a 2,1.5 0 1 0 4,0 a 2,1.5 0 1 0 -4,0 M 15,5 m -2,0 a 2,1.5 0 1 0 4,0 a 2,1.5 0 1 0 -4,0 M 15,12 m -2,0 a 2,1.5 0 1 0 4,0 a 2,1.5 0 1 0 -4,0 M 15,19 m -2,0 a 2,1.5 0 1 0 4,0 a 2,1.5 0 1 0 -4,0"/>
               <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Shell.Text}" FontSize="{DynamicResource Font.Subheading}" FontWeight="SemiBold" Text="{Binding Title}"/>
                <TextBlock Style="{StaticResource Shell.Muted}" FontSize="{DynamicResource Font.Small}" Text="{Binding Subtitle}"/>
               </StackPanel>
              </DockPanel>
             </Border>
             <DataTemplate.Triggers>
              <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
               <Setter TargetName="Card" Property="Background" Value="{DynamicResource Token.Hover.Row}"/>
               <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Token.Selection.Border}"/>
              </Trigger>
             </DataTemplate.Triggers>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
         </Expander>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
  <DataTemplate.Triggers>
   <DataTrigger Binding="{Binding HasConflicts}" Value="True">
    <Setter TargetName="Conflicts" Property="Background" Value="{DynamicResource Token.Badge.Warn}"/>
    <Setter TargetName="ConflictsStatus" Property="Foreground" Value="{DynamicResource Token.Warning.Foreground}"/>
   </DataTrigger>
   <DataTrigger Binding="{Binding HasNotices}" Value="True">
    <Setter TargetName="Notices" Property="Background" Value="{DynamicResource Token.Badge.Warn}"/>
    <Setter TargetName="NoticesStatus" Property="Foreground" Value="{DynamicResource Token.Warning.Foreground}"/>
   </DataTrigger>
   <Trigger SourceName="CommonRows" Property="ItemsControl.HasItems" Value="False">
    <Setter TargetName="NoCommonData" Property="Visibility" Value="Visible"/>
   </Trigger>
  </DataTemplate.Triggers>
 </DataTemplate>

 <!-- ===================================================================================================== «Modelli» (ShowModelsHub) -->
 <DataTemplate DataType="{x:Type proj:ModelsPageViewModel}">
  <views:MinimumSizeViewport MinimumContentWidth="{x:Static shell:SheetLayout.PageMinimumWidth}" MinimumContentHeight="{x:Static shell:SheetLayout.PageMinimumHeight}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="42,24,42,36">
    <TextBlock Style="{StaticResource Shell.Display}" Text="{x:Static proj:ModelsPageViewModel.Title}"/>
    <TextBlock Style="{StaticResource Shell.Muted}" FontSize="{DynamicResource Font.Subheading}" Text="{x:Static proj:ModelsPageViewModel.Subtitle}"/>
    <TextBlock Style="{StaticResource Shell.Muted}" FontSize="{DynamicResource Font.Small}" FontWeight="SemiBold" Text="{x:Static proj:ModelsPageViewModel.Draft}" Margin="0,4,0,16"/>
    <StackPanel Visibility="{Binding HasProject, Converter={StaticResource WhenFalse}}">
     <TextBlock Style="{StaticResource Shell.Text}" FontSize="{DynamicResource Font.Heading}" Text="{x:Static proj:ModelsPageViewModel.NoProject}" Margin="0,0,0,10"/>
     <StackPanel Orientation="Horizontal">
      <Button Style="{StaticResource Shell.Button}" Content="{x:Static proj:ModelsPageViewModel.OpenProjectLabel}" Command="{Binding OpenProjectCommand}"/>
      <Button Style="{StaticResource Shell.Primary}" Content="{x:Static proj:ModelsPageViewModel.NewProjectLabel}" Command="{Binding NewProjectCommand}"/>
     </StackPanel>
    </StackPanel>
    <StackPanel Visibility="{Binding HasProject, Converter={StaticResource WhenTrue}}">
     <ItemsControl ItemsSource="{Binding Cards}">
      <ItemsControl.ItemTemplate>
       <DataTemplate DataType="{x:Type proj:ModelContainerCard}">
        <Border Style="{StaticResource Shell.Card}" Margin="0,0,0,10">
         <StackPanel>
          <TextBlock Style="{StaticResource Shell.Heading}" Text="{Binding Path}"/>
          <TextBlock Style="{StaticResource Shell.Muted}" Text="{Binding Summary}" Margin="0,0,0,6"/>
          <WrapPanel>
           <ItemsControl ItemsSource="{Binding Models}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
             <DataTemplate DataType="{x:Type proj:ModelLink}">
              <Button Style="{StaticResource Shell.Button}" Content="{Binding Name}" Command="{Binding DataContext.OpenModelCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
               CommandParameter="{Binding}"/>
             </DataTemplate>
            </ItemsControl.ItemTemplate>
           </ItemsControl>
           <Button Style="{StaticResource Shell.Primary}" Content="{Binding NewModel.Name}" Command="{Binding DataContext.OpenModelCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
            CommandParameter="{Binding NewModel}"/>
          </WrapPanel>
         </StackPanel>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <Button Style="{StaticResource Shell.Button}" HorizontalAlignment="Left" Content="{x:Static proj:ModelsPageViewModel.OrganizeLabel}" Command="{Binding OrganizeCommand}"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  </views:MinimumSizeViewport>
 </DataTemplate>

 <!-- ===================================================================================================== bars above the content -->
 <!-- Revision bar of the project (UpdateProjectRevisionBar). -->
 <DataTemplate DataType="{x:Type proj:RevisionBarViewModel}">
  <Border Background="{DynamicResource Token.Paper}" BorderBrush="{DynamicResource Token.Border}" BorderThickness="0,0,0,1" Padding="14,4"
   Visibility="{Binding IsVisible, Converter={StaticResource WhenTrue}}">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button Style="{StaticResource Shell.Button}" Content="{x:Static proj:RevisionBarViewModel.DeleteLabel}" ToolTip="{Binding DeleteToolTip}" Command="{Binding DeleteCommand}"/>
     <Button Style="{StaticResource Shell.Primary}" Content="{x:Static proj:RevisionBarViewModel.AddLabel}" ToolTip="{Binding AddToolTip}" Command="{Binding AddCommand}"/>
    </StackPanel>
    <TextBlock Style="{StaticResource Shell.Muted}" FontSize="{DynamicResource Font.Small}" Text="{Binding Caption}" Margin="0,0,8,0"/>
    <TextBlock Style="{StaticResource Shell.Text}" FontWeight="SemiBold" Text="{Binding ScopeName}" Margin="0,0,12,0"/>
    <ItemsControl ItemsSource="{Binding Tabs}" VerticalAlignment="Center">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate DataType="{x:Type proj:RevisionTab}">
       <Button x:Name="Revision" Style="{StaticResource Shell.Button}" Content="{Binding Label}" AutomationProperties.Name="{Binding AutomationName}"
        Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
       <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
         <Setter TargetName="Revision" Property="Style" Value="{StaticResource Shell.Primary}"/>
        </DataTrigger>
       </DataTemplate.Triggers>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Style="{StaticResource Shell.Muted}" FontSize="{DynamicResource Font.Small}" Text="{Binding Details}" Margin="12,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
   </DockPanel>
  </Border>
 </DataTemplate>
 <!-- Status line of the shared data and of the cover above the sheet (RefreshSharedStatus). -->
 <DataTemplate DataType="{x:Type proj:SharedStatusViewModel}">
  <Border x:Name="Line" Background="{DynamicResource Token.Badge.Ok}" Padding="14,5" ToolTip="{Binding ToolTip}" Visibility="{Binding IsVisible, Converter={StaticResource WhenTrue}}">
   <TextBlock x:Name="Text" Style="{StaticResource Shell.Text}" FontWeight="SemiBold" Foreground="{DynamicResource Token.Status.Coherent}" Text="{Binding Text}"/>
  </Border>
  <DataTemplate.Triggers>
   <DataTrigger Binding="{Binding IsWarning}" Value="True">
    <Setter TargetName="Line" Property="Background" Value="{DynamicResource Token.Warning.Background}"/>
    <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Token.Warning.Foreground}"/>
   </DataTrigger>
  </DataTemplate.Triggers>
 </DataTemplate>
 <!-- Notice of the model linked to the sheet (RefreshModelReference). -->
 <DataTemplate DataType="{x:Type proj:ModelReferenceViewModel}">
  <Border Background="{DynamicResource Token.Calculated}" Padding="14,5" Visibility="{Binding IsVisible, Converter={StaticResource WhenTrue}}">
   <DockPanel>
    <Button DockPanel.Dock="Right" Style="{StaticResource Shell.Button}" Content="{x:Static proj:ModelReferenceViewModel.OpenLabel}" Command="{Binding OpenCommand}"
     Visibility="{Binding CanOpen, Converter={StaticResource WhenTrue}}"/>
    <TextBlock Style="{StaticResource Shell.Text}" FontWeight="SemiBold" Text="{Binding Text}"/>
   </DockPanel>
  </Border>
 </DataTemplate>

 <!-- ===================================================================================================== tree of the project -->
 <!--
   The nodes of the tree as ProjectTreeItem and ProjectChevron of MainWindow (night of 22-23/10), with theme tokens: the arrow in the colour of the
   glyphs of the tree (Token.InkSecondary), readable in «Scuro» and «Molto scuro» (the arrows of the base template of WPF were not); rows at least 44
   high with rounded corners and a line below, the guide of the children, the row under the mouse and the selected one with its border on the left.
 -->
 <Style x:Key="Shell.TreeChevron" TargetType="ToggleButton">
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="Width" Value="20"/>
  <Setter Property="Height" Value="28"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ToggleButton">
     <Border Background="Transparent">
      <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 0 8" Stroke="{DynamicResource Token.InkSecondary}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"
       RenderTransformOrigin="0.5,0.5"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="Shell.TreeItem" TargetType="TreeViewItem">
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Background" Value="{DynamicResource Token.Paper}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Token.Divider}"/>
  <Setter Property="BorderThickness" Value="0,0,0,1"/>
  <Setter Property="Padding" Value="0"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="TreeViewItem">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="Row" Grid.ColumnSpan="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
       CornerRadius="4" MinHeight="44">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ToggleButton x:Name="Expander" Style="{StaticResource Shell.TreeChevron}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
        <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" Margin="4,3,5,3" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
       </Grid>
      </Border>
      <Border x:Name="Guide" Grid.Row="1" Margin="9,0,0,0" BorderBrush="{DynamicResource Token.TreeGuide}" BorderThickness="1,0,0,0"/>
      <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="HasItems" Value="False">
       <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
       <Setter TargetName="Guide" Property="Visibility" Value="Collapsed"/>
      </Trigger>
      <Trigger Property="IsExpanded" Value="False">
       <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
       <Setter TargetName="Guide" Property="Visibility" Value="Collapsed"/>
      </Trigger>
      <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
       <Setter TargetName="Row" Property="Background" Value="{DynamicResource Token.Hover.Row}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
       <Setter TargetName="Row" Property="Background" Value="{DynamicResource Token.Selection}"/>
       <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Token.Selection.Border}"/>
       <Setter TargetName="Row" Property="BorderThickness" Value="3,0,0,0"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
  <Style.Triggers>
   <!-- The rows of the projects on the background of the rows under the mouse, as today (ConfigureProjectNode). -->
   <DataTrigger Binding="{Binding Depth}" Value="0">
    <Setter Property="Background" Value="{DynamicResource Token.Hover.Row}"/>
   </DataTrigger>
  </Style.Triggers>
 </Style>
 <HierarchicalDataTemplate DataType="{x:Type proj:ProjectNodeViewModel}" ItemsSource="{Binding Children}">
  <!--
    Night of 22-23/10: a sheet is dragged by its row, a project or section by its name (ProjectTreeInput; the drop on the nodes is in the style of the
    nodes); a single click on the name of a project or section shows its overview after the double click time; the size of the names by depth.
  -->
  <DockPanel ToolTip="{Binding ToolTip}" MinHeight="32" views:ProjectTreeInput.DragRow="True">
   <!--
     The coherence badge of a section (ProjectSharing.AddCoherenceBadge, after the checkpoint of 22/10): the number of conflicts and notices, or «✓»,
     named by its title; it opens the comparison of the section.
   -->
   <Button x:Name="Badge" DockPanel.Dock="Right" Style="{StaticResource Shell.Button}" FontSize="{DynamicResource Font.Caption}" MinHeight="24" Padding="7,2" Margin="4,0,5,0"
    BorderThickness="0" Background="{DynamicResource Token.Badge.Ok}" Foreground="{DynamicResource Token.Status.Ok}" Content="{Binding Badge.Content}"
    ToolTip="{Binding Badge.ToolTip}" AutomationProperties.Name="{Binding Badge.Title, TargetNullValue=''}" Visibility="{Binding Badge, Converter={StaticResource WhenPresent}}"
    Command="{Binding CompareCommand}"/>
   <TextBlock Style="{StaticResource Shell.Text}" Text=" •" FontWeight="Bold" Foreground="{DynamicResource Token.Accent}" DockPanel.Dock="Right"
    Visibility="{Binding IsUnsaved, Converter={StaticResource WhenTrue}}" ToolTip="Foglio non salvato"/>
   <!--
     After the checkpoint of 22/10 (ProjectHierarchy.ConfigureProjectNode): a sheet has the button with the icon of its module, which opens it; the
     double click on the name renames in place (F2 and «Rinomina» too; ProjectTreeKeys), a model opens; Enter on the node opens it.
   -->
   <Button DockPanel.Dock="Left" Style="{StaticResource Shell.Button}" Width="36" Height="36" Padding="3" Margin="0,0,10,0" Command="{Binding OpenCommand}"
    ToolTip="{Binding OpenToolTip}" AutomationProperties.Name="{Binding OpenAutomationName, TargetNullValue=''}" Visibility="{Binding IsSheet, Converter={StaticResource WhenTrue}}">
    <Viewbox Stretch="Uniform"><ContentControl Focusable="False" IsTabStop="False" Content="{Binding Module, Converter={StaticResource ModuleIcon}}"/></Viewbox>
   </Button>
   <Grid>
    <TextBlock x:Name="Label" Style="{StaticResource Shell.Text}" FontSize="{DynamicResource Font.Subheading}" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="NoWrap"
     TextTrimming="CharacterEllipsis" Visibility="{Binding IsRenaming, Converter={StaticResource WhenFalse}}" views:ProjectTreeInput.DragName="True" views:ProjectTreeInput.SectionClick="True">
     <TextBlock.InputBindings>
      <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DoubleClickCommand}"/>
     </TextBlock.InputBindings>
    </TextBlock>
    <TextBox x:Name="Rename" MinWidth="180" Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nuovo nome"
     Visibility="{Binding IsRenaming, Converter={StaticResource WhenTrue}}" views:ProjectTreeKeys.RenameBox="True"/>
   </Grid>
   <DockPanel.ContextMenu>
    <ContextMenu>
     <MenuItem Header="Apri" Command="{Binding OpenCommand}"/>
     <!-- After the checkpoint of 22/10: a sheet also in a new window or at full page (only the sheets, read-only revisions included). -->
     <MenuItem Header="{x:Static proj:ProjectTreeViewModel.OpenInNewWindowLabel}" Command="{Binding OpenInNewWindowCommand}"
      Visibility="{Binding IsSheet, Converter={StaticResource WhenTrue}}"/>
     <MenuItem Header="{x:Static proj:ProjectTreeViewModel.OpenFullPageLabel}" Command="{Binding OpenFullPageCommand}"
      Visibility="{Binding IsSheet, Converter={StaticResource WhenTrue}}"/>
     <MenuItem Header="Rinomina" Command="{Binding BeginRenameCommand}"/>
     <MenuItem Header="Duplica" Command="{Binding DuplicateCommand}"/>
     <MenuItem Header="Sottosezione" Command="{Binding AddSectionCommand}"/>
     <MenuItem Header="Report Word della sezione" Command="{Binding ReportCommand}"/>
     <MenuItem Header="Elimina" Command="{Binding DeleteCommand}"/>
    </ContextMenu>
   </DockPanel.ContextMenu>
  </DockPanel>
  <HierarchicalDataTemplate.Triggers>
   <!-- The size of the names by depth (ConfigureProjectNode: 20, 17, 15, then 14; the sheets 14, not bold), on the typographic tokens. -->
   <DataTrigger Binding="{Binding Depth}" Value="0">
    <Setter TargetName="Label" Property="FontSize" Value="{DynamicResource Font.Title}"/>
   </DataTrigger>
   <DataTrigger Binding="{Binding Depth}" Value="1">
    <Setter TargetName="Label" Property="FontSize" Value="{DynamicResource Font.Heading}"/>
   </DataTrigger>
   <DataTrigger Binding="{Binding IsSheet}" Value="True">
    <Setter TargetName="Label" Property="FontSize" Value="{DynamicResource Font.Subheading}"/>
    <Setter TargetName="Label" Property="FontWeight" Value="Normal"/>
   </DataTrigger>
   <!-- A project or section is dragged by its name (the cursor of MainWindow), outside read-only. -->
   <MultiDataTrigger>
    <MultiDataTrigger.Conditions>
     <Condition Binding="{Binding IsSheet}" Value="False"/>
     <Condition Binding="{Binding CanDrag}" Value="True"/>
    </MultiDataTrigger.Conditions>
    <Setter TargetName="Label" Property="Cursor" Value="SizeAll"/>
   </MultiDataTrigger>
   <DataTrigger Binding="{Binding Badge.Warning}" Value="True">
    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Token.Badge.Warn}"/>
    <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource Token.Status.Warn}"/>
   </DataTrigger>
  </HierarchicalDataTemplate.Triggers>
 </HierarchicalDataTemplate>
</ResourceDictionary>
