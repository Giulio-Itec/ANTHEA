<!--
  DRAFT (F5.13 c): a detached window of the shell (proposal 4.1, Q10 a, SH2, SH19, SH20) on a TabHostViewModel: its strip of tabs (with «Sposta in
  una nuova finestra», «Riaggancia» and «Chiudi» in the menu of each tab), «Riaggancia» for the tab on screen, the tab on screen. The window can go to
  another monitor; closing it brings its tabs back to the main window (ShellWindowTracker). Colours and font sizes are theme tokens only (P7).
-->
<Window x:Class="X.Desktop.Views.Shell.DetachedShellWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:tabs="clr-namespace:Anthea.Presentation.Shell.Tabs;assembly=ANTHEA.Presentation"
 xmlns:nav="clr-namespace:Anthea.Presentation.Shell.Navigation;assembly=ANTHEA.Presentation"
 x:Name="Root" Width="1200" Height="860" MinWidth="560" MinHeight="400"
 Style="{DynamicResource {x:Type Window}}" Background="{DynamicResource Token.Surface}">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ShellTemplates.xaml"/></ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Window.Resources>
 <DockPanel>
  <DockPanel DockPanel.Dock="Top" Background="{DynamicResource Token.Surface}">
   <Button DockPanel.Dock="Right" Style="{StaticResource Shell.Button}" Content="{x:Static tabs:ShellWindowsViewModel.ReattachLabel}" Margin="8,6"
    Command="{Binding Windows.ReattachCommand, ElementName=Root}" CommandParameter="{Binding Selected}"/>
   <Button x:Name="NewQuickSection" DockPanel.Dock="Right" Style="{StaticResource Shell.Button}" Content="+ Nuova sezione" Margin="0,6"
    ToolTip="Apre una sezione indipendente in una nuova scheda" AutomationProperties.Name="Nuova sezione"
    Command="{Binding Windows.NewQuickSectionCommand, ElementName=Root}" CommandParameter="{Binding}"
    Visibility="{Binding IsQuickSectionSelected, Converter={StaticResource WhenTrue}}"/>
   <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <ItemsControl Style="{StaticResource Shell.TabStrip}" DataContext="{Binding Windows, ElementName=Root}" ItemsSource="{Binding DataContext.Tabs, ElementName=Root}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>
   </ScrollViewer>
  </DockPanel>
  <!--
   The bar of the sheet on screen (19/11/2026, every detached window, as the bar of the main window): «Apri», «Salva», «Salva con nome» (the
   window takes the focus at the click, so they act on its sheet), «W» and «W breve» (the quick section) on the sheet of this window, «Wiki del
   modulo» and «Approfondimenti ▾» of its module. Hidden for a tab that is not a sheet (the Wiki, a model).
  -->
  <Border DockPanel.Dock="Top" Background="{DynamicResource Token.CommandBar}" Padding="4,3"
   Visibility="{Binding SelectedSheet, Converter={StaticResource WhenPresent}}">
   <WrapPanel>
    <Button x:Name="OpenFile" Style="{StaticResource Shell.BarButton}" Content="📂" Width="37" Padding="2" ToolTip="Apri" AutomationProperties.Name="Apri"
     Command="{Binding Commands.OpenCommand, ElementName=Root}"/>
    <Button x:Name="SaveFile" Style="{StaticResource Shell.BarButton}" Content="Salva" ToolTip="Salva" Command="{Binding Commands.SaveCommand, ElementName=Root}"/>
    <Button x:Name="SaveFileAs" Style="{StaticResource Shell.BarButton}" Content="Salva con nome" ToolTip="Salva con nome" Command="{Binding Commands.SaveAsCommand, ElementName=Root}"/>
    <Button x:Name="CopySectionTo" Style="{StaticResource Shell.BarButton}" Content="Copia in…" ToolTip="Copia questa sezione in un’altra sezione c.a. rapida aperta"
     Command="{Binding Commands.CopySectionToCommand, ElementName=Root}" CommandParameter="{Binding SelectedSheet}"
     Visibility="{Binding IsConcreteQuickSectionSelected, Converter={StaticResource WhenTrue}}"/>
    <Button x:Name="CopySectionFrom" Style="{StaticResource Shell.BarButton}" Content="Copia da…" ToolTip="Copia da un’altra sezione c.a. rapida aperta in questa sezione"
     Command="{Binding Commands.CopySectionFromCommand, ElementName=Root}" CommandParameter="{Binding SelectedSheet}"
     Visibility="{Binding IsConcreteQuickSectionSelected, Converter={StaticResource WhenTrue}}"/>
    <Button x:Name="WordReport" Style="{StaticResource Shell.BarButton}" Content="W" Width="37" Padding="2"
     ToolTip="Report Word del foglio visualizzato" AutomationProperties.Name="Report Word"
     Command="{Binding Commands.ReportCommand, ElementName=Root}" CommandParameter="{Binding SelectedSheet}"/>
    <Button x:Name="BriefWordReport" Style="{StaticResource Shell.BarButton}" Content="W breve" MinWidth="75" Padding="6,2"
     ToolTip="Report Word breve della sezione visualizzata" AutomationProperties.Name="Report Word breve"
     Command="{Binding Commands.BriefReportCommand, ElementName=Root}" CommandParameter="{Binding SelectedSheet}"
     Visibility="{Binding IsQuickSectionSelected, Converter={StaticResource WhenTrue}}"/>
    <Button x:Name="ModuleGuide" Style="{StaticResource Shell.BarButton}" Content="{x:Static nav:SheetBarViewModel.GuideLabel}" ToolTip="{x:Static nav:SheetBarViewModel.GuideToolTip}"
     Command="{Binding SheetBar.OpenTopicCommand, ElementName=Root}" CommandParameter="{Binding GuideId}" Visibility="{Binding GuideId, Converter={StaticResource WhenPresent}}"/>
    <Button x:Name="ModuleTopics" Style="{StaticResource Shell.BarButton}" Content="{x:Static nav:SheetBarViewModel.TopicsLabel}"
     ToolTip="{x:Static nav:SheetBarViewModel.TopicsToolTip}" Click="OnTopics"/>
   </WrapPanel>
  </Border>
  <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Token.Border}"/>
  <ContentControl Content="{Binding Selected}" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
 </DockPanel>
</Window>
