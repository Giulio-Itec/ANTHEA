<Application x:Class="X.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:X.Desktop">
 <Application.Resources>
  <ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Wpf/ProjectStyles.xaml"/><ResourceDictionary Source="Wpf/AppearanceControls.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="Menu"><Setter Property="Foreground" Value="{DynamicResource AppearanceInk}"/></Style>
  <Style TargetType="TabControl"><Style.Triggers><Trigger Property="local:Appearance.Dark" Value="True">
   <Setter Property="Background" Value="{DynamicResource AppearancePaper}"/>
   <Setter Property="Foreground" Value="{DynamicResource AppearanceInk}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource AppearanceBorder}"/>
  </Trigger></Style.Triggers></Style>
  <Style TargetType="MenuItem"><Style.Triggers><Trigger Property="local:Appearance.Dark" Value="True">
   <Setter Property="Foreground" Value="{DynamicResource AppearanceInk}"/>
   <Setter Property="Template" Value="{StaticResource AppearanceMenuItemTemplate}"/>
  </Trigger>
  <MultiTrigger><MultiTrigger.Conditions><Condition Property="local:Appearance.Dark" Value="True"/><Condition Property="Role" Value="TopLevelHeader"/></MultiTrigger.Conditions>
   <Setter Property="Template" Value="{StaticResource AppearanceTopLevelMenuItemTemplate}"/>
  </MultiTrigger>
  <MultiTrigger><MultiTrigger.Conditions><Condition Property="local:Appearance.Dark" Value="True"/><Condition Property="Role" Value="TopLevelItem"/></MultiTrigger.Conditions>
   <Setter Property="Template" Value="{StaticResource AppearanceTopLevelMenuItemTemplate}"/>
  </MultiTrigger></Style.Triggers></Style>
  <Style TargetType="ContextMenu"><Style.Triggers><Trigger Property="local:Appearance.Dark" Value="True">
   <Setter Property="Background" Value="{DynamicResource AppearancePaper}"/>
   <Setter Property="Foreground" Value="{DynamicResource AppearanceInk}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource AppearanceBorder}"/>
   <Setter Property="Template" Value="{StaticResource AppearanceContextMenuTemplate}"/>
  </Trigger></Style.Triggers></Style>
  <Style TargetType="ToolTip"><Style.Triggers><Trigger Property="local:Appearance.Dark" Value="True">
   <Setter Property="Background" Value="{DynamicResource AppearancePaper}"/>
   <Setter Property="Foreground" Value="{DynamicResource AppearanceInk}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource AppearanceBorder}"/>
  </Trigger></Style.Triggers></Style>
  <!-- Labels over a technical drawing (axes of the 3D domain): in the dark appearances the light text would lie on the light drawing. -->
  <Style x:Key="AppearanceDrawingLabel" TargetType="TextBlock"><Style.Triggers><Trigger Property="local:Appearance.Dark" Value="True">
   <Setter Property="Background" Value="{DynamicResource AppearancePaper}"/>
  </Trigger></Style.Triggers></Style>
  <Style TargetType="ProgressBar"><Style.Triggers><Trigger Property="local:Appearance.Dark" Value="True">
   <Setter Property="Background" Value="{DynamicResource AppearanceSurface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource AppearanceBorder}"/>
  </Trigger></Style.Triggers></Style>
  <Style TargetType="ScrollBar"><Style.Triggers><Trigger Property="local:Appearance.Dark" Value="True">
   <Setter Property="Background" Value="{DynamicResource AppearanceSurface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource AppearanceSurface}"/>
   <Setter Property="Template" Value="{StaticResource AppearanceVerticalScrollBarTemplate}"/>
  </Trigger>
  <MultiTrigger><MultiTrigger.Conditions><Condition Property="local:Appearance.Dark" Value="True"/><Condition Property="Orientation" Value="Horizontal"/></MultiTrigger.Conditions>
   <Setter Property="Template" Value="{StaticResource AppearanceHorizontalScrollBarTemplate}"/>
  </MultiTrigger></Style.Triggers></Style>
  <Style TargetType="Window">
   <Setter Property="Icon" Value="/ANTHEA;component/Assets/anthea.ico"/>
   <Setter Property="FontFamily" Value="Segoe UI"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="{DynamicResource Appearance.foreground.0B2A4A}"/>
   <Setter Property="Background" Value="{DynamicResource Appearance.background.F3F5F8}"/>
   <Setter Property="UseLayoutRounding" Value="True"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource Appearance.background.FFFFFF}"/>
   <Setter Property="Foreground" Value="{DynamicResource Appearance.foreground.0B2A4A}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Appearance.border.DCE2E9}"/>
   <Setter Property="Padding" Value="10,5"/>
   <Setter Property="Margin" Value="3"/>
   <Setter Property="MinHeight" Value="29"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="4,2"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Appearance.border.DCE2E9}"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Style.Triggers><Trigger Property="local:Appearance.Dark" Value="True">
    <Setter Property="Background" Value="{DynamicResource AppearancePaper}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppearanceInk}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppearanceBorder}"/>
   </Trigger></Style.Triggers>
</Style>
  <Style TargetType="ComboBox">
   <Setter Property="Padding" Value="4,2"/>
   <Setter Property="MinHeight" Value="24"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Style.Triggers><Trigger Property="local:Appearance.Dark" Value="True">
    <Setter Property="Background" Value="{DynamicResource AppearancePaper}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppearanceInk}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppearanceBorder}"/>
    <Setter Property="Template" Value="{StaticResource AppearanceComboBoxTemplate}"/>
   </Trigger></Style.Triggers>
</Style>
  <Style TargetType="DataGrid">
   <Setter Property="AutoGenerateColumns" Value="False"/>
   <Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="CanUserDeleteRows" Value="False"/>
   <Setter Property="CanUserReorderColumns" Value="False"/>
   <Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Appearance.border.E4EAF1}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="{DynamicResource Appearance.background.FFFFFF}"/>
   <Setter Property="RowBackground" Value="{DynamicResource Appearance.background.F8FAFC}"/>
   <Setter Property="AlternatingRowBackground" Value="{DynamicResource Appearance.background.FFFFFF}"/>
   <Setter Property="RowHeight" Value="30"/>
   <Setter Property="SelectionMode" Value="Single"/>
   <Setter Property="SelectionUnit" Value="FullRow"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="{DynamicResource Appearance.background.E8EFF7}"/>
   <Setter Property="Foreground" Value="{DynamicResource Appearance.foreground.0B2A4A}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="6,8"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="9,5"/><Style.Triggers><Trigger Property="local:Appearance.Dark" Value="True">
    <Setter Property="Background" Value="{DynamicResource AppearancePaper}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppearanceInk}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppearanceBorder}"/>
    <Setter Property="Template" Value="{StaticResource AppearanceTabItemTemplate}"/>
   </Trigger></Style.Triggers>
</Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
