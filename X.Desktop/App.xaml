<Application x:Class="X.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:X.Desktop">
 <Application.Resources>
  <ResourceDictionary>
  <!-- Dictionaries of the theme (X.Desktop/Themes, F5.3), each loadable on its own, and the data templates of the MVVM views. -->
  <ResourceDictionary.MergedDictionaries>
   <ResourceDictionary Source="Themes/ProjectStyles.xaml"/>
   <ResourceDictionary Source="Themes/Typography.xaml"/>
   <ResourceDictionary Source="Themes/Controls.xaml"/>
   <ResourceDictionary Source="Views/Common/FieldFormTemplates.xaml"/>
   <ResourceDictionary Source="Views/PileGroup/PileGroupTemplates.xaml"/>
   <ResourceDictionary Source="Views/ShallowFoundation/ShallowFoundationTemplates.xaml"/>
   <ResourceDictionary Source="Views/Materials/MaterialTemplates.xaml"/>
   <ResourceDictionary Source="Views/VerticalPile/VerticalPileTemplates.xaml"/>
   <ResourceDictionary Source="Views/Shared/SoilTransferTemplates.xaml"/>
   <ResourceDictionary Source="Views/Stratigraphy/StratigraphyTemplates.xaml"/>
   <ResourceDictionary Source="Views/Spectra/SpectraTemplates.xaml"/>
   <ResourceDictionary Source="Views/RetainingWall/RetainingWallTemplates.xaml"/>
   <ResourceDictionary Source="Views/HorizontalPile/HorizontalPileTemplates.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Application.Resources>
</Application>
