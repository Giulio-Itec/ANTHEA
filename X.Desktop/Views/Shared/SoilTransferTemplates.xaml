<!--
  The shared soil transfer dialog «Terreno · invio e riutilizzo» (F5.6, decision T5): SoilTransferDialogViewModel with the layout of the
  historic window SoilTransferDialog (940×660, scrolling body with a margin of 20): profile of the sheet and its commands, description and
  preview, another sheet of the project, parameters for the checking module, sending to a new sheet, replacement of the soil of the sheet,
  status (in the failure colour after an error). Theme tokens only (rule P7); every action goes through the ViewModel.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shared="clr-namespace:Anthea.Presentation.Modules.Shared;assembly=ANTHEA.Presentation">
 <DataTemplate DataType="{x:Type shared:SoilTransferDialogViewModel}">
  <ScrollViewer Width="924" Height="621" Background="{DynamicResource Token.Surface}" VerticalScrollBarVisibility="Auto">
   <ScrollViewer.Resources>
    <Style x:Key="Text" TargetType="TextBlock">
     <Setter Property="FontSize" Value="{DynamicResource Font.Small}"/>
     <Setter Property="Foreground" Value="{DynamicResource Token.Ink}"/>
     <Setter Property="TextWrapping" Value="Wrap"/>
     <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Text}">
     <Setter Property="FontSize" Value="{DynamicResource Font.Subheading}"/>
     <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Command" TargetType="Button">
     <Setter Property="Background" Value="{DynamicResource Token.Paper}"/>
     <Setter Property="Foreground" Value="{DynamicResource Token.Ink}"/>
    </Style>
    <Style x:Key="Primary" TargetType="Button">
     <Setter Property="Background" Value="{DynamicResource Token.Selected}"/>
     <Setter Property="Foreground" Value="{DynamicResource Token.OnCommandBar}"/>
    </Style>
    <Style x:Key="Choice" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
     <Setter Property="Margin" Value="2"/>
    </Style>
    <Style x:Key="Preview" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
     <Setter Property="IsReadOnly" Value="True"/>
     <Setter Property="MinHeight" Value="130"/>
     <Setter Property="MaxHeight" Value="240"/>
     <Setter Property="ItemsSource" Value="{Binding PreviewRows}"/>
    </Style>
    <BooleanToVisibilityConverter x:Key="Visible"/>
   </ScrollViewer.Resources>
   <StackPanel Margin="20">
    <TextBlock Style="{StaticResource Text}" FontSize="{DynamicResource Font.Title}" FontWeight="SemiBold" Text="Terreno condivisibile fra i moduli"/>
    <WrapPanel>
     <ComboBox x:Name="Survey" Style="{StaticResource Choice}" ItemsSource="{Binding Surveys}" SelectedIndex="{Binding SelectedSurveyIndex}"/>
     <Button Content="Usa il profilo corrente" Style="{StaticResource Command}" Command="{Binding UseCurrentCommand}"/>
     <Button Content="Carica terreno…" Style="{StaticResource Command}" Command="{Binding LoadCommand}"/>
     <Button Content="Salva terreno…" Style="{StaticResource Command}" Command="{Binding SaveCommand}"/>
    </WrapPanel>
    <TextBlock x:Name="Description" Style="{StaticResource Text}" Text="{Binding Description}"/>
    <Grid Visibility="{Binding HasPreview, Converter={StaticResource Visible}}">
     <DataGrid x:Name="StratigraphyPreview">
      <DataGrid.Style>
       <Style TargetType="DataGrid" BasedOn="{StaticResource Preview}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers><DataTrigger Binding="{Binding PreviewIsStratigraphy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
       </Style>
      </DataGrid.Style>
      <DataGrid.Columns>
       <DataGridTextColumn Header="Strato / insieme" Binding="{Binding [0]}" Width="220" MinWidth="65"/>
       <DataGridTextColumn Header="Famiglia" Binding="{Binding [1]}" Width="100" MinWidth="65"/>
       <DataGridTextColumn Header="Da z [m]" Binding="{Binding [2]}" Width="SizeToCells" MinWidth="65"/>
       <DataGridTextColumn Header="A z [m]" Binding="{Binding [3]}" Width="SizeToCells" MinWidth="65"/>
       <DataGridTextColumn Header="γ" Binding="{Binding [4]}" Width="SizeToCells" MinWidth="65"/>
       <DataGridTextColumn Header="γsat" Binding="{Binding [5]}" Width="SizeToCells" MinWidth="65"/>
       <DataGridTextColumn Header="φ′" Binding="{Binding [6]}" Width="SizeToCells" MinWidth="65"/>
       <DataGridTextColumn Header="c′" Binding="{Binding [7]}" Width="SizeToCells" MinWidth="65"/>
       <DataGridTextColumn Header="cu" Binding="{Binding [8]}" Width="SizeToCells" MinWidth="65"/>
      </DataGrid.Columns>
     </DataGrid>
     <DataGrid x:Name="ProfilePreview">
      <DataGrid.Style>
       <Style TargetType="DataGrid" BasedOn="{StaticResource Preview}">
        <Style.Triggers><DataTrigger Binding="{Binding PreviewIsStratigraphy}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
       </Style>
      </DataGrid.Style>
      <DataGrid.Columns>
       <DataGridTextColumn Header="Strato" Binding="{Binding [0]}" Width="SizeToCells" MinWidth="65"/>
       <DataGridTextColumn Header="Tipo" Binding="{Binding [1]}" Width="SizeToCells" MinWidth="65"/>
       <DataGridTextColumn Header="Da z [m]" Binding="{Binding [2]}" Width="SizeToCells" MinWidth="65"/>
       <DataGridTextColumn Header="A z [m]" Binding="{Binding [3]}" Width="SizeToCells" MinWidth="65"/>
       <DataGridTextColumn Header="γ" Binding="{Binding [4]}" Width="SizeToCells" MinWidth="65"/>
       <DataGridTextColumn Header="γsat" Binding="{Binding [5]}" Width="SizeToCells" MinWidth="65"/>
       <DataGridTextColumn Header="φ′" Binding="{Binding [6]}" Width="SizeToCells" MinWidth="65"/>
       <DataGridTextColumn Header="c′" Binding="{Binding [7]}" Width="SizeToCells" MinWidth="65"/>
       <DataGridTextColumn Header="cu" Binding="{Binding [8]}" Width="SizeToCells" MinWidth="65"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
    <TextBlock Style="{StaticResource Section}" Text="Da un altro foglio del progetto"/>
    <WrapPanel>
     <ComboBox x:Name="Source" Style="{StaticResource Choice}" MinWidth="280" ItemsSource="{Binding SourceLabels}" SelectedIndex="{Binding SelectedSourceIndex}"/>
     <ComboBox x:Name="SourceSurvey" Style="{StaticResource Choice}" MinWidth="100" ItemsSource="{Binding SourceSurveys}" SelectedIndex="{Binding SelectedSourceSurveyIndex}"/>
     <Button Content="Importa dal foglio selezionato" Style="{StaticResource Command}" Command="{Binding ImportSourceCommand}"/>
    </WrapPanel>
    <TextBlock Style="{StaticResource Text}" Text="Parametri per il modulo di verifica (la copia fra stratigrafie conserva entrambi)"/>
    <ComboBox x:Name="Scenario" Style="{StaticResource Choice}" ItemsSource="{Binding Scenarios}" SelectedItem="{Binding Scenario}"/>
    <TextBlock Style="{StaticResource Section}" Text="Invio a un nuovo foglio / una nuova finestra"/>
    <WrapPanel>
     <ComboBox x:Name="Destination" MinWidth="300" ItemsSource="{Binding Destinations}" DisplayMemberPath="Label" SelectedValuePath="Module" SelectedValue="{Binding SelectedDestination}"/>
     <Button Content="Invia a un nuovo foglio" Style="{StaticResource Primary}" Command="{Binding SendCommand}"/>
    </WrapPanel>
    <TextBlock x:Name="Guidance" Style="{StaticResource Text}" Foreground="{DynamicResource Token.Muted}" Text="{Binding Guidance}"/>
    <TextBlock Style="{StaticResource Section}" Text="Importazione nel foglio corrente"/>
    <Button Content="Sostituisci il terreno del foglio corrente" Style="{StaticResource Command}" Command="{Binding ApplyCommand}"/>
    <TextBlock x:Name="Status" Text="{Binding Status}">
     <TextBlock.Style>
      <Style TargetType="TextBlock" BasedOn="{StaticResource Text}">
       <Style.Triggers><DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Token.Status.Fail}"/></DataTrigger></Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
   </StackPanel>
  </ScrollViewer>
 </DataTemplate>
</ResourceDictionary>
