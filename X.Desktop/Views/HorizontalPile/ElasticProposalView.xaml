<!-- «Proposta di suddivisione» (CreateProposalWindow of the historic editor, F5.8): the note, the proposed segments, «Applica e archivia i tratti precedenti». -->
<UserControl x:Class="X.Desktop.Views.HorizontalPile.ElasticProposalView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:elastic="clr-namespace:Anthea.Presentation.Modules.HorizontalPile.Elastic;assembly=ANTHEA.Presentation"
 Background="{DynamicResource Token.Surface}">
 <StackPanel>
  <TextBlock Text="{x:Static elastic:ElasticPileFields.ProposalNote}" FontSize="{DynamicResource Font.Body}" Foreground="{DynamicResource Token.Ink}" TextWrapping="Wrap"/>
  <TextBlock x:Name="ProposalText" FontSize="{DynamicResource Font.Small}" Foreground="{DynamicResource Token.Ink}" TextWrapping="Wrap"/>
  <Button x:Name="ApplyButton" Content="Applica e archivia i tratti precedenti" Background="{DynamicResource Token.Paper}" Foreground="{DynamicResource Token.Ink}" Click="Apply_Click"/>
 </StackPanel>
</UserControl>
