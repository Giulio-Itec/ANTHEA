<!--
  Data templates of the horizontal pile and micropile sheet (F5.7): MvvmSheetEditor finds the view of HorizontalPileSheetViewModel here. The
  dialog of «Copia in…»/«Copia da…» (SurveyCopyDialogViewModel) is the one of Views/VerticalPile/VerticalPileTemplates.xaml, the soil transfer
  dialog the shared one of Views/Shared/SoilTransferTemplates.xaml (T5). The view of the elastic response comes with F5.8.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:X.Desktop.Views.HorizontalPile"
 xmlns:pile="clr-namespace:Anthea.Presentation.Modules.HorizontalPile;assembly=ANTHEA.Presentation"
 xmlns:elastic="clr-namespace:Anthea.Presentation.Modules.HorizontalPile.Elastic;assembly=ANTHEA.Presentation">
 <DataTemplate DataType="{x:Type pile:HorizontalPileSheetViewModel}"><views:HorizontalPileSheetView/></DataTemplate>
 <DataTemplate DataType="{x:Type elastic:ElasticPileViewModel}">
  <TextBlock Margin="16" Text="Risposta elastica · vista XAML in preparazione (F5.8)." Foreground="{DynamicResource Token.Muted}" FontSize="{DynamicResource Font.Body}"/>
 </DataTemplate>
</ResourceDictionary>
