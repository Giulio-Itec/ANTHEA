<!--
  Data templates of the Bridge Design sheet (F5.12): MvvmSheetEditor finds the view of BridgeDesignSheetViewModel here, and WpfDialogService the
  price editor «Gestisci prezzario…» (PriceCatalogueViewModel, a dialog of the service in place of the historic window BridgePricesView).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:X.Desktop.Views.BridgeDesign"
 xmlns:bd="clr-namespace:Anthea.Presentation.Modules.BridgeDesign;assembly=ANTHEA.Presentation">
 <DataTemplate DataType="{x:Type bd:BridgeDesignSheetViewModel}"><views:BridgeDesignSheetView/></DataTemplate>
 <DataTemplate DataType="{x:Type bd:PriceCatalogueViewModel}"><views:PriceCatalogueView/></DataTemplate>
</ResourceDictionary>
