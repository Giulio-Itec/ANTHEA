<!--
  The price editor of Bridge Design («Gestisci prezzario…», F5.12): PriceCatalogueViewModel shown by IDialogService with the layout of the historic
  window BridgePricesView (1350 × 780, borders excluded, as the other dialogs of WpfDialogService). At the top the title, the note, name and edition,
  the files (through the file dialog service of the sheet), the two options and the note on Excel; in the middle the four tabs (associations and
  preview, the entries, the analyses with the percentages, the revisions); at the bottom the status, «Applica prezzario» and «Annulla». The cells are
  written at every change (UpdateSourceTrigger=PropertyChanged, as the historic window); a button commits the cell being edited first. Theme tokens
  only (P7).
-->
<UserControl x:Class="X.Desktop.Views.BridgeDesign.PriceCatalogueView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="1334" Height="741" Background="{DynamicResource Token.Surface}">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="BridgeDesignResources.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style x:Key="Table" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="EnableRowVirtualization" Value="True"/>
    <Setter Property="EnableColumnVirtualization" Value="True"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="MinHeight" Value="220"/>
    <Setter Property="RowHeaderWidth" Value="0"/>
    <Setter Property="Margin" Value="0,8,0,8"/>
   </Style>
   <Style x:Key="Editor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="MinWidth" Value="180"/>
    <Setter Property="Margin" Value="4"/>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Border Padding="16" Background="{DynamicResource Token.Surface}">
  <DockPanel x:Name="Body" ButtonBase.Click="Commit_Click">
   <StackPanel DockPanel.Dock="Top">
    <TextBlock Style="{StaticResource Title}" Text="PREZZARIO DEL PONTE"/>
    <TextBlock Style="{StaticResource T12}" Text="Catalogo sostituibile, associazioni alle lavorazioni e prezzi personalizzati. Valuta EUR, IVA esclusa. Le modifiche diventano attive soltanto con Applica."/>
    <WrapPanel>
     <TextBlock Style="{StaticResource T12}" Text="Nome"/>
     <TextBox Style="{StaticResource Editor}" Text="{Binding CatalogueName, UpdateSourceTrigger=PropertyChanged}"/>
     <TextBlock Style="{StaticResource T12}" Text="Edizione"/>
     <TextBox Style="{StaticResource Editor}" Text="{Binding Edition, UpdateSourceTrigger=PropertyChanged}"/>
    </WrapPanel>
    <WrapPanel>
     <Button Style="{StaticResource Command}" Content="Importa CSV / Excel / JSON" Command="{Binding ImportFileCommand}"/>
     <Button Style="{StaticResource Command}" Content="Modello CSV" Command="{Binding SaveTemplateCommand}"/>
     <Button Style="{StaticResource Command}" Content="Esporta catalogo JSON" Command="{Binding SaveCatalogueCommand}"/>
    </WrapPanel>
    <CheckBox Content="Mantieni i prezzi personalizzati quando importi un altro prezzario" Margin="4,8,4,8" Foreground="{DynamicResource Token.Ink}" IsChecked="{Binding KeepOverrides}"/>
    <CheckBox Content="Rivaluta anche l'alternativa A con questo prezzario" Margin="4,4,4,8" Foreground="{DynamicResource Token.Ink}" IsChecked="{Binding RepricePinnedAlternative}"
     Visibility="{Binding HasPinnedAlternative, Converter={StaticResource Visible}}"/>
    <TextBlock Style="{StaticResource T11Muted}" Text="Excel: foglio Prezzario, intestazioni Codice · Descrizione · Unita · Prezzo · Inclusioni. Prezzi senza separatori delle migliaia."/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom">
    <TextBlock x:Name="StatusText" Style="{StaticResource T12}" Text="{Binding Status}"/>
    <WrapPanel>
     <Button x:Name="ApplyButton" Style="{StaticResource Command}" Content="Applica prezzario" Command="{Binding ApplyCommand}"/>
     <Button x:Name="CancelButton" Style="{StaticResource Command}" Content="Annulla" Command="{Binding CancelCommand}"/>
    </WrapPanel>
   </StackPanel>
   <TabControl x:Name="Tabs">
    <TabItem Style="{StaticResource Tab}" Header="Associazioni e anteprima">
     <DockPanel>
      <TextBlock DockPanel.Dock="Top" Style="{StaticResource T12}" Text="I prezzi personalizzati sono espressi nell'unità della lavorazione. Lasciare vuoto per usare il catalogo; zero è un prezzo esplicito."/>
      <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Heading}" Text="{Binding CostPreview}"/>
      <DataGrid x:Name="MappingGrid" Style="{StaticResource Table}" ItemsSource="{Binding Mappings}">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Lavorazione" Width="220" IsReadOnly="True" Binding="{Binding Label, Mode=OneWay}"/>
        <DataGridTextColumn Header="Unità" Width="65" IsReadOnly="True" Binding="{Binding Unit, Mode=OneWay}"/>
        <DataGridTextColumn Header="Codice prezzario" Width="140" Binding="{Binding EntryCode, UpdateSourceTrigger=PropertyChanged}"/>
        <DataGridTextColumn Header="Prezzo personalizzato" Width="140" Binding="{Binding OverridePrice, UpdateSourceTrigger=PropertyChanged}"/>
        <DataGridTextColumn Header="Motivo personalizzazione" Width="195" Binding="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"/>
        <DataGridTextColumn Header="Prima" Width="100" IsReadOnly="True" Binding="{Binding PreviousPrice, Mode=OneWay}"/>
        <DataGridTextColumn Header="Dopo" Width="100" IsReadOnly="True" Binding="{Binding ResolvedPrice, Mode=OneWay}"/>
        <DataGridTextColumn Header="Esito associazione" Width="230" IsReadOnly="True" Binding="{Binding Status, Mode=OneWay}"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </TabItem>
    <TabItem Style="{StaticResource Tab}" Header="Voci del prezzario">
     <DockPanel>
      <WrapPanel DockPanel.Dock="Top">
       <Button Style="{StaticResource Command}" Content="+ Voce" Command="{Binding AddEntryCommand}"/>
       <Button Style="{StaticResource Command}" Content="Elimina voce" Command="{Binding RemoveEntryCommand}"/>
      </WrapPanel>
      <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource T12}" Text="Inclusioni: usare i codici delle lavorazioni, per esempio rebar sul prezzo del palo. Si applicano solo alle quantità figlie del relativo palo, mai a tutte le armature."/>
      <DataGrid x:Name="EntryGrid" Style="{StaticResource Table}" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Codice" Width="140" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}"/>
        <DataGridTextColumn Header="Descrizione" Width="280" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
        <DataGridComboBoxColumn x:Name="EntryUnits" Header="Unità" Width="75" SelectedItemBinding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"/>
        <DataGridTextColumn Header="Prezzo unitario" Width="140" Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>
        <DataGridTextColumn Header="Lavorazioni comprese (codici separati da |)" Width="330" Binding="{Binding Includes, UpdateSourceTrigger=PropertyChanged}"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </TabItem>
    <TabItem Style="{StaticResource Tab}" Header="Analisi composte">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top">
       <WrapPanel>
        <TextBlock Style="{StaticResource T12}" Text="Spese generali %"/>
        <TextBox Style="{StaticResource Editor}" Text="{Binding GeneralExpensesPercent, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Style="{StaticResource T12}" Text="Utile d'impresa %"/>
        <TextBox Style="{StaticResource Editor}" Text="{Binding ProfitPercent, UpdateSourceTrigger=PropertyChanged}"/>
        <Button Style="{StaticResource Command}" Content="+ Analisi" Command="{Binding AddAnalysisCommand}"/>
        <Button Style="{StaticResource Command}" Content="Elimina analisi" Command="{Binding RemoveAnalysisCommand}"/>
       </WrapPanel>
       <TextBlock Style="{StaticResource T12}" Text="Prezzo = componenti + spese generali sui componenti + utile su componenti e spese generali. Le quantità sono nell'unità del componente (per esempio ore di manodopera per m³); un componente può essere un'altra analisi. Il codice di un'analisi si associa alle lavorazioni come una voce."/>
      </StackPanel>
      <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource T12}" Text="{Binding AnalysisBreakdown}"/>
      <DataGrid x:Name="AnalysisGrid" Style="{StaticResource Table}" ItemsSource="{Binding Analyses}" SelectedItem="{Binding SelectedAnalysis}">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Codice" Width="140" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}"/>
        <DataGridTextColumn Header="Descrizione" Width="240" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
        <DataGridComboBoxColumn x:Name="AnalysisUnits" Header="Unità" Width="75" SelectedItemBinding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"/>
        <DataGridTextColumn Header="Componenti (codice = quantità; …)" Width="360" Binding="{Binding Components, UpdateSourceTrigger=PropertyChanged}"/>
        <DataGridTextColumn Width="150" Binding="{Binding GeneralExpenses, UpdateSourceTrigger=PropertyChanged}">
         <DataGridTextColumn.Header><TextBlock Text="Spese generali %&#10;(vuoto = prezzario)"/></DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn Width="130" Binding="{Binding Profit, UpdateSourceTrigger=PropertyChanged}">
         <DataGridTextColumn.Header><TextBlock Text="Utile %&#10;(vuoto = prezzario)"/></DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn Header="Prezzo unitario" Width="130" IsReadOnly="True" Binding="{Binding UnitPrice, Mode=OneWay}"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </TabItem>
    <TabItem Style="{StaticResource Tab}" Header="Revisioni">
     <DockPanel>
      <StackPanel DockPanel.Dock="Bottom">
       <TextBlock Style="{StaticResource T12}" Text="Il ripristino prepara una nuova anteprima; la cronologia rimane conservata."/>
       <Button Style="{StaticResource Command}" Content="Prepara ripristino" Command="{Binding RestoreRevisionCommand}"/>
      </StackPanel>
      <ListBox x:Name="RevisionList" MinHeight="200" ItemsSource="{Binding History}" DisplayMemberPath="Caption" SelectedItem="{Binding SelectedRevision}"/>
     </DockPanel>
    </TabItem>
   </TabControl>
  </DockPanel>
 </Border>
</UserControl>
