<!--
  The window «Sollecitazioni della sezione» (F5.10 view after S9, S2) on SectionActionsViewModel, shown by the dialog service, with the layout of
  SectionActionsView of the historic view: the guidance and the notice of the former data, the commands of the rows and of the Excel files, the table
  of the actions (the column «Origine precedente» only with former data), the status, «Applica» and «Annulla». Tokens only (P7).
-->
<UserControl x:Class="X.Desktop.Views.ConcreteSection.SectionActionsDialogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="1260" Height="680" Background="{DynamicResource Token.Surface}">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ConcreteSectionResources.xaml"/></ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </UserControl.Resources>
 <Border Padding="14">
  <DockPanel>
   <StackPanel DockPanel.Dock="Top">
    <TextBlock Style="{StaticResource T12}" Text="{Binding Guidance}"/>
    <TextBlock Style="{StaticResource T12}" Text="{Binding MigrationNotice}" Visibility="{Binding HasOrigins, Converter={StaticResource Visible}}"/>
    <WrapPanel>
     <Button Style="{StaticResource Command}" Content="+ Riga" Command="{Binding AddCommand}"/>
     <Button Style="{StaticResource Command}" Content="Duplica" Command="{Binding DuplicateCommand}"/>
     <Button Style="{StaticResource Command}" Content="Elimina" Command="{Binding RemoveCommand}"/>
     <Button Style="{StaticResource Command}" Content="Vuoti a zero · riga selezionata" Command="{Binding FillMissingWithZeroCommand}"/>
    </WrapPanel>
    <WrapPanel>
     <Button Style="{StaticResource Command}" Content="Template Excel" Command="{Binding SaveTemplateCommand}"/>
     <Button Style="{StaticResource Command}" Content="Importa e sostituisci" Command="{Binding ImportReplaceCommand}"/>
     <Button Style="{StaticResource Command}" Content="Importa e aggiungi" Command="{Binding ImportAppendCommand}"/>
     <Button Style="{StaticResource Command}" Content="Esporta Excel" Command="{Binding ExportWorkbookCommand}"/>
    </WrapPanel>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom">
    <TextBlock Style="{StaticResource T12}" Text="{Binding Status}"/>
    <WrapPanel>
     <Button Style="{StaticResource Command}" Content="Applica" Command="{Binding ApplyAndCloseCommand}" Click="Commit_Click"/>
     <Button Style="{StaticResource Command}" Content="Annulla" Command="{Binding CancelCommand}"/>
    </WrapPanel>
   </StackPanel>
   <DataGrid x:Name="ActionsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" EnableRowVirtualization="True"
    MinHeight="250" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutomationProperties.Name="Sollecitazioni">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Elemento" MinWidth="80" Width="*" Binding="{Binding Element, UpdateSourceTrigger=PropertyChanged}"/>
     <DataGridTextColumn Header="Nome combo" MinWidth="130" Width="1.6*" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
     <DataGridComboBoxColumn x:Name="StateColumn" Header="Stato limite" MinWidth="145" Width="155" SelectedItemBinding="{Binding State, UpdateSourceTrigger=PropertyChanged}"/>
     <DataGridTextColumn Header="N [kN]" MinWidth="80" Width="*" Binding="{Binding N, UpdateSourceTrigger=PropertyChanged}"/>
     <DataGridTextColumn Header="Vx [kN]" MinWidth="80" Width="*" Binding="{Binding Vx, UpdateSourceTrigger=PropertyChanged}"/>
     <DataGridTextColumn Header="Vy [kN]" MinWidth="80" Width="*" Binding="{Binding Vy, UpdateSourceTrigger=PropertyChanged}"/>
     <DataGridTextColumn Header="T [kNm]" MinWidth="80" Width="*" Binding="{Binding T, UpdateSourceTrigger=PropertyChanged}"/>
     <DataGridTextColumn Header="Mx [kNm]" MinWidth="80" Width="*" Binding="{Binding Mx, UpdateSourceTrigger=PropertyChanged}"/>
     <DataGridTextColumn Header="My [kNm]" MinWidth="80" Width="*" Binding="{Binding My, UpdateSourceTrigger=PropertyChanged}"/>
     <DataGridTextColumn x:Name="OriginColumn" Header="Origine precedente" MinWidth="80" Width="1.6*" IsReadOnly="True" Binding="{Binding Origin, Mode=OneWay}"/>
    </DataGrid.Columns>
   </DataGrid>
  </DockPanel>
 </Border>
</UserControl>
