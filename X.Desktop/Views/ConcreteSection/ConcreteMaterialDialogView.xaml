<!--
  The window «Nuovo materiale · …» of the RC section (F5.10 view after S9) on ConcreteMaterialDialogViewModel, shown by the dialog service, with the
  layout of CreateMaterialDialog of the historic view: the notice, the form with the values derived by the library beside the σ–ε diagram, the error
  and «Salva materiale e applica». The diagram is the Plot of the historic view, fed by the curves of the dialog in the code-behind (Q3). Tokens only.
-->
<UserControl x:Class="X.Desktop.Views.ConcreteSection.ConcreteMaterialDialogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:X.Desktop"
 Width="1030" Height="650" Background="{DynamicResource Token.Surface}">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ConcreteSectionResources.xaml"/></ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </UserControl.Resources>
 <Border Style="{StaticResource Paper}" Padding="12">
  <DockPanel>
   <Border DockPanel.Dock="Top" Style="{StaticResource Notice}">
    <TextBlock Style="{StaticResource NoticeText}" Text="{Binding Notice}"/>
   </Border>
   <StackPanel DockPanel.Dock="Bottom">
    <TextBlock Style="{StaticResource T12}" Text="{Binding Error}"/>
    <Button Style="{StaticResource Command}" Content="Salva materiale e applica" Command="{Binding SaveCommand}" HorizontalAlignment="Left"/>
   </StackPanel>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="4*" MinWidth="280"/><ColumnDefinition Width="8"/><ColumnDefinition Width="6*" MinWidth="380"/></Grid.ColumnDefinitions>
    <local:ChainedScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <ContentControl Style="{StaticResource Form}" Content="{Binding Form}"/>
      <TextBlock Style="{StaticResource T12}" Text="{Binding Derived}"/>
     </StackPanel>
    </local:ChainedScrollViewer>
    <GridSplitter Style="{StaticResource ColumnSplitter}"/>
    <ContentControl x:Name="PlotHost" Grid.Column="2" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   </Grid>
  </DockPanel>
 </Border>
</UserControl>
