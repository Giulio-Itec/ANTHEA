<!--
  View of the RC section sheet (F5.10, view after S9; decision Q3): ConcreteSheetViewModel shown with the layout of the historic view
  (ConcreteWorkspace inside SheetEditor). At the top the reference to the engine; the eight tabs of the sheet; at the bottom the progress of the
  calculation, the status line, «Sollecitazioni…» and «Modello e dati comuni…». The tab 01 «Pannello di controllo» has the column of the definition
  of the section (forms of the inputs and the groups of the historic view), the drawing of the section with its toolbar, the tables of the bars and
  of the cables, the resistances at given N and the summaries of the checks. The forms are compact FieldForm (D10); colours and font sizes are theme
  tokens only (rule P7). The code-behind draws the section from the plain data of the sheet (ConcreteSectionDrawings, Q3), keeps the splitters with
  the ratios saved in the sheet and opens the windows of the view; every write into the document goes through the ViewModel.
  The tabs 02–08 are views of their own, each on the ViewModel of its panel (section 20 of docs/refactoring/f5-10-sezione.md).
-->
<UserControl x:Class="X.Desktop.Views.ConcreteSection.ConcreteSectionSheetView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:X.Desktop"
 xmlns:views="clr-namespace:X.Desktop.Views.ConcreteSection"
 xmlns:concrete="clr-namespace:Anthea.Presentation.Modules.ConcreteSection;assembly=ANTHEA.Presentation"
 Background="{DynamicResource Token.Surface}">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ConcreteSectionResources.xaml"/></ResourceDictionary.MergedDictionaries>
   <!-- A layer of second bars (BuildAdditionalLayers of the historic view): its toggle and its form. -->
   <DataTemplate x:Key="Layer" DataType="{x:Type concrete:ConcreteLayerViewModel}">
    <StackPanel Visibility="{Binding IsShown, Converter={StaticResource Visible}}">
     <Button Style="{StaticResource Command}" Content="{Binding ToggleText}" ToolTip="{Binding ToggleToolTip}" Command="{Binding ToggleCommand}" HorizontalAlignment="Left"/>
     <ContentControl Style="{StaticResource Form}" Content="{Binding Form}" IsEnabled="{Binding FormEnabled}" Visibility="{Binding FormVisible, Converter={StaticResource Visible}}"/>
    </StackPanel>
   </DataTemplate>
   <!-- A card of the resistances at given N (direction and value). -->
   <DataTemplate x:Key="QuickResistanceCard" DataType="{x:Type concrete:ConcreteQuickResistanceCard}">
    <Border Style="{StaticResource Paper}" Padding="6" Margin="2,4,2,0">
     <StackPanel>
      <TextBlock Style="{StaticResource T11Bold}" Text="{Binding Direction}"/>
      <TextBlock Style="{StaticResource T12}" Text="{Binding Value}"/>
     </StackPanel>
    </Border>
   </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>

 <local:ChainedScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
  <DockPanel x:Name="Body">
   <TextBlock DockPanel.Dock="Top" Style="{StaticResource T12BoldMuted}" Text="{Binding EngineReference}" Margin="16,8,16,0" HorizontalAlignment="Right"/>
   <StackPanel DockPanel.Dock="Bottom">
    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsProgressVisible, Converter={StaticResource Visible}}"/>
    <DockPanel Margin="16,4,16,8" LastChildFill="False">
     <TextBlock x:Name="StatusText" Style="{StaticResource T12}" Text="{Binding Status}"/>
     <Button x:Name="ActionsButton" Style="{StaticResource Command}" Content="Sollecitazioni…" Command="{Binding Actions.EditCommand}"/>
     <Button x:Name="ModelButton" Style="{StaticResource Command}" Content="Modello e dati comuni…" Click="Model_Click"/>
    </DockPanel>
   </StackPanel>

   <TabControl x:Name="Tabs" Margin="12,8,12,0" BorderThickness="0" Background="{DynamicResource Token.Surface}" SelectedIndex="{Binding SelectedTab}">
    <!-- ================================================================ 01 · Pannello di controllo -->
    <TabItem Padding="14,9,14,9">
     <TabItem.Header><WrapPanel><TextBlock Style="{StaticResource T11BoldMuted}" Text="01"/><TextBlock Style="{StaticResource T14Bold}" Text="  Pannello di controllo"/></WrapPanel></TabItem.Header>
     <Grid x:Name="ControlColumns" Tag="ingressi" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="285"/><ColumnDefinition Width="8"/><ColumnDefinition Width="7*" MinWidth="650"/></Grid.ColumnDefinitions>
      <!-- Definizione della sezione. -->
      <Border Style="{StaticResource Paper}">
       <DockPanel>
        <StackPanel Style="{StaticResource PanelHeading}">
         <TextBlock Style="{StaticResource T14Bold}" Text="Definizione della sezione"/>
         <TextBlock Style="{StaticResource PanelSubtitle}" Text="Dati comuni a tutte le verifiche · mm, MPa"/>
        </StackPanel>
        <local:ChainedScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <StackPanel x:Name="Definition" DataContext="{Binding Inputs}">
          <ContentControl Style="{StaticResource Form}" Content="{Binding Standard}"/>
          <Expander Style="{StaticResource Group}" IsExpanded="{Binding Group[valori].IsExpanded, FallbackValue=False}"
           Visibility="{Binding MigratedInput, Converter={StaticResource TextShown}}">
           <Expander.Header><TextBlock Style="{StaticResource T14Bold}" Text="Valori integrati dal documento precedente"/></Expander.Header>
           <TextBlock Style="{StaticResource T11}" Text="{Binding MigratedInput}"/>
          </Expander>
          <TextBlock Style="{StaticResource T11Muted}" Text="{Binding StandardNote}"/>
          <Expander Style="{StaticResource Group}" IsExpanded="{Binding Group[coefficienti].IsExpanded}">
           <Expander.Header><TextBlock Style="{StaticResource T14Bold}" Text="Coefficienti da normativa"/></Expander.Header>
           <StackPanel>
            <Border Style="{StaticResource Notice}">
             <TextBlock Style="{StaticResource NoticeText}" Text="Valori iniziali dalla classe della DLL. Modifiche salvate nel foglio. Cambiare normativa ripristina i coefficienti della nuova classe. Coefficienti accidentali/FRC esposti per predisposizione, non equivalgono a verifiche implementate."/>
            </Border>
            <ContentControl Style="{StaticResource Form}" Content="{Binding Coefficients}"/>
            <Button Style="{StaticResource Command}" Content="Ripristina coefficienti della normativa" Command="{Binding ResetCoefficientsCommand}" HorizontalAlignment="Left"/>
           </StackPanel>
          </Expander>
          <Expander Style="{StaticResource Group}" IsExpanded="{Binding Group[materiali].IsExpanded}">
           <Expander.Header><TextBlock Style="{StaticResource T14Bold}" Text="Materiali"/></Expander.Header>
           <StackPanel Margin="14,0,0,0">
            <ContentControl Style="{StaticResource Form}" Content="{Binding Materials}"/>
            <Button Style="{StaticResource Command}" Content="Reologia del calcestruzzo…" Command="{Binding OpenRheologyCommand}" HorizontalAlignment="Left"/>
            <Expander Style="{StaticResource Group}" IsExpanded="{Binding TendonGroup.IsExpanded}">
             <Expander.Header><TextBlock Style="{StaticResource T14Bold}" Text="Trefoli"/></Expander.Header>
             <StackPanel>
              <TextBlock Style="{StaticResource T12}" Text="Trefoli da standard EN 1992"/>
              <ComboBox x:Name="StandardTendon" Style="{StaticResource Choice}" MinWidth="175" HorizontalAlignment="Left" IsEnabled="{Binding CanEditTables}"
               ItemsSource="{Binding StandardTendon.Items}" SelectedIndex="{Binding StandardTendon.SelectedIndex}" AutomationProperties.Name="Trefoli da standard EN 1992"/>
              <ContentControl Style="{StaticResource Form}" Content="{Binding TendonProperties}"/>
              <TextBlock Style="{StaticResource T11Muted}" Text="Materiale predefinito dei nuovi cavi. Per un cavo esistente scegli il materiale nella sua riga."/>
             </StackPanel>
            </Expander>
            <WrapPanel>
             <Button Style="{StaticResource Command}" Content="Nuovo materiale CLS" Command="{Binding NewConcreteMaterialCommand}"/>
             <Button Style="{StaticResource Command}" Content="Nuovo materiale acciaio" Command="{Binding NewSteelMaterialCommand}"/>
             <Button Style="{StaticResource Command}" Content="Nuovo materiale trefoli" Command="{Binding NewTendonMaterialCommand}"/>
            </WrapPanel>
            <ComboBox x:Name="SavedMaterials" Style="{StaticResource Choice}" MinWidth="175" HorizontalAlignment="Left" IsEnabled="{Binding CanEditTables}"
             ItemsSource="{Binding SavedMaterials.Items}" SelectedIndex="{Binding SavedMaterials.SelectedIndex}" AutomationProperties.Name="Materiali salvati"/>
            <Button Style="{StaticResource Command}" Content="Applica materiale salvato" Command="{Binding ApplySavedMaterialCommand}" HorizontalAlignment="Left"/>
           </StackPanel>
          </Expander>
          <Expander Style="{StaticResource Group}" IsExpanded="{Binding Group[geometria].IsExpanded}">
           <Expander.Header><TextBlock Style="{StaticResource T14Bold}" Text="Geometria"/></Expander.Header>
           <StackPanel>
            <Button x:Name="WizardButton" Style="{StaticResource Command}" Content="{Binding WizardCommandText}" Command="{Binding OpenWizardCommand}" HorizontalAlignment="Left"/>
            <TextBlock Style="{StaticResource T11}" Text="{Binding TemplateGeometryNote}" Visibility="{Binding TemplateNotesShown, Converter={StaticResource Visible}}"/>
            <ContentControl Style="{StaticResource Form}" Content="{Binding Geometry}" IsEnabled="{Binding GeometryEnabled}"
             Visibility="{Binding GeometryShown, Converter={StaticResource Visible}}"/>
            <CheckBox x:Name="HoleToggle" Content="Foro centrale" Margin="4" IsChecked="{Binding HoleChecked, Mode=OneWay}" Command="{Binding ToggleHoleCommand}"
             Foreground="{DynamicResource Token.Ink}"/>
            <ContentControl Style="{StaticResource Form}" Content="{Binding Hole}" IsEnabled="{Binding HoleFormEnabled}"
             Visibility="{Binding HoleFieldsVisible, Converter={StaticResource Visible}}"/>
           </StackPanel>
          </Expander>
          <Expander Style="{StaticResource Group}" IsExpanded="{Binding Group[armature].IsExpanded}">
           <Expander.Header><TextBlock Style="{StaticResource T14Bold}" Text="Armature"/></Expander.Header>
           <StackPanel>
            <ContentControl Style="{StaticResource Form}" Content="{Binding Reinforcement}" IsEnabled="{Binding ReinforcementEnabled}" ToolTip="{Binding ReinforcementToolTip}"
             Visibility="{Binding ReinforcementShown, Converter={StaticResource Visible}}"/>
            <TextBlock Style="{StaticResource T11}" Text="{Binding TemplateReinforcementNote}" Visibility="{Binding TemplateNotesShown, Converter={StaticResource Visible}}"/>
            <ItemsControl Focusable="False" ItemsSource="{Binding Layers}" ItemTemplate="{StaticResource Layer}"/>
           </StackPanel>
          </Expander>
          <Expander Style="{StaticResource Group}" IsExpanded="{Binding Group[staffe].IsExpanded}">
           <Expander.Header><TextBlock Style="{StaticResource T14Bold}" Text="Staffe"/></Expander.Header>
           <StackPanel>
            <ContentControl Style="{StaticResource Form}" Content="{Binding Stirrups}"/>
            <ContentControl Style="{StaticResource Form}" Content="{Binding StirrupScheme}"/>
            <TextBlock Style="{StaticResource T11Muted}" Text="Schema indicativo, non esecutivo. Rettangolare / T: staffe a più braccia. Circolare: bracci e staffe interne sono rappresentati secondo lo schema scelto; assegnare i rami effettivamente resistenti a Vx e Vy. Il modello di calcolo circolare si sceglie nella scheda Taglio e torsione."/>
           </StackPanel>
          </Expander>
          <Expander Style="{StaticResource Group}" IsExpanded="{Binding Group[trefoli].IsExpanded}">
           <Expander.Header><TextBlock Style="{StaticResource T14Bold}" Text="Trefoli"/></Expander.Header>
           <StackPanel>
            <Border Style="{StaticResource Notice}">
             <TextBlock Style="{StaticResource NoticeText}" Text="In GPC Engine un cavo di n trefoli è modellato con Øeq = Ø√n e area totale n·πØ²/4. Usare il diametro equivalente all’area metallica, non quello nominale esterno. Materiale e σp0 sono distinti per ogni cavo."/>
            </Border>
            <ContentControl Style="{StaticResource Form}" Content="{Binding Cable}"/>
            <ComboBox x:Name="CableMaterial" Style="{StaticResource Choice}" MinWidth="160" HorizontalAlignment="Left" IsEnabled="{Binding CanEditTables}"
             ItemsSource="{Binding CableMaterial.Items}" SelectedIndex="{Binding CableMaterial.SelectedIndex}" AutomationProperties.Name="Materiale del nuovo cavo"/>
            <WrapPanel>
             <Button Style="{StaticResource Command}" Content="+ Cavo / trefolo" Command="{Binding AddCableCommand}"/>
             <Button Style="{StaticResource Command}" Content="−" Command="{Binding RemoveCableCommand}" AutomationProperties.Name="Elimina cavo"/>
            </WrapPanel>
            <TextBlock Style="{StaticResource T11}" Text="{Binding CableMessage}"/>
           </StackPanel>
          </Expander>
         </StackPanel>
        </local:ChainedScrollViewer>
       </DockPanel>
      </Border>
      <GridSplitter Style="{StaticResource ColumnSplitter}"/>
      <!-- The drawing with the tables, and the summaries. -->
      <Grid x:Name="ControlResults" Tag="risultati" Grid.Column="2">
       <Grid.ColumnDefinitions><ColumnDefinition Width="6*" MinWidth="350"/><ColumnDefinition Width="8"/><ColumnDefinition Width="4*" MinWidth="230"/></Grid.ColumnDefinitions>
       <Grid x:Name="PreviewRows" Tag="righe">
        <Grid.RowDefinitions><RowDefinition Height="3.7*" MinHeight="160"/><RowDefinition Height="8"/><RowDefinition Height="2*" MinHeight="155"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Frame}">
         <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="2,0,2,6">
           <TextBlock Style="{StaticResource T14Bold}" Text="Sezione geometrica"/>
           <WrapPanel x:Name="PreviewToolbar">
            <Button Style="{StaticResource Command}" Content="Proprietà / report…" Command="{Binding Inputs.OpenPropertiesCommand}"/>
            <!-- The five check boxes of the drawing are blocked in a read-only revision, as RevisionInspection blocks them in the historic view. -->
            <CheckBox Style="{StaticResource Switch}" Content="Assi" IsChecked="{Binding Inputs.ShowAxes}" IsEnabled="{Binding Inputs.CanEditTables}"/>
            <CheckBox Style="{StaticResource Switch}" Content="ID" IsChecked="{Binding Inputs.ShowLabels}" IsEnabled="{Binding Inputs.CanEditTables}"/>
            <Button Style="{StaticResource Command}" Content="Adatta" Click="FitPreview_Click"/>
            <Button Style="{StaticResource Command}" Content="PNG" Click="SavePreview_Click"/>
            <Button Style="{StaticResource Command}" Content="Espandi" Click="ExpandPreview_Click"/>
            <CheckBox Style="{StaticResource Switch}" Content="Dimensioni" IsChecked="{Binding Inputs.ShowDimensions}" IsEnabled="{Binding Inputs.CanEditTables}"/>
            <CheckBox Style="{StaticResource Switch}" Content="Copriferro" IsChecked="{Binding Inputs.ShowCoverDimensions}" IsEnabled="{Binding Inputs.CanEditTables}"/>
            <CheckBox Style="{StaticResource Switch}" Content="Interferro min." IsChecked="{Binding Inputs.ShowSpacingDimensions}" IsEnabled="{Binding Inputs.CanEditTables}"/>
           </WrapPanel>
          </StackPanel>
          <ContentControl x:Name="PreviewHost" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
         </DockPanel>
        </Border>
        <GridSplitter Style="{StaticResource RowSplitter}"/>
        <Border Grid.Row="2" Style="{StaticResource Paper}">
         <DockPanel>
          <StackPanel Style="{StaticResource PanelHeading}">
           <TextBlock Style="{StaticResource T14Bold}" Text="Armature della sezione"/>
           <TextBlock Style="{StaticResource PanelSubtitle}" Text="Coordinate modificabili · mm · inserimento cavi nel pannello a sinistra"/>
          </StackPanel>
          <TabControl>
           <TabItem Header="Armature ordinarie">
            <DockPanel>
             <WrapPanel DockPanel.Dock="Top"><Button Style="{StaticResource Command}" Content="Ripristina barre da wizard" Command="{Binding Inputs.RestoreBarsCommand}"/></WrapPanel>
             <ContentControl DockPanel.Dock="Top" Focusable="False" Content="{Binding Inputs.Bars.Filter}" ContentTemplate="{StaticResource FilterBar}"/>
             <views:ConcreteTableGrid x:Name="BarsGrid" Table="{Binding Inputs.Bars}" AutomationProperties.Name="Barre della sezione"/>
            </DockPanel>
           </TabItem>
           <TabItem Header="Trefoli / cavi">
            <DockPanel>
             <ContentControl DockPanel.Dock="Top" Focusable="False" Content="{Binding Inputs.Tendons.Filter}" ContentTemplate="{StaticResource FilterBar}"/>
             <views:ConcreteTableGrid x:Name="TendonsGrid" Table="{Binding Inputs.Tendons}" AutomationProperties.Name="Trefoli e cavi"/>
            </DockPanel>
           </TabItem>
          </TabControl>
         </DockPanel>
        </Border>
       </Grid>
       <GridSplitter Style="{StaticResource ColumnSplitter}"/>
       <local:ChainedScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
         <Border Style="{StaticResource Paper}" DataContext="{Binding Inputs}">
          <DockPanel>
           <StackPanel Style="{StaticResource PanelHeading}">
            <TextBlock Style="{StaticResource T14Bold}" Text="Resistenze a N assegnato"/>
            <TextBlock Style="{StaticResource PanelSubtitle}" Text="Mx± / My± · kNm · assi locali · iterativo"/>
           </StackPanel>
           <StackPanel>
            <ContentControl Style="{StaticResource Form}" Content="{Binding QuickResistance}"/>
            <TextBlock Style="{StaticResource T12}" Text="{Binding QuickResistanceText}" Visibility="{Binding QuickResistanceTextVisible, Converter={StaticResource Visible}}"/>
            <ItemsControl Focusable="False" ItemsSource="{Binding QuickResistanceCards}" ItemTemplate="{StaticResource QuickResistanceCard}">
             <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
           </StackPanel>
          </DockPanel>
         </Border>
         <ItemsControl Focusable="False" ItemsSource="{Binding SummaryBlocks}" ItemTemplate="{StaticResource SummaryBlock}"/>
         <TextBlock Style="{StaticResource T11Muted}" Text="Colori η come nei domini · grigio: esito mancante. Ogni verifica resta distinta."/>
        </StackPanel>
       </local:ChainedScrollViewer>
      </Grid>
     </Grid>
    </TabItem>

    <!-- ================================================================ 02–08: the panels of the tabs, each on its ViewModel -->
    <TabItem Padding="14,9,14,9">
     <TabItem.Header><WrapPanel><TextBlock Style="{StaticResource T11BoldMuted}" Text="02"/><TextBlock Style="{StaticResource T14Bold}" Text="  Dominio 3D"/></WrapPanel></TabItem.Header>
     <views:ConcreteDomainPanelView x:Name="Domain3DView" DataContext="{Binding Domain3D}"/>
    </TabItem>
    <TabItem Padding="14,9,14,9">
     <TabItem.Header><WrapPanel><TextBlock Style="{StaticResource T11BoldMuted}" Text="03"/><TextBlock Style="{StaticResource T14Bold}" Text="  Dominio 2D"/></WrapPanel></TabItem.Header>
     <views:ConcreteDomainPanelView x:Name="Domain2DView" DataContext="{Binding Domain2D}"/>
    </TabItem>
    <TabItem Padding="14,9,14,9">
     <TabItem.Header><WrapPanel><TextBlock Style="{StaticResource T11BoldMuted}" Text="04"/><TextBlock Style="{StaticResource T14Bold}" Text="  Tensioni e fessurazione"/></WrapPanel></TabItem.Header>
     <!-- The families of the serviceability: a tab control without headers, as the historic sleTabs; the family follows StressFamily. -->
     <TabControl x:Name="StressTabs" Template="{StaticResource ContentOnlyTabs}" SelectedIndex="{Binding StressFamily}">
      <TabItem Header="{Binding StressPanels[0].Label}"><views:ConcreteStressPanelView DataContext="{Binding StressPanels[0]}"/></TabItem>
      <TabItem Header="{Binding StressPanels[1].Label}"><views:ConcreteStressPanelView DataContext="{Binding StressPanels[1]}"/></TabItem>
      <TabItem Header="{Binding StressPanels[2].Label}"><views:ConcreteStressPanelView DataContext="{Binding StressPanels[2]}"/></TabItem>
     </TabControl>
    </TabItem>
    <TabItem Padding="14,9,14,9">
     <TabItem.Header><WrapPanel><TextBlock Style="{StaticResource T11BoldMuted}" Text="05"/><TextBlock Style="{StaticResource T14Bold}" Text="  Taglio e torsione"/></WrapPanel></TabItem.Header>
     <views:ConcreteShearView x:Name="ShearView" DataContext="{Binding Shear}"/>
    </TabItem>
    <TabItem Padding="14,9,14,9">
     <TabItem.Header><WrapPanel><TextBlock Style="{StaticResource T11BoldMuted}" Text="06"/><TextBlock Style="{StaticResource T14Bold}" Text="  Dettagli costruttivi"/></WrapPanel></TabItem.Header>
     <views:ConcreteDetailingView x:Name="DetailingView" DataContext="{Binding Detailing}"/>
    </TabItem>
    <TabItem Padding="14,9,14,9">
     <TabItem.Header><WrapPanel><TextBlock Style="{StaticResource T11BoldMuted}" Text="07"/><TextBlock Style="{StaticResource T14Bold}" Text="  Momento–curvatura"/></WrapPanel></TabItem.Header>
     <views:ConcreteCurvatureView x:Name="CurvatureView" DataContext="{Binding Curvature}"/>
    </TabItem>
    <TabItem Padding="14,9,14,9">
     <TabItem.Header><WrapPanel><TextBlock Style="{StaticResource T11BoldMuted}" Text="08"/><TextBlock Style="{StaticResource T14Bold}" Text="  Calcola armature"/></WrapPanel></TabItem.Header>
     <views:ConcreteDesignView x:Name="DesignView" DataContext="{Binding Design}"/>
    </TabItem>
   </TabControl>
  </DockPanel>
 </local:ChainedScrollViewer>
</UserControl>
