<!--
  Data templates of the RC section sheet (F5.10, view after S9): MvvmSheetEditor finds the view of ConcreteSheetViewModel here. The Release keeps the
  historic view until its switch (decision C10); the UiTests bench chooses this view with the option module-impl with str_palo=mvvm.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:X.Desktop.Views.ConcreteSection"
 xmlns:concrete="clr-namespace:Anthea.Presentation.Modules.ConcreteSection;assembly=ANTHEA.Presentation">
 <DataTemplate DataType="{x:Type concrete:ConcreteSheetViewModel}"><views:ConcreteSectionSheetView/></DataTemplate>
</ResourceDictionary>
