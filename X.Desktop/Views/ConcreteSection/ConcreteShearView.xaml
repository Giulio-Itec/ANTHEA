<!--
  The tab 05 «Taglio e torsione» of the RC section (F5.10 view after S9) on ConcreteShearViewModel, with the layout of BuildShearPanel of the historic
  view (AnalysisLayout with the table at least 280 high): the links shown read-only with «Modifica staffe nel pannello di controllo →», the form of the
  shear, the torsion and the circular model with its note, the note of the automatic parameters and the notice; the section with the geometric
  references; the details of the selected combination and the summary of the checks; the table of the shear with its commands and the summary under
  it. The section is the drawing of the historic view, fed by the data of the panel in the code-behind (Q3). Theme tokens only (P7).
-->
<UserControl x:Class="X.Desktop.Views.ConcreteSection.ConcreteShearView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:X.Desktop"
 xmlns:views="clr-namespace:X.Desktop.Views.ConcreteSection"
 xmlns:concrete="clr-namespace:Anthea.Presentation.Modules.ConcreteSection;assembly=ANTHEA.Presentation">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ConcreteSectionResources.xaml"/></ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid x:Name="Columns" Tag="ingressi" Margin="0,10,0,0">
  <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="285"/><ColumnDefinition Width="8"/><ColumnDefinition Width="7*" MinWidth="650"/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Paper}">
   <DockPanel>
    <StackPanel Style="{StaticResource PanelHeading}">
     <TextBlock Style="{StaticResource T14Bold}" Text="Taglio e torsione"/>
     <TextBlock Style="{StaticResource PanelSubtitle}" Text="Azioni di progetto già combinate · assi locali"/>
    </StackPanel>
    <local:ChainedScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <Expander Style="{StaticResource Group}">
       <Expander.Header><TextBlock Style="{StaticResource T14Bold}" Text="Staffe · dati comuni"/></Expander.Header>
       <StackPanel>
        <ContentControl Style="{StaticResource Form}" Content="{Binding Stirrups.Values}"/>
        <ContentControl Style="{StaticResource Form}" Content="{Binding Stirrups.Scheme}"/>
        <Button Style="{StaticResource Command}" Content="{Binding Stirrups.EditText}" HorizontalAlignment="Left" Click="ControlPanel_Click"
         IsEnabled="{Binding DataContext.IsReadOnly, Converter={StaticResource Not}, RelativeSource={RelativeSource AncestorType=views:ConcreteSectionSheetView}}"/>
       </StackPanel>
      </Expander>
      <ContentControl Style="{StaticResource Form}" Content="{Binding Form}"/>
      <Expander Style="{StaticResource Group}" IsExpanded="True">
       <Expander.Header><TextBlock Style="{StaticResource T14Bold}" Text="Torsione / modello circolare"/></Expander.Header>
       <StackPanel>
        <ContentControl Style="{StaticResource Form}" Content="{Binding Torsion}"/>
        <TextBlock Style="{StaticResource T11}" Text="{x:Static concrete:ConcreteShearViewModel.TorsionNote}"/>
       </StackPanel>
      </Expander>
      <TextBlock Style="{StaticResource T11}" Text="{Binding AutomaticNote}"/>
      <Border Style="{StaticResource Notice}">
       <TextBlock Style="{StaticResource NoticeText}" Text="{x:Static concrete:ConcreteShearViewModel.Notice}"/>
      </Border>
     </StackPanel>
    </local:ChainedScrollViewer>
   </DockPanel>
  </Border>
  <GridSplitter Style="{StaticResource ColumnSplitter}"/>
  <Grid x:Name="Rows" Tag="righe" Grid.Column="2">
   <Grid.RowDefinitions><RowDefinition Height="3.7*" MinHeight="160"/><RowDefinition Height="8"/><RowDefinition Height="2*" MinHeight="280"/></Grid.RowDefinitions>
   <Grid x:Name="Results" Tag="risultati">
    <Grid.ColumnDefinitions><ColumnDefinition Width="6*" MinWidth="350"/><ColumnDefinition Width="8"/><ColumnDefinition Width="4*" MinWidth="230"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Frame}">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="2,0,2,6">
       <TextBlock Style="{StaticResource T14Bold}" Text="Sezione · riferimenti geometrici"/>
       <WrapPanel>
        <Button Style="{StaticResource Command}" Content="Adatta" Click="Fit_Click"/>
        <Button Style="{StaticResource Command}" Content="PNG" Click="Png_Click"/>
        <Button Style="{StaticResource Command}" Content="Espandi" Click="Expand_Click"/>
       </WrapPanel>
      </StackPanel>
      <ContentControl x:Name="DrawingHost" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
     </DockPanel>
    </Border>
    <GridSplitter Style="{StaticResource ColumnSplitter}"/>
    <TabControl Grid.Column="2" SelectedIndex="{Binding DetailTab}">
     <TabItem Header="Dettagli combinazione">
      <local:ChainedScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <TextBlock Style="{StaticResource T13}" Text="{Binding Detail}"/>
      </local:ChainedScrollViewer>
     </TabItem>
     <TabItem Header="Riepilogo verifiche">
      <local:ChainedScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <ContentControl Style="{StaticResource Form}" Content="{Binding Worst}" ContentTemplate="{StaticResource SummaryCards}"/>
      </local:ChainedScrollViewer>
     </TabItem>
    </TabControl>
   </Grid>
   <GridSplitter Style="{StaticResource RowSplitter}"/>
   <Border Grid.Row="2" Style="{StaticResource Paper}">
    <DockPanel>
     <StackPanel Style="{StaticResource PanelHeading}">
      <TextBlock Style="{StaticResource T14Bold}" Text="Combinazioni e resistenze"/>
     </StackPanel>
     <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource T12}" Text="{Binding Summary}"/>
     <ContentControl Style="{StaticResource Form}" VerticalContentAlignment="Stretch" Content="{Binding Table}" ContentTemplate="{StaticResource ActionTable}"
      views:ConcreteTableGrid.TrailingWeights="3" views:ConcreteTableGrid.MinimumWidths="nome=120 esito=220" views:ConcreteTableGrid.WrappedColumns="esito"/>
    </DockPanel>
   </Border>
  </Grid>
 </Grid>
</UserControl>
