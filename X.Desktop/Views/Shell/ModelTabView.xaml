<!--
  DRAFT (F5.13 c): the tab of a model (MainWindow.ShowContainerModel) on ModelTabViewModel: the bar «← Modelli», «Progetto di appartenenza»,
  «+ Modello», «Salva progetto»; the name and the path of the section (« · sola lettura» in the preview of a revision); «Nome del modello» with
  «Rinomina» outside the read-only state; then the existing viewer (ModelViewerControl), created by the code-behind on the values of the ViewModel.
-->
<UserControl x:Class="X.Desktop.Views.Shell.ModelTabView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:proj="clr-namespace:Anthea.Presentation.Shell.Projects;assembly=ANTHEA.Presentation"
 Background="{DynamicResource Token.Surface}">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ShellTemplates.xaml"/></ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </UserControl.Resources>
 <DockPanel>
  <StackPanel DockPanel.Dock="Top" Margin="14,8,14,8">
   <WrapPanel>
    <Button Style="{StaticResource Shell.Button}" Content="{x:Static proj:ModelTabViewModel.BackLabel}" Command="{Binding BackCommand}"/>
    <Button Style="{StaticResource Shell.Button}" Content="{x:Static proj:ModelTabViewModel.OwnerLabel}" Command="{Binding OwnerCommand}"/>
    <Button Style="{StaticResource Shell.Button}" Content="{x:Static proj:ModelTabViewModel.NewModelLabel}" Command="{Binding NewModelCommand}"/>
    <Button Style="{StaticResource Shell.Button}" Content="{x:Static proj:ModelTabViewModel.SaveLabel}" Command="{Binding SaveCommand}"/>
   </WrapPanel>
   <TextBlock Style="{StaticResource Shell.Title}" Text="{Binding Title}" Margin="0,6,0,0"/>
   <TextBlock Style="{StaticResource Shell.Muted}" FontSize="{DynamicResource Font.Small}" Text="{Binding PathText}"/>
   <Expander Header="{x:Static proj:ModelTabViewModel.RenameHeader}" IsExpanded="False" Margin="0,4,0,0" Visibility="{Binding IsReadOnly, Converter={StaticResource WhenFalse}}">
    <StackPanel Orientation="Horizontal">
     <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" MinWidth="260" Margin="4" AutomationProperties.Name="{x:Static proj:ModelTabViewModel.RenameHeader}"/>
     <Button Style="{StaticResource Shell.Button}" Content="{x:Static proj:ModelTabViewModel.RenameLabel}" Command="{Binding RenameCommand}"/>
    </StackPanel>
   </Expander>
  </StackPanel>
  <ContentControl x:Name="Viewer" Focusable="False"/>
 </DockPanel>
</UserControl>
