<!--
  DRAFT (F5.13 c): a detached window of the shell (proposal 4.1, Q10 a, SH2, SH19, SH20) on a TabHostViewModel: its strip of tabs (with «Sposta in
  una nuova finestra», «Riaggancia» and «Chiudi» in the menu of each tab), «Riaggancia» for the tab on screen, the tab on screen. The window can go to
  another monitor; closing it brings its tabs back to the main window (ShellWindowTracker). Colours and font sizes are theme tokens only (P7).
-->
<Window x:Class="X.Desktop.Views.Shell.DetachedShellWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:tabs="clr-namespace:Anthea.Presentation.Shell.Tabs;assembly=ANTHEA.Presentation"
 x:Name="Root" Width="1200" Height="860" MinWidth="560" MinHeight="400"
 Style="{DynamicResource {x:Type Window}}" Background="{DynamicResource Token.Surface}">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ShellTemplates.xaml"/></ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Window.Resources>
 <DockPanel>
  <DockPanel DockPanel.Dock="Top" Background="{DynamicResource Token.Surface}">
   <Button DockPanel.Dock="Right" Style="{StaticResource Shell.Button}" Content="{x:Static tabs:ShellWindowsViewModel.ReattachLabel}" Margin="8,6"
    Command="{Binding Windows.ReattachCommand, ElementName=Root}" CommandParameter="{Binding Selected}"/>
   <ItemsControl Style="{StaticResource Shell.TabStrip}" DataContext="{Binding Windows, ElementName=Root}" ItemsSource="{Binding DataContext.Tabs, ElementName=Root}"/>
  </DockPanel>
  <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Token.Border}"/>
  <ContentControl Content="{Binding Selected}" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
 </DockPanel>
</Window>
