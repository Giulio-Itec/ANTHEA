<!--
  DRAFT (F5.13 c): the Navy bar above the sheet with the focus (MainWindow.BuildShell, UpdateBackButton), on SheetBarViewModel: «← Torna…», the file commands with «Report Word» and «Report short» (concrete section only), «Conferma modifiche» and undo/redo in an
  editable project, «Wiki del modulo», «Approfondimenti ▾» (its menu built from SheetBarViewModel.Topics when pressed, as today), heading and
  subtitle. The commands of the files come from the window (ShellViewModel); «▸» of the tree is beside the tabs, for every page.
-->
<UserControl x:Class="X.Desktop.Views.Shell.SheetBarView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:nav="clr-namespace:Anthea.Presentation.Shell.Navigation;assembly=ANTHEA.Presentation"
 xmlns:cmd="clr-namespace:Anthea.Presentation.Shell.Commands;assembly=ANTHEA.Presentation">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ShellTemplates.xaml"/></ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </UserControl.Resources>
 <!--
  One wrapping row, not a DockPanel: beside the navigation and the tree the commands of a sheet of a project («Conferma modifiche», undo and
  redo) leave no width for the heading, and a DockPanel gave it none; its subtitle then wrapped at every letter and the bar took the whole height
  of the window, the sheet below squeezed to its last row (images 04 and 09 of 22/10). Now what does not fit goes to a second row and the bar is
  as high as its rows; the texts of the heading never wrap.
 -->
 <Border Background="{DynamicResource Token.CommandBar}" MinHeight="68">
  <WrapPanel VerticalAlignment="Center" Margin="0,3">
   <Button Style="{StaticResource Shell.BarButton}" Width="200" Content="{Binding BackLabel}" Command="{Binding BackCommand}"/>
   <Button Style="{StaticResource Shell.BarButton}" Content="📂" Width="37" Padding="2" ToolTip="Apri" AutomationProperties.Name="Apri"
    Command="{Binding DataContext.Commands.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
   <Button Style="{StaticResource Shell.BarButton}" Content="Salva" ToolTip="Salva" Command="{Binding DataContext.Commands.SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
   <Button Style="{StaticResource Shell.BarButton}" Content="Salva con nome" ToolTip="Salva con nome"
    Command="{Binding DataContext.Commands.SaveAsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
   <Button Style="{StaticResource Shell.BarButton}" Content="W" Width="37" Padding="2" ToolTip="Report Word" AutomationProperties.Name="Report Word"
    Command="{Binding DataContext.Commands.ReportCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
   <Button Style="{StaticResource Shell.BarButton}" Content="Report short" ToolTip="{x:Static cmd:ShellCommandsViewModel.ShortToolTip}"
    Command="{Binding DataContext.Commands.ShortReportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
    Visibility="{Binding DataContext.Commands.ShortReportVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WhenTrue}}"/>
   <StackPanel Orientation="Horizontal" Visibility="{Binding CanConfirm, Converter={StaticResource WhenTrue}}">
    <Button Style="{StaticResource Shell.BarButton}" Content="{x:Static nav:SheetBarViewModel.ConfirmLabel}" Command="{Binding ConfirmCommand}"/>
    <Button Style="{StaticResource Shell.BarButton}" Content="{x:Static cmd:ShellCommandsViewModel.UndoLabel}" ToolTip="{x:Static cmd:ShellCommandsViewModel.UndoToolTip}"
     Command="{Binding DataContext.Commands.UndoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
    <Button Style="{StaticResource Shell.BarButton}" Content="{x:Static cmd:ShellCommandsViewModel.RedoLabel}" ToolTip="{x:Static cmd:ShellCommandsViewModel.RedoToolTip}"
     Command="{Binding DataContext.Commands.RedoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
   </StackPanel>
   <Button Style="{StaticResource Shell.BarButton}" Content="{x:Static nav:SheetBarViewModel.GuideLabel}" ToolTip="{x:Static nav:SheetBarViewModel.GuideToolTip}"
    Command="{Binding GuideCommand}" Visibility="{Binding GuideId, Converter={StaticResource WhenPresent}}"/>
   <Button x:Name="Topics" Style="{StaticResource Shell.BarButton}" Content="{x:Static nav:SheetBarViewModel.TopicsLabel}"
    ToolTip="{x:Static nav:SheetBarViewModel.TopicsToolTip}" Click="OnTopics"/>
   <StackPanel Margin="15,4,12,4" VerticalAlignment="Center">
    <TextBlock Style="{StaticResource Shell.OnBar}" FontSize="{DynamicResource Font.Heading}" FontWeight="SemiBold" Text="{Binding Heading}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    <TextBlock Style="{StaticResource Shell.OnBarMuted}" Text="{x:Static nav:SheetBarViewModel.Subtitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
  </WrapPanel>
 </Border>
</UserControl>
