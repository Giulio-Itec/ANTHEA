<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Wiki/sources.props" />
  <Target Name="CheckWikiSourceIndex" BeforeTargets="PrepareForBuild">
    <GetFileHash Files="@(WikiSource)" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="_WikiHashed" /></GetFileHash>
    <Error Condition="'%(_WikiHashed.FileHash)' != '%(_WikiHashed.ExpectedHash)'" Text="Indice Wiki obsoleto. Eseguire supporto/scripts/wiki/build-wiki-index.py con Python dopo le modifiche alle guide." />
  </Target>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ANTHEA</AssemblyName>
    <Product>ANTHEA</Product>
    <Title>ANTHEA</Title>
    <Version>1.0.0</Version>
    <Company>ITEC Engineering</Company>
    <Copyright>© 2026 ITEC Engineering</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/anthea.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../X.Calculations/X.Calculations.csproj" /><ProjectReference Include="../X.Core/X.Core.csproj" /><ProjectReference Include="../X.Materiali/X.Materiali.csproj" /><ProjectReference Include="../src/ANTHEA.ModelViewer.Wpf/ANTHEA.ModelViewer.Wpf.csproj" /></ItemGroup>
  <PropertyGroup><GpcLibraries>all</GpcLibraries></PropertyGroup>
  <ItemGroup><Resource Include="Assets/*.png" /><Resource Include="Assets/anthea.ico" /></ItemGroup>
  <ItemGroup>
    <Content Include="Wiki/Licenses/*.txt"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><TargetPath>Licenses/%(Filename)%(Extension)</TargetPath></Content>
    <Resource Include="Assets/Wiki/*.png" />
    <EmbeddedResource Include="Assets/Wiki/*.svg"><LogicalName>Wiki.figures.%(Filename)%(Extension)</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Wiki/*.json"><LogicalName>Wiki.%(Filename)%(Extension)</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Wiki/Examples/*.json"><LogicalName>Wiki.examples.%(Filename)%(Extension)</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="../supporto/docs/guida-pratica-anthea.md"><LogicalName>Wiki.pratica.md</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="../supporto/docs/guida-teorica-anthea.md"><LogicalName>Wiki.teorica.md</LogicalName></EmbeddedResource>
  </ItemGroup>
  <!-- WPF checks and their command line (AppHarness.cs) only in the UiTests configuration, never in Release. -->
  <ItemGroup Condition="'$(Configuration)' == 'UiTests'"><Compile Include="../supporto/test/Desktop/*.cs" Link="Tests/%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="WpfMath" Version="2.1.0" />
  </ItemGroup>
</Project>
