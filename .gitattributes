# The repository stores text with LF; checkouts follow core.autocrlf, except the files below.
* text=auto
# Preserve the archived Rev42, Rev43, Rev44 and Rev46 bytes and their recorded SHA-256 values.
supporto/SUPERATI/f4-rev43-20261014/** -text
supporto/SUPERATI/f4-rev44-20261014/** -text
supporto/SUPERATI/installazione-rev45-20261015/** -text
supporto/SUPERATI/correzioni-rev47-20261016/** -text
supporto/SUPERATI/paratie-rev*-20261019/** -text
supporto/SUPERATI/integrazione-f5-rev52-20261019/** -text
supporto/SUPERATI/installer-1110-20261019/** -text
supporto/SUPERATI/paratie-grafica-rev53-20261020/** -text

*.sln text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# The Wiki index stores byte offsets into the two guides (src/ANTHEA.Wiki/Content/index.json), and
# src/ANTHEA.Wiki/Content/sources.props the SHA-256 of these files computed with CRLF line endings: the
# ANTHEA.Wiki build stops if they differ. They must be CRLF in every checkout, on any system.
supporto/docs/guida-pratica-anthea.md text eol=crlf
supporto/docs/guida-teorica-anthea.md text eol=crlf
src/ANTHEA.Wiki/Content/*.json text eol=crlf
src/ANTHEA.Wiki/Content/sources.props text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.dotx binary
*.xlsx binary
*.pptx binary
*.dll binary
*.exe binary
*.pdb binary
*.zip binary
*.gz binary
*.nupkg binary
