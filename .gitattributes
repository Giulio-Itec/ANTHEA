# The repository stores text with LF; checkouts follow core.autocrlf, except the files below.
* text=auto

*.sln text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# The Wiki index stores byte offsets into the two guides (X.Desktop/Wiki/index.json), and
# X.Desktop/Wiki/sources.props the SHA-256 of these files computed with CRLF line endings: the
# X.Desktop build stops if they differ. They must be CRLF in every checkout, on any system.
supporto/docs/guida-pratica-anthea.md text eol=crlf
supporto/docs/guida-teorica-anthea.md text eol=crlf
X.Desktop/Wiki/*.json text eol=crlf
X.Desktop/Wiki/sources.props text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.dotx binary
*.xlsx binary
*.pptx binary
*.dll binary
*.exe binary
*.pdb binary
*.zip binary
*.gz binary
*.nupkg binary
