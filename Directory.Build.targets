<Project>
  <!--
    GPC libraries from the snapshot in $(GpcLibDir): explicit names (no wildcards) and SHA-256 check
    against $(GpcManifestProps), generated from lib\Checker\manifest.json by tools\libs\Write-ManifestProps.ps1.

    GpcLibraries: 'all', 'none' or a list of assembly names (for example GPCModel;GPCUtilities).
    Executables and test projects default to 'all': at run time they need the whole coherent set, including
    the DLLs used only by their dependencies (DelaunayMesh, used by GPCChecker.Concrete, is never referenced by
    ANTHEA code and was therefore not copied to the projects that reference only X.Calculations).
    Projects under supporto\tmp, supporto\artefatti and supporto\SUPERATI are left untouched.
    GpcRuntimeOnly=true copies the coherent set at build/publish without injecting direct compiler references.
    -p:GpcVerifyHashes=false disables the check (only for diagnosis, never in a commit).
  -->
  <PropertyGroup>
    <_GpcProjectExcluded Condition="$(MSBuildProjectDirectory.Contains('\supporto\tmp')) or $(MSBuildProjectDirectory.Contains('\supporto\artefatti')) or $(MSBuildProjectDirectory.Contains('\supporto\SUPERATI'))">true</_GpcProjectExcluded>
    <GpcLibraries Condition="'$(GpcLibraries)' == '' and '$(_GpcProjectExcluded)' != 'true' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe' or '$(IsTestProject)' == 'true')">all</GpcLibraries>
    <GpcLibraries Condition="'$(GpcLibraries)' == 'all'">GPCUtilities;GPCGeometry;DelaunayMesh;GPCModel;GPCModelData;GPCChecker.Concrete;GPCChecker.Steel;GPCChecker.Geotechnics;GPCChecker.CompositeBridge;GPCChecker.Masonry;GPC.Design</GpcLibraries>
    <_GpcEnabled Condition="'$(GpcLibraries)' != '' and '$(GpcLibraries)' != 'none'">true</_GpcEnabled>
    <GpcVerifyHashes Condition="'$(GpcVerifyHashes)' == ''">true</GpcVerifyHashes>
  </PropertyGroup>

  <ItemGroup Condition="'$(_GpcEnabled)' == 'true'">
    <_GpcLibraryName Include="$(GpcLibraries)" />
    <Reference Include="@(_GpcLibraryName)" HintPath="$(GpcLibDir)%(Identity).dll" Private="true" Condition="'$(GpcRuntimeOnly)' != 'true'" />
  </ItemGroup>

  <Import Project="$(GpcManifestProps)" Condition="'$(_GpcEnabled)' == 'true' and Exists('$(GpcManifestProps)')" />

  <ItemGroup Condition="'$(_GpcEnabled)' == 'true' and '$(GpcRuntimeOnly)' == 'true'">
    <Content Include="@(GpcLibraryFile)">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    F5.1 (decision Q16, 16/10/2026): Microsoft.VisualStudio.Threading.Analyzers only on ANTHEA.Presentation, for now.
    The version is in the dependency table of docs/refactoring/decisioni.md, the severities (and their reasons) in
    build\analyzers\ANTHEA.Presentation.globalconfig. Analyzers only: PrivateAssets=all keeps the package out of the
    projects that reference Presentation and nothing is copied to the output, so the binaries do not change.
    Restored from nuget.org like the other packages. tests\ANTHEA.Architecture.Tests checks this block.
    The global config goes straight into EditorConfigFiles (the list passed to the compiler): Roslyn copies
    GlobalAnalyzerConfigFiles into it before this file is evaluated.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ANTHEA.Presentation'">
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" PrivateAssets="all" />
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)build\analyzers\ANTHEA.Presentation.globalconfig" />
  </ItemGroup>

  <Target Name="VerifyGpcLibraries" BeforeTargets="ResolveAssemblyReferences" Condition="'$(_GpcEnabled)' == 'true' and '$(GpcVerifyHashes)' == 'true'">
    <Error Condition="!Exists('$(GpcManifestProps)')" Text="Manca $(GpcManifestProps): rigenerarlo con tools\libs\Write-ManifestProps.ps1." />
    <Error Condition="!Exists('%(GpcLibraryFile.Identity)')" Text="DLL GPC mancante: %(GpcLibraryFile.Identity)" />
    <GetFileHash Files="@(GpcLibraryFile)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_GpcHashed" />
    </GetFileHash>
    <Error Condition="'%(_GpcHashed.FileHash)' != '%(_GpcHashed.Sha256)'" Text="DLL GPC diversa dal manifest: %(_GpcHashed.Filename)%(_GpcHashed.Extension) in $(GpcLibDir)" />
    <ItemGroup>
      <_GpcDllOnDisk Include="$(GpcLibDir)*.dll" />
      <_GpcDllOnDiskName Include="@(_GpcDllOnDisk->'%(Filename)')" />
      <_GpcDllOnDiskName Remove="@(GpcLibraryFile->'%(Filename)')" />
      <_GpcDllRequiredName Include="@(_GpcLibraryName)" />
      <_GpcDllRequiredName Remove="@(GpcLibraryFile->'%(Filename)')" />
    </ItemGroup>
    <Error Condition="'@(_GpcDllOnDiskName)' != ''" Text="DLL non elencate nel manifest in $(GpcLibDir): @(_GpcDllOnDiskName)" />
    <Error Condition="'@(_GpcDllRequiredName)' != ''" Text="Librerie GPC richieste ma assenti dal manifest: @(_GpcDllRequiredName)" />
  </Target>
</Project>
