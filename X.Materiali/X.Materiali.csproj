<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AssemblyName>Materiali</AssemblyName>
    <GpcLibraries>GPCModel;GPCUtilities</GpcLibraries>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../X.Calculations/X.Calculations.csproj" /></ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/*.png" />
  </ItemGroup>
  <!-- Self-checks of the sheet (MaterialView.Check, used by the materials smoke check) only in the UiTests configuration. -->
  <ItemGroup Condition="'$(Configuration)' == 'UiTests'">
    <Compile Include="../supporto/test/Materiali/*.cs" Link="Tests/%(Filename)%(Extension)" />
    <Compile Include="../supporto/test/Shared/DurabilityReferenceChecks.cs" Link="Tests/DurabilityReferenceChecks.cs" />
  </ItemGroup>
</Project>
