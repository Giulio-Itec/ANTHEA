<Project Sdk="Microsoft.NET.Sdk">
  <!-- ViewModels and services of src/ANTHEA.Presentation without WPF (proposal F5, section 7.1): fast stage of build/ci.ps1. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><RootNamespace>Anthea.Presentation.Tests</RootNamespace></PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/ANTHEA.Presentation/ANTHEA.Presentation.csproj" /></ItemGroup>
  <!-- Test-only module of the ModuleHost contract (F5.2), shared with the WPF checks of the UiTests build of X.Desktop. -->
  <ItemGroup><Compile Include="../Shared/ProbeSheetModule.cs" Link="Shared/ProbeSheetModule.cs" /></ItemGroup>
  <!-- Scenarios and traces of the pile group sheet (F5.4), shared with the trace of the historic view in the UiTests build of X.Desktop. -->
  <ItemGroup><Compile Include="../Shared/PileGroupTrace.cs" Link="Shared/PileGroupTrace.cs" /></ItemGroup>
  <!-- Scenarios and traces of the material sheets (F5.5), shared with the trace of the historic views in the UiTests build of X.Desktop. -->
  <ItemGroup><Compile Include="../Shared/MaterialTrace.cs" Link="Shared/MaterialTrace.cs" /></ItemGroup>
  <!-- Scenarios and traces of the vertical pile and micropile sheet (F5.6), shared with the trace of the historic view in the UiTests build of X.Desktop. -->
  <ItemGroup><Compile Include="../Shared/VerticalPileTrace.cs" Link="Shared/VerticalPileTrace.cs" /></ItemGroup>
  <!-- Scenarios and traces of the shallow foundation sheet (F5.9b), shared with the trace of the historic view in the UiTests build of X.Desktop. -->
  <ItemGroup><Compile Include="../Shared/ShallowFoundationTrace.cs" Link="Shared/ShallowFoundationTrace.cs" /></ItemGroup>
  <!-- Scenarios and traces of the horizontal pile and micropile sheet (F5.7), shared with the trace of the historic view in the UiTests build of X.Desktop. -->
  <ItemGroup><Compile Include="../Shared/HorizontalPileTrace.cs" Link="Shared/HorizontalPileTrace.cs" /></ItemGroup>
  <!-- Scenarios and traces of the stratigraphy sheet (F5.6b), shared with the trace of the historic view in the UiTests build of X.Desktop. -->
  <ItemGroup><Compile Include="../Shared/StratigraphyTrace.cs" Link="Shared/StratigraphyTrace.cs" /></ItemGroup>
  <!-- F5.6: the comparison of ui/f3-equivalence (tolerances and F4 transitions) for the files of the vertical piles with transitions. -->
  <ItemGroup>
    <Compile Include="../ANTHEA.Testing/Comparison/BaselineComparer.cs" Link="Shared/BaselineComparer.cs" />
    <Compile Include="../ANTHEA.Testing/Comparison/Tolerances.cs" Link="Shared/Tolerances.cs" />
    <Compile Include="../ANTHEA.Testing/Comparison/Transitions.cs" Link="Shared/Transitions.cs" />
    <Compile Include="../ANTHEA.Testing/Comparison/NumberText.cs" Link="Shared/NumberText.cs" />
  </ItemGroup>
  <!-- Canonical JSON and report text of the F3 captures (tests/ANTHEA.Testing), linked without the toolkit and its legacy engines. -->
  <ItemGroup>
    <Compile Include="../ANTHEA.Testing/Normalization/CanonicalJson.cs" Link="Shared/CanonicalJson.cs" />
    <Compile Include="../ANTHEA.Testing/Normalization/TextNormalizer.cs" Link="Shared/TextNormalizer.cs" />
    <Compile Include="../ANTHEA.Testing/Normalization/DocxText.cs" Link="Shared/DocxText.cs" />
  </ItemGroup>
</Project>
