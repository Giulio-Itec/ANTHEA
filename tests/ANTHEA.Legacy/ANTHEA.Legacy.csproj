<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Motori storici di X.Calculations conservati per le prove (decisione D3 del 15/10/2026): il codice che il prodotto non usa più esce
    dagli assembly distribuiti e resta qui, nel repository ma fuori dall'installer. Lo referenziano solo progetti di prova; nessun
    progetto di X.* o src/ può referenziarlo (tests/ANTHEA.Architecture.Tests). Accede ai membri internal di ANTHEA.Calculations
    tramite InternalsVisibleTo e si aggancia agli adattatori con EngineHook (modo b della decisione D3).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ANTHEA.Legacy</AssemblyName>
    <RootNamespace>Anthea.Calculations</RootNamespace>
    <GpcLibraries>all</GpcLibraries>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../X.Calculations/X.Calculations.csproj" />
  </ItemGroup>
</Project>
